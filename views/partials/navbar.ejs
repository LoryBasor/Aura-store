<!-- Navbar Marketplace - À inclure dans toutes les pages marketplace -->
<nav class="marketplace-navbar">
  <div class="navbar-container">
    <!-- Logo / Marque -->
    <div class="navbar-brand">
      <a href="/marketplace" class="brand-link">
        <span class="brand-logo">🛍️</span>
        <span class="brand-name">Aura Marketplace</span>
      </a>
    </div>

    <!-- Menu Toggle Mobile -->
    <button class="navbar-toggle" id="navbarToggle" aria-label="Menu">
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>

    <!-- Navigation Links -->
    <div class="navbar-menu" id="navbarMenu">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a href="/marketplace" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Accueil</span>
          </a>
        </li>

        <li class="nav-item">
          <a href="/marketplace/products" class="nav-link <%= currentPage === 'products' ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="9" cy="9" r="2"></circle>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
            </svg>
            <span>Produits</span>
          </a>
        </li>

        <li class="nav-item">
          <a href="/marketplace/stores" class="nav-link <%= currentPage === 'stores' ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"></path>
              <path d="M3 9V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3"></path>
            </svg>
            <span>Boutiques</span>
          </a>
        </li>

        <li class="nav-item nav-item-cta">
          <a href="/about" class="nav-link nav-link-cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <line x1="19" y1="8" x2="19" y2="14"></line>
              <line x1="22" y1="11" x2="16" y2="11"></line>
            </svg>
            <span>Devenir Vendeur</span>
          </a>
        </li>
      </ul>

      <!-- User Section (si connecté) -->
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="navbar-user">
          <a href="/dashboard" class="user-link">
            <div class="user-avatar">
              <%= user.business_name ? user.business_name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <span class="user-name"><%= user.business_name || 'Mon compte' %></span>
          </a>
        </div>
      <% } else { %>
        <div class="navbar-auth">
          <a href="/login" class="btn-login">Connexion</a>
        </div>
      <% } %>
    </div>
  </div>
</nav>

<style>
/* Navbar Marketplace Styles */
.marketplace-navbar {
  background: linear-gradient(135deg, #253337 0%, #5C6C73 100%);
  box-shadow: 0 2px 8px rgba(37, 51, 55, 0.15);
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
}

.navbar-container {
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70px;
}

/* Brand */
.navbar-brand {
  flex-shrink: 0;
}

.brand-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: #E0FCFC;
  font-weight: 700;
  font-size: 1.25rem;
  transition: opacity 0.2s ease;
}

.brand-link:hover {
  opacity: 0.9;
}

.brand-logo {
  font-size: 1.75rem;
  line-height: 1;
}

.brand-name {
  display: none;
}

@media (min-width: 480px) {
  .brand-name {
    display: block;
  }
}

/* Toggle Button Mobile */
.navbar-toggle {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
  z-index: 1001;
}

.toggle-bar {
  width: 25px;
  height: 3px;
  background: #E0FCFC;
  border-radius: 2px;
  transition: all 0.3s ease;
}

.navbar-toggle.active .toggle-bar:nth-child(1) {
  transform: rotate(45deg) translate(6px, 6px);
}

.navbar-toggle.active .toggle-bar:nth-child(2) {
  opacity: 0;
}

.navbar-toggle.active .toggle-bar:nth-child(3) {
  transform: rotate(-45deg) translate(6px, -6px);
}

/* Navigation Menu */
.navbar-menu {
  display: flex;
  align-items: center;
  gap: 2rem;
  flex: 1;
  justify-content: space-between;
  margin-left: 3rem;
}

.navbar-nav {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-item {
  position: relative;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  color: #C2E0E3;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  border-radius: 8px;
  transition: all 0.2s ease;
  position: relative;
}

.nav-link svg {
  flex-shrink: 0;
}

.nav-link:hover {
  background: rgba(224, 252, 252, 0.1);
  color: #E0FCFC;
}

.nav-link.active {
  background: rgba(224, 252, 252, 0.15);
  color: #E0FCFC;
}

.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40%;
  height: 3px;
  background: #E0FCFC;
  border-radius: 2px 2px 0 0;
}

/* CTA Button - Devenir Vendeur */
.nav-item-cta {
  margin-left: 1rem;
}

.nav-link-cta {
  background: linear-gradient(135deg, #9DB5C0, #C2E0E3);
  color: #253337;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(157, 181, 192, 0.3);
}

.nav-link-cta:hover {
  background: linear-gradient(135deg, #C2E0E3, #E0FCFC);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(157, 181, 192, 0.4);
}

.nav-link-cta.active::after {
  display: none;
}

/* User Section */
.navbar-user {
  display: flex;
  align-items: center;
}

.user-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 1rem;
  color: #E0FCFC;
  text-decoration: none;
  border-radius: 8px;
  transition: background 0.2s ease;
}

.user-link:hover {
  background: rgba(224, 252, 252, 0.1);
}

.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #9DB5C0, #C2E0E3);
  color: #253337;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1rem;
}

.user-name {
  font-weight: 500;
  font-size: 0.95rem;
}

/* Auth Buttons */
.navbar-auth {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.btn-login {
  padding: 0.75rem 1.5rem;
  background: transparent;
  border: 2px solid #C2E0E3;
  color: #E0FCFC;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-login:hover {
  background: #C2E0E3;
  color: #253337;
  transform: translateY(-2px);
}

/* Responsive */
@media (max-width: 1024px) {
  .navbar-container {
    padding: 0 1.5rem;
  }

  .navbar-menu {
    margin-left: 2rem;
  }

  .navbar-nav {
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
  }

  .nav-link span {
    display: none;
  }

  .nav-link svg {
    margin: 0;
  }

  .nav-item-cta .nav-link span {
    display: block;
  }

  .user-name {
    display: none;
  }
}

@media (max-width: 768px) {
  .navbar-toggle {
    display: flex;
  }

  .navbar-menu {
    position: fixed;
    top: 70px;
    left: -100%;
    width: 300px;
    height: calc(100vh - 70px);
    background: #253337;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem;
    gap: 2rem;
    margin: 0;
    overflow-y: auto;
    transition: left 0.3s ease;
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
  }

  .navbar-menu.active {
    left: 0;
  }

  .navbar-nav {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    gap: 0.5rem;
  }

  .nav-item {
    width: 100%;
  }

  .nav-link {
    width: 100%;
    justify-content: flex-start;
  }

  .nav-link span {
    display: block;
  }

  .nav-item-cta {
    margin-left: 0;
    margin-top: 1rem;
    width: 100%;
  }

  .navbar-user,
  .navbar-auth {
    width: 100%;
    padding-top: 1rem;
    border-top: 1px solid rgba(194, 224, 227, 0.2);
  }

  .user-link {
    width: 100%;
  }

  .user-name {
    display: block;
  }

  .btn-login {
    width: 100%;
    text-align: center;
  }
}

/* Overlay Mobile */
@media (max-width: 768px) {
  .navbar-menu.active::before {
    content: '';
    position: fixed;
    top: 70px;
    left: 300px;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: -1;
  }
}
</style>

<script>
// Toggle Menu Mobile
document.addEventListener('DOMContentLoaded', () => {
  const navbarToggle = document.getElementById('navbarToggle');
  const navbarMenu = document.getElementById('navbarMenu');

  if (navbarToggle && navbarMenu) {
    navbarToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      navbarToggle.classList.toggle('active');
      navbarMenu.classList.toggle('active');
    });

    // Fermer le menu en cliquant sur l'overlay
    document.addEventListener('click', (e) => {
      if (navbarMenu.classList.contains('active')) {
        if (!navbarMenu.contains(e.target) && e.target !== navbarToggle) {
          navbarToggle.classList.remove('active');
          navbarMenu.classList.remove('active');
        }
      }
    });

    // Fermer le menu lors du clic sur un lien
    const navLinks = navbarMenu.querySelectorAll('.nav-link');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        navbarToggle.classList.remove('active');
        navbarMenu.classList.remove('active');
      });
    });
  }
});
</script>