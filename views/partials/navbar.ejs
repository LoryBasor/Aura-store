<!-- Navbar Marketplace - À inclure dans toutes les pages marketplace -->
<nav class="marketplace-navbar">
  <div class="navbar-container">
    <!-- Logo / Marque -->
    <div class="navbar-brand">
      <a href="/marketplace" class="brand-link">
        <span class="brand-logo"><svg class="svg-icon svg-icon-fi-rr-shopping-bag" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>️</span>
        <span class="brand-name">Aura Marketplace</span>
      </a>
    </div>

    <!-- Menu Toggle Mobile -->
    <button class="navbar-toggle" id="navbarToggle" aria-label="Menu">
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>

    <!-- Navigation Links -->
    <div class="navbar-menu" id="navbarMenu">
      
      <!-- Search bar (Desktop) -->
      <div class="navbar-search hide-mobile">
        <form action="/marketplace/products" method="GET" class="navbar-search-form">
          <input type="text" name="search" placeholder="Rechercher..." class="navbar-search-input">
          <button type="submit" class="navbar-search-btn" aria-label="Rechercher">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
        </form>
      </div>

      <ul class="navbar-nav">
        <li class="nav-item">
          <a href="/marketplace" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Accueil</span>
          </a>
        </li>

        <li class="nav-item">
          <a href="/marketplace/products" class="nav-link <%= currentPage === 'products' ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="9" cy="9" r="2"></circle>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
            </svg>
            <span>Produits</span>
          </a>
        </li>

        <li class="nav-item">
          <a href="/marketplace/stores" class="nav-link <%= currentPage === 'stores' ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"></path>
              <path d="M3 9V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3"></path>
            </svg>
            <span>Boutiques</span>
          </a>
        </li>

        <li class="nav-item">
          <a href="#" class="nav-link" id="openFeedbackModalBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Donner un avis</span>
          </a>
        </li>

        <li class="nav-item nav-item-cta">
          <a href="/about" class="nav-link nav-link-cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <line x1="19" y1="8" x2="19" y2="14"></line>
              <line x1="22" y1="11" x2="16" y2="11"></line>
            </svg>
            <span>Devenir Vendeur</span>
          </a>
        </li>
      </ul>

      <!-- User Section (si connecté) -->
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="navbar-user">
          <a href="/dashboard" class="user-link">
            <div class="user-avatar">
              <%= user.business_name ? user.business_name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <span class="user-name"><%= user.business_name || 'Mon compte' %></span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="user-dropdown-icon">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
        </div>
      <% } else { %>
        <div class="navbar-auth">
          <a href="/login" class="btn-login">Connexion</a>
        </div>
      <% } %>
    </div>
  </div>
</nav>

<style>
/* Navbar Marketplace Styles */
.marketplace-navbar {
  background: #253337;
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  transition: background 0.3s ease, backdrop-filter 0.3s ease, box-shadow 0.3s ease;
}

.marketplace-navbar.navbar-scrolled {
  background: rgba(37, 51, 55, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  border-bottom-color: rgba(255,255,255,0.1);
}

.navbar-container {
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70px;
}

/* Brand */
.navbar-brand {
  flex-shrink: 0;
}

.brand-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: #E0FCFC;
  font-weight: 700;
  font-size: 1.25rem;
  transition: opacity 0.2s ease;
}

.brand-link:hover {
  opacity: 0.9;
}

.brand-logo {
  font-size: 1.75rem;
  line-height: 1;
}

.brand-name {
  display: none;
}

@media (min-width: 480px) {
  .brand-name {
    display: block;
  }
}

/* Toggle Button Mobile */
.navbar-toggle {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
  z-index: 1001;
}

.toggle-bar {
  width: 25px;
  height: 3px;
  background: #E0FCFC;
  border-radius: 2px;
  transition: all 0.3s ease;
}

.navbar-toggle.active .toggle-bar:nth-child(1) {
  transform: rotate(45deg) translate(6px, 6px);
}

.navbar-toggle.active .toggle-bar:nth-child(2) {
  opacity: 0;
}

.navbar-toggle.active .toggle-bar:nth-child(3) {
  transform: rotate(-45deg) translate(6px, -6px);
}

/* Navigation Menu */
.navbar-menu {
  display: flex;
  align-items: center;
  gap: 2rem;
  flex: 1;
  justify-content: space-between;
  margin-left: 3rem;
}

.navbar-nav {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Navbar Search */
.navbar-search {
  margin-right: 1.5rem;
}

.navbar-search-form {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 999px;
  padding: 4px 6px 4px 16px;
  transition: all 0.2s ease;
}

.navbar-search-form:focus-within {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.3);
  box-shadow: 0 0 0 2px rgba(224, 252, 252, 0.2);
}

.navbar-search-input {
  background: transparent;
  border: none;
  color: #fff;
  font-family: inherit;
  font-size: 0.85rem;
  width: 180px;
  outline: none;
}

.navbar-search-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.navbar-search-btn {
  background: #E0FCFC;
  color: #253337;
  border: none;
  border-radius: 50%;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.navbar-search-btn:hover {
  transform: scale(1.05);
  background: #fff;
}

.nav-item {
  position: relative;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  color: #C2E0E3;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  border-radius: 8px;
  transition: all 0.2s ease;
  position: relative;
}

.nav-link svg {
  flex-shrink: 0;
}

.nav-link:hover {
  background: rgba(224, 252, 252, 0.1);
  color: #E0FCFC;
}

.nav-link.active {
  background: rgba(224, 252, 252, 0.15);
  color: #E0FCFC;
}

.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40%;
  height: 3px;
  background: #E0FCFC;
  border-radius: 2px 2px 0 0;
}

/* CTA Button - Devenir Vendeur */
.nav-item-cta {
  margin-left: 1rem;
}

.nav-link-cta {
  background: linear-gradient(135deg, #9DB5C0, #C2E0E3);
  color: #253337;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(157, 181, 192, 0.3);
}

.nav-link-cta:hover {
  background: linear-gradient(135deg, #C2E0E3, #E0FCFC);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(157, 181, 192, 0.4);
}

.nav-link-cta.active::after {
  display: none;
}

/* User Section */
.navbar-user {
  display: flex;
  align-items: center;
}

.user-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem;
  padding-right: 0.75rem;
  color: #E0FCFC;
  text-decoration: none;
  border-radius: 999px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  transition: all 0.2s ease;
}

.user-link:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255,255,255,0.2);
}

.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #9DB5C0, #C2E0E3);
  color: #253337;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1rem;
}

.user-name {
  font-weight: 500;
  font-size: 0.95rem;
}

/* Auth Buttons */
.navbar-auth {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.btn-login {
  padding: 0.75rem 1.5rem;
  background: transparent;
  border: 2px solid #C2E0E3;
  color: #E0FCFC;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-login:hover {
  background: #C2E0E3;
  color: #253337;
  transform: translateY(-2px);
}

/* Responsive */
@media (max-width: 1024px) {
  .navbar-container {
    padding: 0 1.5rem;
  }

  .navbar-menu {
    margin-left: 2rem;
  }

  .navbar-nav {
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
  }

  .nav-link span {
    display: none;
  }

  .nav-link svg {
    margin: 0;
  }

  .nav-item-cta .nav-link span {
    display: block;
  }

  .user-name {
    display: none;
  }
}

@media (max-width: 768px) {
  .navbar-toggle {
    display: flex;
  }

  .navbar-menu {
    position: fixed;
    top: 70px;
    left: -100%;
    width: 300px;
    height: calc(100vh - 70px);
    background: #253337;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem;
    gap: 2rem;
    margin: 0;
    overflow-y: auto;
    transition: left 0.3s ease;
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
  }

  .navbar-menu.active {
    left: 0;
  }

  .navbar-nav {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    gap: 0.5rem;
  }

  .nav-item {
    width: 100%;
  }

  .nav-link {
    width: 100%;
    justify-content: flex-start;
  }

  .nav-link span {
    display: block;
  }

  .nav-item-cta {
    margin-left: 0;
    margin-top: 1rem;
    width: 100%;
  }

  .navbar-user,
  .navbar-auth {
    width: 100%;
    padding-top: 1rem;
    border-top: 1px solid rgba(194, 224, 227, 0.2);
  }

  .user-link {
    width: 100%;
  }

  .user-name {
    display: block;
  }

  .btn-login {
    width: 100%;
    text-align: center;
  }
}

/* Overlay Mobile */
@media (max-width: 768px) {
  .navbar-menu.active::before {
    content: '';
    position: fixed;
    top: 70px;
    left: 300px;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: -1;
  }
}
</style>

<style>
/* Modale de Feedback Marketplace */
.mk-modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
  z-index: 9999; display: none; align-items: center; justify-content: center; padding: 24px;
  animation: mkFadeIn 0.2s ease;
}
.mk-modal-overlay.open { display: flex; }
.mk-modal {
  background: white; border-radius: 20px; max-width: 500px; width: 100%;
  max-height: 90vh; overflow-y: auto; box-shadow: 0 30px 80px rgba(0,0,0,0.25);
  animation: mkSlideUp 0.3s ease; color: #1F2937;
}
.mk-modal-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24px; border-bottom: 1px solid #f0f0f0;
}
.mk-modal-header h3 { font-size: 20px; font-weight: 800; margin: 0; }
.mk-modal-close {
  background: none; border: none; font-size: 24px; cursor: pointer; color: #9ca3af;
  width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
}
.mk-modal-close:hover { background: #f3f4f6; color: #374151; }
.mk-modal-body { padding: 24px; }
.mk-modal-footer {
  padding: 16px 24px; border-top: 1px solid #f0f0f0; display: flex; gap: 12px; justify-content: flex-end;
}

.mk-form-group { margin-bottom: 16px; }
.mk-form-label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; }
.mk-form-input, .mk-form-select, .mk-form-textarea {
  width: 100%; padding: 10px 14px; border: 2px solid #e5e7eb; border-radius: 8px;
  font-family: inherit; font-size: 14px; transition: all 0.2s;
}
.mk-form-input:focus, .mk-form-select:focus, .mk-form-textarea:focus {
  outline: none; border-color: #253337;
}

.mk-star-rating { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 8px; }
.mk-star-rating input { display: none; }
.mk-star-rating label { font-size: 28px; color: #d1d5db; cursor: pointer; transition: color 0.2s; }
.mk-star-rating input:checked ~ label, .mk-star-rating label:hover, .mk-star-rating label:hover ~ label { color: #f59e0b; }

.mk-btn-submit {
  padding: 10px 20px; background: #253337; color: white; border: none; border-radius: 8px;
  font-weight: 600; cursor: pointer; transition: 0.2s;
}
.mk-btn-submit:hover { background: #5C6C73; }
.mk-btn-cancel {
  padding: 10px 20px; background: #f3f4f6; color: #374151; border: none; border-radius: 8px;
  font-weight: 600; cursor: pointer; transition: 0.2s;
}
.mk-btn-cancel:hover { background: #e5e7eb; }

@keyframes mkFadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes mkSlideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
</style>

<!-- Modale Avis Marketplace -->
<div class="mk-modal-overlay" id="mkFeedbackModalOverlay">
  <div class="mk-modal">
    <div class="mk-modal-header">
      <h3><svg class="svg-icon svg-icon-fi-rr-bulb" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 18h6"></path><path d="M10 22h4"></path><path d="M12 2a6 6 0 0 0-4 10.47c.5.5.98 1.32 1 2.03v.5h6v-.5c.02-.71.5-1.53 1-2.03A6 6 0 0 0 12 2z"></path></svg> Votre avis compte</h3>
      <button class="mk-modal-close" id="mkCloseFeedbackModal">&times;</button>
    </div>
    <form id="mkFeedbackForm">
      <div class="mk-modal-body">
        <p style="font-size: 14px; color: #4B5563; margin-top: 0; margin-bottom: 20px;">
          Aidez-nous à améliorer Aura Marketplace en partageant votre expérience.
        </p>

        <div class="mk-form-group">
          <label class="mk-form-label">Note globale *</label>
          <div class="mk-star-rating">
            <input type="radio" id="star5" name="rating" value="5" required /><label for="star5" title="Excellent"><svg class="svg-icon svg-icon-fi-ss-star" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></label>
            <input type="radio" id="star4" name="rating" value="4" /><label for="star4" title="Très bien"><svg class="svg-icon svg-icon-fi-ss-star" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></label>
            <input type="radio" id="star3" name="rating" value="3" /><label for="star3" title="Moyen"><svg class="svg-icon svg-icon-fi-ss-star" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></label>
            <input type="radio" id="star2" name="rating" value="2" /><label for="star2" title="Médiocre"><svg class="svg-icon svg-icon-fi-ss-star" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></label>
            <input type="radio" id="star1" name="rating" value="1" /><label for="star1" title="Mauvais"><svg class="svg-icon svg-icon-fi-ss-star" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></label>
          </div>
        </div>

        <div class="mk-form-group">
          <label class="mk-form-label">Catégorie</label>
          <select name="category" id="mkFeedbackCategory" class="mk-form-select">
            <option value="Satisfaction">Satisfaction</option>
            <option value="Suggestion">Suggestion</option>
            <option value="Nouvelle fonctionnalité">Nouvelle fonctionnalité</option>
            <option value="Bug">Signalement de bug</option>
            <option value="Autre">Autre</option>
          </select>
        </div>

        <div class="mk-form-group">
          <label class="mk-form-label">Votre commentaire *</label>
          <textarea id="mkFeedbackComment" class="mk-form-textarea" rows="4" placeholder="Dites-nous tout..." required></textarea>
        </div>
      </div>
      <div class="mk-modal-footer">
        <button type="button" class="mk-btn-cancel" id="mkCancelFeedbackBtn">Annuler</button>
        <button type="submit" class="mk-btn-submit" id="mkSubmitFeedbackBtn">Envoyer mon avis</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/marketplace-navbar.js"></script>
