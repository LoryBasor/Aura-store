<!-- views/partials/support-modal.ejs -->
<div id="supportModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(4px);">
  <div class="modal-content" style="background: var(--bg-card, #fff); width: 100%; max-width: 500px; border-radius: var(--radius, 12px); padding: 24px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); position: relative;">
    <button type="button" class="close-modal-btn" onclick="closeSupportModal()" style="position: absolute; top: 16px; right: 16px; background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text-secondary, #666);">&times;</button>
    
    <h2 style="margin-top: 0; color: var(--text-primary, #333); font-size: 20px; color: var(--primary, #5C6C73);">Contacter le support</h2>
    <p style="color: var(--text-secondary, #666); font-size: 14px; margin-bottom: 20px;">Vous avez une question ou rencontrez un problème ? Laissez-nous un message.</p>
    
    <form id="supportForm">
      <div class="form-group" style="margin-bottom: 16px;">
        <label for="supportName" class="form-label required" style="display: block; margin-bottom: 8px; font-weight: 500;">Votre nom</label>
        <input type="text" id="supportName" name="name" class="form-input" placeholder="Ex: Jean Dupont" style="width: 100%; padding: 10px; border: 1px solid var(--border, #ddd); border-radius: 8px; background: white;" required>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label for="supportEmail" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500;">Votre email (Optionnel)</label>
        <input type="email" id="supportEmail" name="email" class="form-input" placeholder="Pour vous recontacter..." style="width: 100%; padding: 10px; border: 1px solid var(--border, #ddd); border-radius: 8px; background: white;">
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label for="supportSubject" class="form-label required" style="display: block; margin-bottom: 8px; font-weight: 500;">Sujet</label>
        <input type="text" id="supportSubject" name="subject" class="form-input" placeholder="Sujet de votre demande" style="width: 100%; padding: 10px; border: 1px solid var(--border, #ddd); border-radius: 8px; background: white;" required>
      </div>

      <div class="form-group" style="margin-bottom: 20px;">
        <label for="supportMessage" class="form-label required" style="display: block; margin-bottom: 8px; font-weight: 500;">Message</label>
        <textarea id="supportMessage" name="message" class="form-input" rows="4" placeholder="Détaillez votre demande ici..." style="width: 100%; padding: 10px; border: 1px solid var(--border, #ddd); border-radius: 8px; resize: vertical;" required></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="button" class="btn btn-secondary" onclick="closeSupportModal()" style="padding: 10px 16px; border: 1px solid var(--border, #ddd); background: white; border-radius: 6px; cursor: pointer;">Annuler</button>
        <button type="submit" class="btn btn-primary" id="supportSubmitBtn" style="padding: 10px 16px; background: var(--primary, #5C6C73); color: white; border: none; border-radius: 6px; cursor: pointer;">Envoyer</button>
      </div>
    </form>
  </div>
</div>

<!-- Le script modals.js gère cette modale -->
