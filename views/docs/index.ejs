  // Search Index Data
  const searchIndex = [
    { section: 'welcome', title: 'Introduction', content: 'Aura Store e-commerce conversationnel commande 1-click vitrine en ligne afrique subsaharienne' },
    { section: 'quickstart', title: 'Guide de démarrage', content: 'création compte inscription otp téléphone boutique produit partage bio instagram tiktok' },
    { section: 'dashboard', title: 'Tableau de bord', content: 'chiffre d\'affaires commandes conversion produits populaires statistiques ventes' },
    { section: 'products', title: 'Gestion des Produits', content: 'éditeur produits images vidéos cloudinary variantes categories stock rupture' },
    { section: 'orders', title: 'Gestion des Commandes', content: 'cycle de vie nouvelle preparation livree annulée manuelle' },
    { section: 'customization', title: 'Personnalisation', content: 'branding logo bannière couleurs palette police écriture réseaux sociaux instagram facebook' },
    { section: 'whatsapp', title: 'WhatsApp Automation', content: 'qr code appareils connectés réponses automatiques mots-clés mysql ram smart wake-up' },
    { section: 'ai', title: 'Assistant IA', content: 'groq intelligence artificielle statut commande où est ma commande rapport quotidien' },
    { section: 'stats', title: 'Statistiques', content: 'analyses graphiques pdf excel json exportation rentabilité horaire' },
    { section: 'profile', title: 'Mon Profil & Paramètres', content: 'profil paramètres sécurité mot de passe email otp' },
    { section: 'notifications', title: 'Notifications', content: 'canaux email push notifications whatsapp alertes' },
    { section: 'plans', title: 'Comparatif des Plans', content: 'plans tarifs gratuit pro business prix mensuel limites produits' },
    { section: 'faq', title: 'FAQ', content: 'questions frequentes whatsapp sans compte depassement limite auto-extinction' },
    { section: 'glossary', title: 'Glossaire', content: 'otp vitrine client tenant isolation redirection' }
  ];

  function showSection(sectionId) {
    // Hide search results
    document.getElementById('searchResultsSection').classList.remove('active');

    // Find section index
    const index = sections.findIndex(s => s.id === sectionId);
    if (index === -1) return;

    currentSectionIndex = index;

    // Toggle active classes in nav
    document.querySelectorAll('.docs-nav-item').forEach(item => {
      item.classList.remove('active');
      if (item.getAttribute('data-section') === sectionId) {
        item.classList.add('active');
      }
    });

    // Toggle active section
    document.querySelectorAll('.docs-section').forEach(sec => {
      sec.classList.remove('active');
    });
    document.getElementById(sectionId + 'Section').classList.add('active');

    // Update breadcrumbs
    document.getElementById('currentBreadcrumb').innerText = sections[index].title;
    document.getElementById('currentBreadcrumb').href = '#' + sectionId;

    // Update Footer Navigation buttons
    updateFooterNav();

    // Scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateFooterNav() {
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    if (currentSectionIndex > 0) {
      prevBtn.style.display = 'flex';
      document.getElementById('prevTitle').innerText = sections[currentSectionIndex - 1].title;
      prevBtn.href = '#' + sections[currentSectionIndex - 1].id;
    } else {
      prevBtn.style.display = 'none';
    }

    if (currentSectionIndex < sections.length - 1) {
      nextBtn.style.display = 'flex';
      document.getElementById('nextTitle').innerText = sections[currentSectionIndex + 1].title;
      nextBtn.href = '#' + sections[currentSectionIndex + 1].id;
    } else {
      nextBtn.style.display = 'none';
    }
  }

  // Handle sidebar navigation clicks
  document.querySelectorAll('.docs-nav-item').forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const sectionId = item.getAttribute('data-section');
      showSection(sectionId);
      location.hash = sectionId;

      // Close mobile menu if open
      document.getElementById('sidebar').classList.remove('open');
    });
  });

  // Handle footer navigation clicks
  document.getElementById('prevBtn').addEventListener('click', (e) => {
    e.preventDefault();
    if (currentSectionIndex > 0) {
      const prevSectionId = sections[currentSectionIndex - 1].id;
      showSection(prevSectionId);
      location.hash = prevSectionId;
    }
  });

  document.getElementById('nextBtn').addEventListener('click', (e) => {
    e.preventDefault();
    if (currentSectionIndex < sections.length - 1) {
      const nextSectionId = sections[currentSectionIndex + 1].id;
      showSection(nextSectionId);
      location.hash = nextSectionId;
    }
  });

  // Search logic
  const searchInput = document.getElementById('searchInput');
  const searchResultsSection = document.getElementById('searchResultsSection');
  const searchResultsList = document.getElementById('searchResultsList');
  const searchSummary = document.getElementById('searchSummary');

  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (query.length < 2) {
      // Return to current section if search cleared
      if (query.length === 0) {
        showSection(sections[currentSectionIndex].id);
      }
      return;
    }

    // Hide all normal sections
    document.querySelectorAll('.docs-section').forEach(sec => {
      sec.classList.remove('active');
    });

    // Show search results section
    searchResultsSection.classList.add('active');
    document.getElementById('currentBreadcrumb').innerText = 'Résultats de recherche';

    // Filter index
    const results = searchIndex.filter(item => {
      return item.title.toLowerCase().includes(query) || item.content.toLowerCase().includes(query);
    });

    // Render results
    searchResultsList.innerHTML = '';
    searchSummary.innerText = `${results.length} résultat(s) trouvé(s) pour "${e.target.value}"`;

    if (results.length === 0) {
      searchResultsList.innerHTML = '<p>Aucun résultat ne correspond à votre recherche. Essayez avec d\'autres mots-clés.</p>';
      return;
    }

    results.forEach(res => {
      const div = document.createElement('div');
      div.className = 'search-result-item';
      div.innerHTML = `
        <div class="search-result-breadcrumb">Documentation / ${res.title}</div>
        <div class="search-result-title" onclick="goToSection('${res.section}')">${res.title}</div>
        <div class="search-result-snippet">Contenu lié à la recherche. Cliquez pour lire le chapitre complet.</div>
      `;
      searchResultsList.appendChild(div);
    });
  });

  window.goToSection = function(sectionId) {
    searchInput.value = '';
    showSection(sectionId);
    location.hash = sectionId;
  };

  // Mobile menu toggle
  document.getElementById('menuToggle').addEventListener('click', () => {
    document.getElementById('sidebar').classList.toggle('open');
  });

  // Back to top scroll handler
  const backToTop = document.getElementById('backToTop');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      backToTop.classList.add('show');
    } else {
      backToTop.classList.remove('show');
    }
  });

  backToTop.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Accordion Logic
  document.querySelectorAll('.docs-accordion-header').forEach(header => {
    header.addEventListener('click', () => {
      const accordion = header.parentElement;
      accordion.classList.toggle('active');
    });
  });

  // Parse location hash on load
  window.addEventListener('load', () => {
    const hash = location.hash.replace('#', '');
    if (hash) {
      showSection(hash);
    } else {
      showSection('welcome');
    }
  });
</script>
