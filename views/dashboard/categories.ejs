<!-- views/dashboard/categories.ejs -->

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title">Mes catégories</h1>
    <p class="page-subtitle">Organisez vos produits par catégorie</p>
  </div>
  <button class="btn btn-primary" data-action="new-category">
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
    </svg>
    Nouvelle catégorie
  </button>
</div>

<!-- Categories List -->
<div class="card">
  <div class="card-body">
    <div id="categoriesList">
      <!-- Categories will be loaded dynamically -->
    </div>
  </div>
</div>

<!-- Modal Catégorie -->
<div class="modal-overlay" id="categoryModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitle">Nouvelle catégorie</h3>
      <button class="modal-close">✕</button>
    </div>
    <form id="categoryForm">
      <div class="modal-body">
        <input type="hidden" id="categoryId" name="categoryId">

        <div class="form-group">
          <label for="categoryName" class="form-label required">Nom de la catégorie</label>
          <input 
            type="text" 
            id="categoryName" 
            name="name" 
            class="form-input" 
            placeholder="Ex: Électronique, Vêtements..."
            required
          >
          <span class="form-error" id="nameError"></span>
        </div>

        <div class="form-group">
          <label for="categoryDescription" class="form-label">Description (optionnelle)</label>
          <textarea 
            id="categoryDescription" 
            name="description" 
            class="form-textarea" 
            rows="3"
            placeholder="Décrivez cette catégorie..."
          ></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-lg annuler">Annuler</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<style>
.category-item {
  padding: 16px;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 16px;
  transition: var(--transition);
  border: 2px solid transparent;
}

.category-item:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-sm);
}

.category-drag-handle {
  cursor: grab;
  color: var(--color-secondary);
  font-size: 20px;
  padding: 8px;
}

.category-drag-handle:active {
  cursor: grabbing;
}

.category-info {
  flex: 1;
}

.category-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 4px;
}

.category-description {
  font-size: 13px;
  color: var(--color-secondary);
  margin-bottom: 4px;
}

.category-stats {
  font-size: 13px;
  color: var(--color-tertiary);
}

.category-actions {
  display: flex;
  gap: 8px;
}

.empty-categories {
  text-align: center;
  padding: 64px 24px;
}

.empty-categories-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.empty-categories-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8px;
}

.empty-categories-text {
  color: var(--color-secondary);
  margin-bottom: 24px;
}
</style>