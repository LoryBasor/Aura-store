<%# ========================================
    views/dashboard/categories.ejs - SSR VERSION
    ======================================== %>

<% const currentCategories = categories || []; %>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title">Mes catégories</h1>
    <p class="page-subtitle">Organisez vos produits par catégorie (<%= currentCategories.length %> catégorie<%= currentCategories.length > 1 ? 's' : '' %>)</p>
  </div>
  <button class="btn btn-primary" data-action="new-category">
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
    </svg>
    Nouvelle catégorie
  </button>
</div>

<!-- Categories List -->
<div class="card">
  <div class="card-body">
    <div id="categoriesList">
      <% if (currentCategories.length === 0) { %>
        <div class="empty-categories" style="text-align:center;padding:64px 24px;">
          <div class="empty-categories-icon" style="font-size:64px;margin-bottom:16px;"><svg class="svg-icon svg-icon-fi-rr-label" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20.59 13.41 12 22l-9-9V4a2 2 0 0 1 2-2h8.59a2 2 0 0 1 1.41.59l7 7a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>️</div>
          <h3 class="empty-categories-title" style="font-size:20px;font-weight:700;color:var(--color-primary);margin-bottom:8px;">Aucune catégorie</h3>
          <p class="empty-categories-text" style="color:var(--color-secondary);margin-bottom:24px;">Créez vos premières catégories pour organiser vos produits</p>
          <button class="btn btn-primary" data-action="new-category">+ Nouvelle catégorie</button>
        </div>
      <% } else { %>
        <% currentCategories.forEach(cat => { %>
          <div class="category-item" data-category-id="<%= cat.id %>">
            <div class="category-drag-handle">⠿</div>
            <div class="category-info">
              <div class="category-name"><%= cat.name %></div>
              <% if (cat.description) { %>
                <div class="category-description"><%= cat.description %></div>
              <% } %>
              <div class="category-stats">
                <%= cat.product_count || 0 %> produit<%= cat.product_count > 1 ? 's' : '' %>
                <% if (cat.available_products > 0) { %>
                  • <%= cat.available_products %> disponible<%= cat.available_products > 1 ? 's' : '' %>
                <% } %>
              </div>
            </div>
            <div class="category-actions">
              <button class="btn btn-secondary btn-sm" data-action="edit-category" data-category-id="<%= cat.id %>"><svg class="svg-icon svg-icon-fi-rr-pencil" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>️ Modifier</button>
              <button class="btn btn-danger btn-sm" data-action="delete-category" data-category-id="<%= cat.id %>"
                      <%= cat.product_count > 0 ? 'disabled title="Des produits utilisent cette catégorie"' : '' %>><svg class="svg-icon svg-icon-fi-rr-trash" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal Catégorie -->
<div class="modal-overlay" id="categoryModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitle">Nouvelle catégorie</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="categoryForm">
      <div class="modal-body">
        <input type="hidden" id="categoryId" name="categoryId">
        <div class="form-group">
          <label for="categoryName" class="form-label required">Nom de la catégorie</label>
          <input type="text" id="categoryName" name="name" class="form-input" placeholder="Ex: Électronique, Vêtements..." required>
          <span class="form-error" id="nameError"></span>
        </div>
        <div class="form-group">
          <label for="categoryDescription" class="form-label">Description (optionnelle)</label>
          <textarea id="categoryDescription" name="description" class="form-textarea" rows="3" placeholder="Décrivez cette catégorie..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-lg annuler">Annuler</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<!-- Inject categories JSON pour JS (drag & drop) -->
<script id="ssr-categories-data" type="application/json">
  <%- JSON.stringify(currentCategories) %>
</script>

<script src="/js/categories.js"></script>

<style>
.category-item { padding:16px;background:var(--color-surface);border-radius:var(--radius-md);margin-bottom:12px;display:flex;align-items:center;gap:16px;transition:var(--transition);border:2px solid transparent; }
.category-item:hover { border-color:var(--color-primary);box-shadow:var(--shadow-sm); }
.category-drag-handle { cursor:grab;color:var(--color-secondary);font-size:20px;padding:8px; }
.category-drag-handle:active { cursor:grabbing; }
.category-info { flex:1; }
.category-name { font-size:16px;font-weight:700;color:var(--color-primary);margin-bottom:4px; }
.category-description { font-size:13px;color:var(--color-secondary);margin-bottom:4px; }
.category-stats { font-size:13px;color:var(--color-tertiary); }
.category-actions { display:flex;gap:8px; }

@media (max-width: 480px) {
  .category-item {
    flex-wrap: wrap;
  }
  .category-actions {
    width: 100%;
    margin-top: 8px;
  }
  .category-actions .btn {
    flex: 1;
    justify-content: center;
  }
}
</style>