<%# ========================================
    views/dashboard/advanced-stats.ejs - SSR VERSION
    ======================================== %>

<%
  function fmtCurrency(n) { return (parseFloat(n)||0).toLocaleString('fr-FR') + ' FCFA'; }
  function fmtDate(d) { return new Date(d).toLocaleDateString('fr-FR'); }
  const currentEvolution = evolution || [];
  const currentByStatus  = byStatus  || [];
  const currentTopProds  = topProducts || [];
  const currentHourly    = hourlyStats || [];
  const currentCategories = categoryPerformance || [];
  const conv             = conversion  || {};
  const cust             = customers   || {};
  const fore             = forecast    || {};
  const vis              = storeVisibility || 0;
  
  const statusLabels = { nouvelle:'Nouvelle', confirmee:'Confirmée', en_preparation:'En prép.', en_livraison:'En livraison', livree:'Livrée', annulee:'Annulée' };
  const statusColorsMap = { nouvelle:'#3b82f6', confirmee:'#10b981', en_preparation:'#f59e0b', en_livraison:'#f59e0b', livree:'#10b981', annulee:'#ef4444' };
%>

<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title"><svg class="svg-icon svg-icon-fi-rr-chart-histogram" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg> Statistiques Avancées</h1>
    <p class="page-subtitle">Analyse détaillée et visuelle de votre activité</p>
    <span class="period-badge">📅 <%= typeof periodLabel !== 'undefined' ? periodLabel : '30 derniers jours' %></span>
  </div>
  <div style="display:flex;gap:12px;">
    <button onclick="openPrintView()" class="btn btn-secondary"><svg class="svg-icon svg-icon-fi-rr-print" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>️ Imprimer le rapport</button>
  </div>
</div>

<style>
  .stats-advanced-container {
    padding-bottom: 2rem;
    animation: fadeIn 0.6s ease-out forwards;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Metric Cards Premium Design */
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
  }
  
  .metric-card {
    text-align: left;
    padding: 24px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .metric-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 5px;
    background: var(--card-color, var(--color-primary));
    opacity: 0.8;
  }
  
  .metric-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }
  
  .metric-value {
    font-size: 36px;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 4px;
    line-height: 1.1;
    letter-spacing: -1px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--card-color) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .metric-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
  }

  /* Chart Layout */
  .chart-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  @media (max-width: 900px) {
    .chart-grid-2 {
      grid-template-columns: 1fr;
    }
  }
  
  /* Premium Table inside Stats */
  .stats-table-wrapper {
    overflow-x: auto;
    background: #ffffff;
    border-radius: 16px;
  }

  .premium-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  .premium-table th {
    background: #f8fafc;
    color: var(--color-secondary);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.5px;
    padding: 16px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
  }

  .premium-table td {
    padding: 16px;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
    transition: background 0.2s ease;
  }

  .premium-table tr:hover td {
    background: #f8fafc;
  }

  .premium-table tr:last-child td {
    border-bottom: none;
  }

  /* Custom Chart Card */
  .chart-card {
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.02);
    overflow: hidden;
  }
  
  .chart-card-header {
    padding: 20px 24px;
    border-bottom: 1px solid #f1f5f9;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
  }
  .filter-bar {
    display: flex;
    gap: 16px;
    background: #fff;
    padding: 16px 24px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    margin-bottom: 24px;
    align-items: flex-end;
    flex-wrap: wrap;
  }
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .filter-group label {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
  }
  .filter-group input, .filter-group select {
    padding: 8px 12px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
  }
  .comparison-section {
    background: #fff;
    padding: 24px;
    border-radius: 16px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    margin-bottom: 24px;
    display: none; /* Masqué par défaut */
  }
  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 16px;
  }
  .comp-card {
    padding: 16px;
    border-radius: 12px;
    border: 1px solid #f1f5f9;
    background: #f8fafc;
  }
  .comp-title { font-size: 13px; font-weight: 600; color: var(--color-secondary); margin-bottom: 8px; }
  .comp-val-p1 { font-size: 20px; font-weight: 700; color: var(--color-text); margin-bottom: 4px; }
  .comp-val-p2 { font-size: 14px; color: var(--color-secondary); margin-bottom: 8px; }
  .comp-diff { font-weight: 700; padding: 4px 8px; border-radius: 6px; display: inline-block; font-size: 13px; }
  .diff-up { background: #dcfce7; color: #166534; }
  .diff-down { background: #fee2e2; color: #991b1b; }
  .period-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: linear-gradient(135deg, rgba(139,92,246,0.1), rgba(59,130,246,0.1));
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 8px;
  }
  .chart-card-body {
    padding: 24px;
    height: 380px;
    position: relative;
  }
  .chart-card-body-sm {
    padding: 24px;
    height: 320px;
    position: relative;
  }
  .chart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--color-secondary);
    font-weight: 500;
  }
  .chart-empty-icon { font-size: 48px; opacity: 0.3; margin-bottom: 12px; }
</style>

<div class="stats-advanced-container">
<!-- Barre de filtres principale -->
<form id="statsFilterForm" class="filter-bar" method="GET" action="/advanced-stats">
  <div class="filter-group">
    <label>Période</label>
    <select id="filterPeriod" name="period" onchange="toggleCustomDates()">
      <option value="7days" <%= (typeof filterPeriod !== 'undefined' && filterPeriod === '7days') ? 'selected' : '' %>>7 derniers jours</option>
      <option value="30days" <%= (typeof filterPeriod !== 'undefined' && filterPeriod === '30days') ? 'selected' : (!filterPeriod ? 'selected' : '') %>>30 derniers jours</option>
      <option value="90days" <%= (typeof filterPeriod !== 'undefined' && filterPeriod === '90days') ? 'selected' : '' %>>90 derniers jours</option>
      <option value="year" <%= (typeof filterPeriod !== 'undefined' && filterPeriod === 'year') ? 'selected' : '' %>>Cette année</option>
      <option value="custom" <%= (typeof filterPeriod !== 'undefined' && filterPeriod === 'custom') ? 'selected' : '' %>>Personnalisé</option>
    </select>
  </div>
  
  <div class="filter-group custom-date-group" style="display: <%= (typeof filterPeriod !== 'undefined' && filterPeriod === 'custom') ? 'flex' : 'none' %>;">
    <label>Date de début</label>
    <input type="date" id="filterStart" name="start" value="<%= typeof filterStart !== 'undefined' ? filterStart : '' %>">
  </div>
  
  <div class="filter-group custom-date-group" style="display: <%= (typeof filterPeriod !== 'undefined' && filterPeriod === 'custom') ? 'flex' : 'none' %>;">
    <label>Date de fin</label>
    <input type="date" id="filterEnd" name="end" value="<%= typeof filterEnd !== 'undefined' ? filterEnd : '' %>">
  </div>
  
  <div class="filter-group" style="flex-direction: row; gap: 10px; align-items: flex-end; margin-left: auto;">
    <button type="submit" class="btn btn-primary" style="padding: 8px 16px;">Appliquer</button>
    <button type="button" class="btn btn-secondary" style="padding: 8px 16px;" onclick="toggleComparison()">Comparer</button>
  </div>
</form>

<!-- Section Comparaison -->
<div id="comparisonSection" class="comparison-section">
  <h3 style="margin-top:0; font-size: 16px; margin-bottom: 16px;">Comparer deux périodes</h3>
  <div style="display:flex; gap:20px; flex-wrap:wrap; align-items:flex-end;">
    <div class="filter-group">
      <label>Période A (Début)</label>
      <input type="date" id="compAStart">
    </div>
    <div class="filter-group">
      <label>Période A (Fin)</label>
      <input type="date" id="compAEnd">
    </div>
    <div class="filter-group">
      <label>Période B (Début)</label>
      <input type="date" id="compBStart">
    </div>
    <div class="filter-group">
      <label>Période B (Fin)</label>
      <input type="date" id="compBEnd">
    </div>
    <button type="button" class="btn btn-primary" onclick="runComparison()" style="padding: 8px 16px;">Comparer</button>
  </div>
  
  <div id="comparisonResults" class="comparison-grid" style="display:none;">
    <!-- Injecté via JS -->
  </div>
</div>
<!-- Métriques de conversion & Visibilité -->
<div class="card" style="margin-bottom:24px;">
  <div class="card-header" style="border-bottom: 1px solid var(--color-surface);"><h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-stats-up" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg> Vue d'ensemble des performances</h3></div>
  <div style="padding:24px; background: var(--color-surface);">
    <div class="metric-grid">
      <div class="metric-card" style="--card-color: #8b5cf6;">
        <div class="metric-value"><%= vis %></div>
        <div class="metric-label">Vues boutique</div>
      </div>
      <div class="metric-card" style="--card-color: #3b82f6;">
        <div class="metric-value"><%= conv.total_views || 0 %></div>
        <div class="metric-label">Vues produits</div>
      </div>
      <div class="metric-card" style="--card-color: #10b981;">
        <div class="metric-value"><%= conv.total_orders || 0 %></div>
        <div class="metric-label">Commandes</div>
      </div>
      <div class="metric-card" style="--card-color: #f59e0b;">
        <div class="metric-value"><%= conv.conversion_rate || 0 %>%</div>
        <div class="metric-label">Conversion</div>
      </div>
      <div class="metric-card" style="--card-color: #ec4899;">
        <div class="metric-value"><%= fmtCurrency(conv.avg_basket || 0) %></div>
        <div class="metric-label">Panier moyen</div>
      </div>
      <div class="metric-card" style="--card-color: #06b6d4;">
        <div class="metric-value"><%= fmtCurrency(conv.total_revenue || 0) %></div>
        <div class="metric-label">Chiffre d'affaires</div>
      </div>
    </div>
  </div>
</div>

<!-- Évolution (Chart) -->
<div class="chart-card" style="margin-bottom:24px;">
  <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">📈 Évolution des revenus et des commandes</h3></div>
  <div class="chart-card-body">
    <canvas id="evolutionChart"></canvas>
  </div>
</div>

<!-- Grille 2 colonnes (Statuts et Heures) -->
<div class="chart-grid-2">
  <!-- Répartition par statut -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">📊 Commandes par statut</h3></div>
    <div class="chart-card-body-sm" style="display:flex;align-items:center;justify-content:center;">
      <canvas id="statusChart"></canvas>
    </div>
  </div>

  <!-- Activité par heure -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">⏰ Pic d'activité (Commandes par heure)</h3></div>
    <div class="chart-card-body-sm">
      <canvas id="hourlyChart"></canvas>
    </div>
  </div>
</div>

<!-- Grille 2 colonnes (Top Produits et Catégories) -->
<div class="chart-grid-2">
  <!-- Top Produits (Chart) -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">🏆 Revenus par Top 10 produits</h3></div>
    <div class="chart-card-body-sm">
      <canvas id="topProductsChart"></canvas>
    </div>
  </div>

  <!-- Catégories (Chart) -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">📁 Catégories préférées</h3></div>
    <div class="chart-card-body-sm">
      <canvas id="categoriesChart"></canvas>
    </div>
  </div>
</div>

<!-- Grille 2 colonnes (Produits sollicités & Clients Fidèles) -->
<div class="chart-grid-2">
  <!-- Produits sollicités -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;"><svg class="svg-icon svg-icon-fi-rr-eye" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg> Tendances (Produits les plus vus)</h3></div>
    <div class="stats-table-wrapper" style="padding: 16px;">
      <% if (!solicitedProducts || solicitedProducts.length === 0) { %>
        <p style="text-align:center; color: var(--color-secondary); padding: 20px;">Aucune donnée de visibilité.</p>
      <% } else { %>
        <table class="premium-table">
          <thead>
            <tr>
              <th>Produit</th>
              <th>Vues</th>
              <th>Prix</th>
            </tr>
          </thead>
          <tbody>
            <% solicitedProducts.forEach(p => { %>
              <tr>
                <td><strong><%= p.name %></strong></td>
                <td><span class="badge badge-info" style="border-radius: 8px;"><%= p.view_count %> vues</span></td>
                <td style="font-weight: 600; color: var(--color-primary);"><%= fmtCurrency(p.price) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <!-- Top Clients -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;"><svg class="svg-icon svg-icon-fi-rr-star" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Meilleurs clients (Fidèles)</h3></div>
    <div class="stats-table-wrapper" style="padding: 16px;">
      <% if (!topCustomersList || topCustomersList.length === 0) { %>
        <p style="text-align:center; color: var(--color-secondary); padding: 20px;">Aucun client récurrent.</p>
      <% } else { %>
        <table class="premium-table">
          <thead>
            <tr>
              <th>Nom</th>
              <th>Commandes</th>
              <th>Total dépensé</th>
            </tr>
          </thead>
          <tbody>
            <% topCustomersList.forEach(c => { %>
              <tr>
                <td><strong><%= c.name %></strong><br><span style="font-size: 12px; color: var(--color-secondary);"><%= c.phone %></span></td>
                <td><span class="badge <%= c.total_orders > 1 ? 'badge-success' : 'badge-warning' %>" style="border-radius: 8px;"><%= c.total_orders %> cmd(s)</span></td>
                <td style="font-weight: 600; color: var(--color-primary);"><%= fmtCurrency(c.total_spent) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<!-- Grille 2 colonnes (Analyse Clients & Prévisions) -->
<div class="chart-grid-2">
  <!-- Analyse clients -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">👥 Fidélité & Potentiel</h3></div>
    <div style="padding:24px;">
      <div class="chart-card-body-sm" style="height:220px;margin-bottom:20px;">
        <canvas id="customerChart"></canvas>
      </div>
      <div class="metric-grid" style="grid-template-columns: repeat(2, 1fr); gap: 12px;">
        <div class="metric-card" style="--card-color: #3b82f6; box-shadow: none; border: 1px solid #f1f5f9; padding: 16px;">
          <div class="metric-value" style="font-size:28px;"><%= cust.total_customers || 0 %></div>
          <div class="metric-label">Total clients</div>
        </div>
        <div class="metric-card" style="--card-color: #10b981; box-shadow: none; border: 1px solid #f1f5f9; padding: 16px;">
          <div class="metric-value" style="font-size:28px;"><%= cust.repeat_rate || 0 %>%</div>
          <div class="metric-label">Taux fidélité</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Prévisions -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;"><svg class="svg-icon svg-icon-fi-rr-wand" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M15 4V2M15 16v-2M8 9h2M20 9h2M17.8 11.8 19 13M17.8 6.2 19 5M12.2 6.2 11 5M12.2 11.8 11 13"></path><path d="M3 21l9-9"></path></svg> Tendance & Prévisions</h3></div>
    <div style="padding:24px;">
      <% if (fore.last_30_days) { %>
        <div style="margin-bottom:24px; padding: 20px; background: #f8fafc; border-radius: 12px; border-left: 4px solid #3b82f6;">
          <div style="display:flex;justify-content:space-between; align-items: center; margin-bottom: 12px;">
            <span style="color:var(--color-secondary); font-weight: 600;">Commandes (30j)</span>
            <strong style="font-size: 20px; color: var(--color-primary);"><%= fore.last_30_days.orders %></strong>
          </div>
          <div style="display:flex;justify-content:space-between; align-items: center;">
            <span style="color:var(--color-secondary); font-weight: 600;">Chiffre d'affaires (30j)</span>
            <strong style="font-size: 20px; color: #10b981;"><%= fmtCurrency(fore.last_30_days.revenue) %></strong>
          </div>
        </div>
        <% if (fore.growth) { %>
          <div style="padding:20px; background: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); border: 1px solid #f1f5f9; border-left: 4px solid <%= fore.growth.revenue >= 0 ? '#10b981' : '#ef4444' %>;">
            <div style="font-weight:700;margin-bottom:16px; font-size: 16px; color: var(--color-primary);">Croissance vs mois précédent</div>
            <div style="display:flex;justify-content:space-between;margin-bottom:12px; align-items: center;">
              <span style="color: var(--color-secondary); font-weight: 500;">Volume de commandes</span>
              <span style="font-weight: 700; padding: 4px 10px; border-radius: 20px; background: <%= fore.growth.orders >= 0 ? '#dcfce7' : '#fee2e2' %>; color:<%= fore.growth.orders >= 0 ? '#166534' : '#991b1b' %>;">
                <%= fore.growth.orders >= 0 ? '↑' : '↓' %> <%= Math.abs(fore.growth.orders) %>%
              </span>
            </div>
            <div style="display:flex;justify-content:space-between; align-items: center;">
              <span style="color: var(--color-secondary); font-weight: 500;">Revenus générés</span>
              <span style="font-weight: 700; padding: 4px 10px; border-radius: 20px; background: <%= fore.growth.revenue >= 0 ? '#dcfce7' : '#fee2e2' %>; color:<%= fore.growth.revenue >= 0 ? '#166534' : '#991b1b' %>;">
                <%= fore.growth.revenue >= 0 ? '↑' : '↓' %> <%= Math.abs(fore.growth.revenue) %>%
              </span>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div style="padding: 40px 20px; text-align: center;">
          <div style="font-size: 40px; margin-bottom: 12px; opacity: 0.5;"><svg class="svg-icon svg-icon-fi-rr-stats-up" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg></div>
          <p style="color:var(--color-secondary); font-weight: 500;">Pas assez de données pour les prévisions.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Historique des abonnements -->
<div class="chart-card" style="margin-bottom: 24px;">
  <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;"><svg class="svg-icon svg-icon-fi-rr-document" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg> Historique de vos abonnements</h3></div>
  <div style="padding: 16px;">
    <% if (!subHistory || subHistory.length === 0) { %>
      <div style="padding: 40px 20px; text-align: center;">
        <div style="font-size: 40px; margin-bottom: 12px; opacity: 0.5;"><svg class="svg-icon svg-icon-fi-rr-credit-card" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg></div>
        <p style="color:var(--color-secondary); font-weight: 500;">Aucun abonnement enregistré.</p>
      </div>
    <% } else { %>
      <div class="stats-table-wrapper">
        <table class="premium-table">
          <thead>
            <tr>
              <th>Plan</th>
              <th>Statut</th>
              <th>Date de début</th>
              <th>Date de fin</th>
              <th>Prix</th>
            </tr>
          </thead>
          <tbody>
            <% subHistory.forEach(s => { %>
              <tr>
                <td><strong><%= s.plan_name %></strong></td>
                <td>
                  <% if(s.status === 'active') { %><span class="badge badge-success" style="border-radius: 8px;">Actif</span><% } %>
                  <% if(s.status === 'expired') { %><span class="badge badge-error" style="border-radius: 8px;">Expiré</span><% } %>
                  <% if(s.status === 'trial') { %><span class="badge badge-warning" style="border-radius: 8px;">Essai</span><% } %>
                </td>
                <td><%= fmtDate(s.start_date) %></td>
                <td><%= s.end_date ? fmtDate(s.end_date) : 'À vie' %></td>
                <td style="font-weight: 600; color: var(--color-primary);"><%= fmtCurrency(s.price) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- Data Injection SSR -->
<script id="ssr-stats-data" type="application/json">
  <%- JSON.stringify({ 
    evolution: currentEvolution, 
    byStatus: currentByStatus, 
    topProducts: currentTopProds, 
    hourlyStats: currentHourly,
    categories: currentCategories,
    customers: { one_time: cust.one_time_customers || 0, repeat: cust.repeat_customers || 0 },
    statusLabelsMap: statusLabels,
    statusColorsMap: statusColorsMap
  }) %>
</script>

<script src="/js/advanced-stats.js?v=3"></script>
