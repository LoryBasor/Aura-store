<%# ========================================
    views/dashboard/advanced-stats.ejs - SSR VERSION
    ======================================== %>

<%
  function fmtCurrency(n) { return (parseFloat(n)||0).toLocaleString('fr-FR') + ' FCFA'; }
  function fmtDate(d) { return new Date(d).toLocaleDateString('fr-FR'); }
  const currentEvolution = evolution || [];
  const currentByStatus  = byStatus  || [];
  const currentTopProds  = topProducts || [];
  const currentHourly    = hourlyStats || [];
  const currentCategories = categoryPerformance || [];
  const conv             = conversion  || {};
  const cust             = customers   || {};
  const fore             = forecast    || {};
  const vis              = storeVisibility || 0;
  
  const statusLabels = { nouvelle:'Nouvelle', confirmee:'Confirmée', en_preparation:'En prép.', en_livraison:'En livraison', livree:'Livrée', annulee:'Annulée' };
  const statusColorsMap = { nouvelle:'#3b82f6', confirmee:'#10b981', en_preparation:'#f59e0b', en_livraison:'#f59e0b', livree:'#10b981', annulee:'#ef4444' };
%>

<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title">📊 Statistiques Avancées</h1>
    <p class="page-subtitle">Analyse détaillée et visuelle de votre activité (30 derniers jours)</p>
  </div>
  <div style="display:flex;gap:12px;">
    <button onclick="window.print()" class="btn btn-secondary">🖨️ Imprimer le rapport</button>
  </div>
</div>

<style>
  .stats-advanced-container {
    padding-bottom: 2rem;
    animation: fadeIn 0.6s ease-out forwards;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Metric Cards Premium Design */
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
  }
  
  .metric-card {
    text-align: left;
    padding: 24px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .metric-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 5px;
    background: var(--card-color, var(--color-primary));
    opacity: 0.8;
  }
  
  .metric-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }
  
  .metric-value {
    font-size: 36px;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 4px;
    line-height: 1.1;
    letter-spacing: -1px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--card-color) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .metric-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
  }

  /* Chart Layout */
  .chart-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  @media (max-width: 900px) {
    .chart-grid-2 {
      grid-template-columns: 1fr;
    }
  }
  
  /* Premium Table inside Stats */
  .stats-table-wrapper {
    overflow-x: auto;
    background: #ffffff;
    border-radius: 16px;
  }

  .premium-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  .premium-table th {
    background: #f8fafc;
    color: var(--color-secondary);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.5px;
    padding: 16px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
  }

  .premium-table td {
    padding: 16px;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
    transition: background 0.2s ease;
  }

  .premium-table tr:hover td {
    background: #f8fafc;
  }

  .premium-table tr:last-child td {
    border-bottom: none;
  }

  /* Custom Chart Card */
  .chart-card {
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.02);
    overflow: hidden;
  }
  
  .chart-card-header {
    padding: 20px 24px;
    border-bottom: 1px solid #f1f5f9;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
  }
</style>

<div class="stats-advanced-container">
<!-- Métriques de conversion & Visibilité -->
<div class="card" style="margin-bottom:24px;">
  <div class="card-header" style="border-bottom: 1px solid var(--color-surface);"><h3 class="card-title">📈 Vue d'ensemble des performances</h3></div>
  <div style="padding:24px; background: var(--color-surface);">
    <div class="metric-grid">
      <div class="metric-card" style="--card-color: #8b5cf6;">
        <div class="metric-value"><%= vis %></div>
        <div class="metric-label">Vues boutique</div>
      </div>
      <div class="metric-card" style="--card-color: #3b82f6;">
        <div class="metric-value"><%= conv.total_views || 0 %></div>
        <div class="metric-label">Vues produits</div>
      </div>
      <div class="metric-card" style="--card-color: #10b981;">
        <div class="metric-value"><%= conv.total_orders || 0 %></div>
        <div class="metric-label">Commandes</div>
      </div>
      <div class="metric-card" style="--card-color: #f59e0b;">
        <div class="metric-value"><%= conv.conversion_rate || 0 %>%</div>
        <div class="metric-label">Conversion</div>
      </div>
      <div class="metric-card" style="--card-color: #ec4899;">
        <div class="metric-value"><%= fmtCurrency(conv.avg_basket || 0) %></div>
        <div class="metric-label">Panier moyen</div>
      </div>
      <div class="metric-card" style="--card-color: #06b6d4;">
        <div class="metric-value"><%= fmtCurrency(conv.total_revenue || 0) %></div>
        <div class="metric-label">Chiffre d'affaires</div>
      </div>
    </div>
  </div>
</div>

<!-- Évolution (Chart) -->
<div class="chart-card" style="margin-bottom:24px;">
  <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">Évolution des revenus et des commandes</h3></div>
  <div style="padding:24px; height: 400px;">
    <canvas id="evolutionChart"></canvas>
  </div>
</div>

<!-- Grille 2 colonnes (Statuts et Heures) -->
<div class="chart-grid-2">
  <!-- Répartition par statut -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">📊 Commandes par statut</h3></div>
    <div style="padding:24px; height: 350px; display: flex; justify-content: center; align-items: center;">
      <canvas id="statusChart"></canvas>
    </div>
  </div>

  <!-- Activité par heure -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">⏰ Pic d'activité (Commandes par heure)</h3></div>
    <div style="padding:24px; height: 350px;">
      <canvas id="hourlyChart"></canvas>
    </div>
  </div>
</div>

<!-- Grille 2 colonnes (Top Produits et Catégories) -->
<div class="chart-grid-2">
  <!-- Top Produits (Chart) -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">🏆 Revenus par Top 10 produits</h3></div>
    <div style="padding:24px; height: 350px;">
      <canvas id="topProductsChart"></canvas>
    </div>
  </div>

  <!-- Catégories (Chart) -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">📂 Catégories préférées</h3></div>
    <div style="padding:24px; height: 350px;">
      <canvas id="categoriesChart"></canvas>
    </div>
  </div>
</div>

<!-- Grille 2 colonnes (Produits sollicités & Clients Fidèles) -->
<div class="chart-grid-2">
  <!-- Produits sollicités -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">👀 Tendances (Produits les plus vus)</h3></div>
    <div class="stats-table-wrapper" style="padding: 16px;">
      <% if (!solicitedProducts || solicitedProducts.length === 0) { %>
        <p style="text-align:center; color: var(--color-secondary); padding: 20px;">Aucune donnée de visibilité.</p>
      <% } else { %>
        <table class="premium-table">
          <thead>
            <tr>
              <th>Produit</th>
              <th>Vues</th>
              <th>Prix</th>
            </tr>
          </thead>
          <tbody>
            <% solicitedProducts.forEach(p => { %>
              <tr>
                <td><strong><%= p.name %></strong></td>
                <td><span class="badge badge-info" style="border-radius: 8px;"><%= p.view_count %> vues</span></td>
                <td style="font-weight: 600; color: var(--color-primary);"><%= fmtCurrency(p.price) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <!-- Top Clients -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">⭐ Meilleurs clients (Fidèles)</h3></div>
    <div class="stats-table-wrapper" style="padding: 16px;">
      <% if (!topCustomersList || topCustomersList.length === 0) { %>
        <p style="text-align:center; color: var(--color-secondary); padding: 20px;">Aucun client récurrent.</p>
      <% } else { %>
        <table class="premium-table">
          <thead>
            <tr>
              <th>Nom</th>
              <th>Commandes</th>
              <th>Total dépensé</th>
            </tr>
          </thead>
          <tbody>
            <% topCustomersList.forEach(c => { %>
              <tr>
                <td><strong><%= c.name %></strong><br><span style="font-size: 12px; color: var(--color-secondary);"><%= c.phone %></span></td>
                <td><span class="badge <%= c.total_orders > 1 ? 'badge-success' : 'badge-warning' %>" style="border-radius: 8px;"><%= c.total_orders %> cmd(s)</span></td>
                <td style="font-weight: 600; color: var(--color-primary);"><%= fmtCurrency(c.total_spent) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<!-- Grille 2 colonnes (Analyse Clients & Prévisions) -->
<div class="chart-grid-2">
  <!-- Analyse clients -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">👥 Fidélité & Potentiel</h3></div>
    <div id="customerAnalysis" style="padding:24px; background: #ffffff; height: 100%;">
      <div class="metric-grid">
        <div class="metric-card" style="--card-color: #3b82f6; box-shadow: none; border: 1px solid #f1f5f9;">
          <div class="metric-value"><%= cust.total_customers || 0 %></div>
          <div class="metric-label">Total clients</div>
        </div>
        <div class="metric-card" style="--card-color: #f59e0b; box-shadow: none; border: 1px solid #f1f5f9;">
          <div class="metric-value"><%= cust.one_time_customers || 0 %></div>
          <div class="metric-label">1 cmd (Potentiels)</div>
        </div>
        <div class="metric-card" style="--card-color: #10b981; box-shadow: none; border: 1px solid #f1f5f9;">
          <div class="metric-value"><%= cust.repeat_customers || 0 %></div>
          <div class="metric-label">Fidèles (>1 cmd)</div>
        </div>
        <div class="metric-card" style="--card-color: #8b5cf6; box-shadow: none; border: 1px solid #f1f5f9;">
          <div class="metric-value"><%= cust.repeat_rate || 0 %>%</div>
          <div class="metric-label">Taux fidélité</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Prévisions -->
  <div class="chart-card">
    <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">🔮 Tendance & Prévisions</h3></div>
    <div style="padding:24px;">
      <% if (fore.last_30_days) { %>
        <div style="margin-bottom:24px; padding: 20px; background: #f8fafc; border-radius: 12px; border-left: 4px solid #3b82f6;">
          <div style="display:flex;justify-content:space-between; align-items: center; margin-bottom: 12px;">
            <span style="color:var(--color-secondary); font-weight: 600;">Commandes (30j)</span>
            <strong style="font-size: 20px; color: var(--color-primary);"><%= fore.last_30_days.orders %></strong>
          </div>
          <div style="display:flex;justify-content:space-between; align-items: center;">
            <span style="color:var(--color-secondary); font-weight: 600;">Chiffre d'affaires (30j)</span>
            <strong style="font-size: 20px; color: #10b981;"><%= fmtCurrency(fore.last_30_days.revenue) %></strong>
          </div>
        </div>
        <% if (fore.growth) { %>
          <div style="padding:20px; background: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); border: 1px solid #f1f5f9; border-left: 4px solid <%= fore.growth.revenue >= 0 ? '#10b981' : '#ef4444' %>;">
            <div style="font-weight:700;margin-bottom:16px; font-size: 16px; color: var(--color-primary);">Croissance vs mois précédent</div>
            <div style="display:flex;justify-content:space-between;margin-bottom:12px; align-items: center;">
              <span style="color: var(--color-secondary); font-weight: 500;">Volume de commandes</span>
              <span style="font-weight: 700; padding: 4px 10px; border-radius: 20px; background: <%= fore.growth.orders >= 0 ? '#dcfce7' : '#fee2e2' %>; color:<%= fore.growth.orders >= 0 ? '#166534' : '#991b1b' %>;">
                <%= fore.growth.orders >= 0 ? '↑' : '↓' %> <%= Math.abs(fore.growth.orders) %>%
              </span>
            </div>
            <div style="display:flex;justify-content:space-between; align-items: center;">
              <span style="color: var(--color-secondary); font-weight: 500;">Revenus générés</span>
              <span style="font-weight: 700; padding: 4px 10px; border-radius: 20px; background: <%= fore.growth.revenue >= 0 ? '#dcfce7' : '#fee2e2' %>; color:<%= fore.growth.revenue >= 0 ? '#166534' : '#991b1b' %>;">
                <%= fore.growth.revenue >= 0 ? '↑' : '↓' %> <%= Math.abs(fore.growth.revenue) %>%
              </span>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div style="padding: 40px 20px; text-align: center;">
          <div style="font-size: 40px; margin-bottom: 12px; opacity: 0.5;">📈</div>
          <p style="color:var(--color-secondary); font-weight: 500;">Pas assez de données pour les prévisions.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Historique des abonnements -->
<div class="chart-card" style="margin-bottom: 24px;">
  <div class="chart-card-header"><h3 class="card-title" style="margin:0; font-size: 16px;">📜 Historique de vos abonnements</h3></div>
  <div style="padding: 16px;">
    <% if (!subHistory || subHistory.length === 0) { %>
      <div style="padding: 40px 20px; text-align: center;">
        <div style="font-size: 40px; margin-bottom: 12px; opacity: 0.5;">💳</div>
        <p style="color:var(--color-secondary); font-weight: 500;">Aucun abonnement enregistré.</p>
      </div>
    <% } else { %>
      <div class="stats-table-wrapper">
        <table class="premium-table">
          <thead>
            <tr>
              <th>Plan</th>
              <th>Statut</th>
              <th>Date de début</th>
              <th>Date de fin</th>
              <th>Prix</th>
            </tr>
          </thead>
          <tbody>
            <% subHistory.forEach(s => { %>
              <tr>
                <td><strong><%= s.plan_name %></strong></td>
                <td>
                  <% if(s.status === 'active') { %><span class="badge badge-success" style="border-radius: 8px;">Actif</span><% } %>
                  <% if(s.status === 'expired') { %><span class="badge badge-error" style="border-radius: 8px;">Expiré</span><% } %>
                  <% if(s.status === 'trial') { %><span class="badge badge-warning" style="border-radius: 8px;">Essai</span><% } %>
                </td>
                <td><%= fmtDate(s.start_date) %></td>
                <td><%= s.end_date ? fmtDate(s.end_date) : 'À vie' %></td>
                <td style="font-weight: 600; color: var(--color-primary);"><%= fmtCurrency(s.price) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- Data Injection -->
<script>
  window.__SSR_STATS__ = <%- JSON.stringify({ 
    evolution: currentEvolution, 
    byStatus: currentByStatus, 
    topProducts: currentTopProds, 
    hourlyStats: currentHourly,
    categories: currentCategories,
    statusLabelsMap: statusLabels,
    statusColorsMap: statusColorsMap
  }) %>;
</script>

<!-- Chart.js Initialization -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  const data = window.__SSR_STATS__;
  
  // Formatters
  const formatCurrency = (value) => new Intl.NumberFormat('fr-FR').format(value) + ' FCFA';

  // Common Options
  Chart.defaults.font.family = "'Inter', sans-serif";
  Chart.defaults.color = "#6b7280";
  
  // ==========================================
  // 1. Evolution Chart (Line / Combo)
  // ==========================================
  const evCtx = document.getElementById('evolutionChart');
  if (evCtx && data.evolution.length > 0) {
    const labels = data.evolution.map(d => d.label || d.period);
    const revenueData = data.evolution.map(d => d.revenue);
    const ordersData = data.evolution.map(d => d.order_count);

    new Chart(evCtx.getContext('2d'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: "Chiffre d'affaires (FCFA)",
            data: revenueData,
            borderColor: '#8b5cf6',
            backgroundColor: 'rgba(139, 92, 246, 0.1)',
            borderWidth: 2,
            fill: true,
            tension: 0.4,
            yAxisID: 'y'
          },
          {
            label: "Nombre de commandes",
            data: ordersData,
            type: 'bar',
            backgroundColor: 'rgba(59, 130, 246, 0.5)',
            borderRadius: 4,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        scales: {
          y: {
            type: 'linear',
            display: true,
            position: 'left',
            title: { display: true, text: 'Revenus (FCFA)' },
            ticks: { callback: (val) => new Intl.NumberFormat('fr-FR').format(val) }
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',
            title: { display: true, text: 'Commandes' },
            grid: { drawOnChartArea: false },
            ticks: { stepSize: 1 }
          }
        },
        plugins: {
          tooltip: {
            callbacks: {
              label: function(context) {
                if (context.datasetIndex === 0) {
                  return "Chiffre d'affaires: " + formatCurrency(context.raw);
                } else {
                  return "Commandes: " + context.raw;
                }
              }
            }
          }
        }
      }
    });
  }

  // ==========================================
  // 2. Status Distribution Chart (Doughnut)
  // ==========================================
  const stCtx = document.getElementById('statusChart');
  if (stCtx && data.byStatus.length > 0) {
    const labels = data.byStatus.map(d => data.statusLabelsMap[d.status] || d.status);
    const countData = data.byStatus.map(d => d.count);
    const bgColors = data.byStatus.map(d => data.statusColorsMap[d.status] || '#94a3b8');

    new Chart(stCtx.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: countData,
          backgroundColor: bgColors,
          borderWidth: 0,
          hoverOffset: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '70%',
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });
  }

  // ==========================================
  // 3. Hourly Activity Chart (Bar)
  // ==========================================
  const hrCtx = document.getElementById('hourlyChart');
  if (hrCtx && data.hourlyStats.length > 0) {
    // Fill all 24 hours even if empty
    const hoursArray = Array.from({length: 24}, (_, i) => i);
    const orderCounts = new Array(24).fill(0);
    
    data.hourlyStats.forEach(stat => {
      if(stat.hour >= 0 && stat.hour < 24) {
        orderCounts[stat.hour] = stat.order_count;
      }
    });

    const labels = hoursArray.map(h => h + 'h');

    new Chart(hrCtx.getContext('2d'), {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: 'Commandes',
          data: orderCounts,
          backgroundColor: 'rgba(245, 158, 11, 0.7)',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        }
      }
    });
  }

  // ==========================================
  // 4. Top Products Chart (Bar Horizontal)
  // ==========================================
  const tpCtx = document.getElementById('topProductsChart');
  if (tpCtx && data.topProducts.length > 0) {
    const labels = data.topProducts.map(d => d.name.length > 15 ? d.name.substring(0, 15) + '...' : d.name);
    const revenueData = data.topProducts.map(d => d.total_revenue);

    new Chart(tpCtx.getContext('2d'), {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: 'Revenus générés',
          data: revenueData,
          backgroundColor: 'rgba(16, 185, 129, 0.7)',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y', // Horizontal
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (context) => formatCurrency(context.raw) } }
        },
        scales: {
          x: {
            ticks: { callback: (val) => new Intl.NumberFormat('fr-FR').format(val) }
          }
        }
      }
    });
  }

  // ==========================================
  // 5. Categories Performance Chart (Pie)
  // ==========================================
  const catCtx = document.getElementById('categoriesChart');
  if (catCtx && data.categories.length > 0) {
    const labels = data.categories.map(c => c.name);
    const countData = data.categories.map(c => c.order_count);

    new Chart(catCtx.getContext('2d'), {
      type: 'pie',
      data: {
        labels: labels,
        datasets: [{
          data: countData,
          backgroundColor: [
            '#8b5cf6', '#3b82f6', '#10b981', '#f59e0b', '#ec4899', '#64748b'
          ],
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });
  }
});
</script>