<!-- views/dashboard/subscription.ejs -->
<% function fmtDate(d) { if(!d) return '-' ; return new Date(d).toLocaleDateString('fr-FR', { day: 'numeric' ,
  month: 'long' , year: 'numeric' }); } function fmtCurrency(n) { return (parseFloat(n)||0).toLocaleString('fr-FR')
  + ' FCFA' ; } const planColors={ free: '#64748b' , pro: '#3b82f6' , business: '#10b981' }; const planGradients={
  free: 'linear-gradient(135deg, #64748b 0%, #475569 100%)' , pro: 'linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)' ,
  business: 'linear-gradient(135deg, #10b981 0%, #059669 100%)' }; %>

  <style>
    .subscription-container {
      animation: fadeIn 0.6s ease-out forwards;
      padding-bottom: 2rem;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .premium-card {
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      border: 1px solid rgba(0, 0, 0, 0.03);
      overflow: hidden;
      margin-bottom: 24px;
      transition: all 0.3s ease;
    }

    .premium-card-header {
      padding: 20px 24px;
      border-bottom: 1px solid #f1f5f9;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
    }

    .plan-hero {
      color: white;
      padding: 32px 24px;
      position: relative;
      overflow: hidden;
    }

    .plan-hero::after {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
      border-radius: 50%;
    }

    /* Progress Bars */
    .progress-track {
      height: 10px;
      background: #f1f5f9;
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
    }

    .progress-fill {
      height: 100%;
      border-radius: 8px;
      transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }

    .progress-fill::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      right: 0;
      background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 50%, rgba(255, 255, 255, 0) 100%);
      animation: shimmer 2s infinite;
    }

    @keyframes shimmer {
      0% {
        transform: translateX(-100%);
      }

      100% {
        transform: translateX(100%);
      }
    }

    /* Pricing Cards */
    .pricing-card {
      padding: 24px;
      border: 2px solid #f1f5f9;
      border-radius: 20px;
      position: relative;
      transition: all 0.3s ease;
      background: #ffffff;
    }

    .pricing-card:hover {
      border-color: var(--color-primary);
      transform: translateY(-4px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    }

    .pricing-card.active-plan {
      border-color: var(--color-primary);
      background: linear-gradient(to bottom, #ffffff, #f8fafc);
    }

    /* Premium Table */
    .premium-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .premium-table th {
      background: #f8fafc;
      color: var(--color-secondary);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 0.5px;
      padding: 16px;
      text-align: left;
      border-bottom: 1px solid #f1f5f9;
    }

    .premium-table td {
      padding: 16px;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
      transition: background 0.2s ease;
    }

    .premium-table tr:hover td {
      background: #f8fafc;
    }

    .premium-table tr:last-child td {
      border-bottom: none;
    }

    .table-wrapper {
      overflow-x: auto;
    }
  </style>

  <div class="subscription-container">
    <!-- Page Header -->
    <div class="page-header">
      <h1 class="page-title">💳 Mon Abonnement</h1>
      <p class="page-subtitle">Gérez votre plan et suivez votre utilisation</p>
    </div>

    <div class="grille2" style="gap: 24px; margin-bottom: 0;">
      <!-- Colonne Gauche : Plan Actuel & Utilisation -->
      <div style="display: flex; flex-direction: column;">

        <!-- Carte Plan Actuel -->
        <div class="premium-card">
          <div class="plan-hero"
            style="background: <%= subscription ? planGradients[subscription.plan_slug] || 'var(--gradient-primary)' : 'var(--gradient-primary)' %>;">
            <% if (subscription) { %>
              <div
                style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; position: relative; z-index: 1;">
                <div>
                  <p
                    style="text-transform: uppercase; font-size: 12px; font-weight: 700; opacity: 0.8; margin-bottom: 4px; letter-spacing: 1px;">
                    Plan Actuel</p>
                  <h2 style="font-size: 36px; font-weight: 800; margin: 0; line-height: 1;">
                    <%= subscription.plan_name %>
                  </h2>
                </div>
                <span class="badge"
                  style="background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(4px);">
                  <%= subscription.subscription_status==='active' ? 'Actif' : 'Période d\' essai' %>
                </span>
              </div>

              <div style="display: flex; gap: 32px; align-items: center; position: relative; z-index: 1;">
                <div>
                  <p style="font-size: 13px; opacity: 0.8; margin: 0;">Expire le</p>
                  <p style="font-weight: 700; font-size: 16px; margin: 0;">
                    <%= fmtDate(subscription.expires_at) %>
                  </p>
                </div>
                <div style="border-left: 1px solid rgba(255,255,255,0.3); padding-left: 32px;">
                  <p style="font-size: 13px; opacity: 0.8; margin: 0;">Jours restants</p>
                  <p style="font-weight: 700; font-size: 16px; margin: 0;">
                    <%= subscription.days_remaining %>
                  </p>
                </div>
              </div>
              <% } else { %>
                <div style="text-align: center; padding: 20px;">
                  <h2 style="font-size: 24px; font-weight: 800; margin-bottom: 12px;">Aucun abonnement actif</h2>
                  <a href="#plans" class="btn"
                    style="background: white; color: var(--color-primary); border: none;">Choisir un plan</a>
                </div>
                <% } %>
          </div>

          <% if (subscription) { %>
            <div style="padding: 20px 24px; background: #ffffff;">
              <div
                style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #f8fafc; border-radius: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <div
                    style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px #10b981;">
                  </div>
                  <span style="font-size: 14px; font-weight: 600; color: var(--color-primary);">Statut de la
                    boutique</span>
                </div>
                <span style="color: #10b981; font-weight: 700; font-size: 14px;">Opérationnelle</span>
              </div>
              <p style="font-size: 13px; color: var(--color-tertiary); margin: 12px 0 0 0; text-align: center;">
                Votre abonnement est géré par l'administration d'Aura. Contactez le support pour toute modification.
              </p>
            </div>
            <% } %>
        </div>

        <!-- Carte Utilisation -->
        <div class="premium-card">
          <div class="premium-card-header">
            <h3 class="card-title" style="margin:0; font-size: 16px;">📊 Utilisation des ressources</h3>
          </div>
          <div style="padding: 24px;">
            <!-- Limite Produits -->
            <div style="margin-bottom: 28px;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 12px; align-items: center;">
                <span style="font-weight: 600; color: var(--color-primary);">Catalogue de Produits</span>
                <span
                  style="font-size: 14px; font-weight: 700; color: var(--color-secondary); background: #f1f5f9; padding: 4px 10px; border-radius: 20px;">
                  <%= subscription ? subscription.current_products : 0 %> /
                    <%= (subscription && subscription.max_products===-1) ? '∞' : (subscription ?
                      subscription.max_products : 0) %>
                </span>
              </div>
              <div class="progress-track">
                <% let productPct=0; if (subscription && subscription.max_products> 0) {
                  productPct = Math.min(100, (subscription.current_products / subscription.max_products) * 100);
                  }
                  %>
                  <div class="progress-fill"
                    style="width: <%= productPct %>%; background: <%= productPct > 90 ? '#ef4444' : 'linear-gradient(90deg, #3b82f6, #60a5fa)' %>;">
                  </div>
              </div>
            </div>

            <!-- Limite Commandes (Mensuelle - Plan Pro/Business) -->
            <% if (subscription && subscription.plan_slug !=='free' && subscription.plan_slug !=='gratuit' ) { %>
              <div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 12px; align-items: center;">
                  <span style="font-weight: 600; color: var(--color-primary);">Commandes (Ce mois)</span>
                  <span
                    style="font-size: 14px; font-weight: 700; color: var(--color-secondary); background: #f1f5f9; padding: 4px 10px; border-radius: 20px;">
                    <%= subscription.current_month_orders %> /
                      <%= subscription.max_orders_per_month===-1 ? '∞' : subscription.max_orders_per_month %>
                  </span>
                </div>
                <div class="progress-track">
                  <% let orderPct=0; if (subscription.max_orders_per_month> 0) {
                    orderPct = Math.min(100, (subscription.current_month_orders / subscription.max_orders_per_month) *
                    100);
                    }
                    %>
                    <div class="progress-fill"
                      style="width: <%= orderPct %>%; background: <%= orderPct > 90 ? '#ef4444' : 'linear-gradient(90deg, #10b981, #34d399)' %>;">
                    </div>
                </div>
              </div>
              <% } %>

                <!-- Limite Commandes (Hebdomadaire - Plan Gratuit) -->
                <% if (subscription && (subscription.plan_slug==='free' || subscription.plan_slug==='gratuit' )) { %>
                  <div>
                    <div
                      style="display: flex; justify-content: space-between; margin-bottom: 12px; align-items: center;">
                      <span style="font-weight: 600; color: var(--color-primary);">Quota Commandes (Hebdomadaire)</span>
                      <span
                        style="font-size: 14px; font-weight: 700; color: var(--color-secondary); background: #f1f5f9; padding: 4px 10px; border-radius: 20px;">
                        <%= locals.weeklyOrders || 0 %> / 20
                      </span>
                    </div>
                    <div class="progress-track">
                      <% let weekPct=Math.min(100, ((locals.weeklyOrders || 0) / 20) * 100); %>
                        <div class="progress-fill"
                          style="width: <%= weekPct %>%; background: <%= weekPct > 90 ? '#ef4444' : 'linear-gradient(90deg, #6366f1, #8b5cf6)' %>;">
                        </div>
                    </div>
                    <p style="font-size: 11px; color: var(--color-tertiary); margin-top: 8px;">
                      Les commandes sont limitées à 20 par période de 7 jours glissants pour le plan gratuit.
                    </p>
                  </div>
                  <% } %>
          </div>
        </div>

        <!-- Historique -->
        <div class="premium-card">
          <div class="premium-card-header">
            <h3 class="card-title" style="margin:0; font-size: 16px;">📜 Historique récent</h3>
          </div>
          <div style="padding: 0;">
            <% if (history && history.length> 0) { %>
              <div class="table-wrapper">
                <table class="premium-table">
                  <thead>
                    <tr>
                      <th>Action</th>
                      <th>Plan</th>
                      <th>Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% history.forEach(item=> { %>
                      <tr>
                        <td style="text-transform: capitalize; font-weight: 500;">
                          <%= item.action %>
                        </td>
                        <td style="color: var(--color-primary); font-weight: 600;">
                          <%= item.plan_name %>
                        </td>
                        <td style="color: var(--color-secondary);">
                          <%= fmtDate(item.created_at) %>
                        </td>
                      </tr>
                      <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
                <div style="padding: 40px 20px; text-align: center;">
                  <div style="font-size: 32px; margin-bottom: 12px; opacity: 0.5;">🕒</div>
                  <p style="color: var(--color-secondary); font-weight: 500;">Aucun historique disponible.</p>
                </div>
                <% } %>
          </div>
        </div>

      </div>

      <!-- Colonne Droite : Comparaison des Plans -->
      <div id="plans" style="display: flex; flex-direction: column;">
        <div class="premium-card" style="height: 100%;">
          <div class="premium-card-header" style="background: linear-gradient(to right, #f8fafc, #ffffff);">
            <h3 class="card-title" style="margin:0; font-size: 16px; display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 20px;">🚀</span> Evoluez avec Aura
            </h3>
          </div>
          <div style="padding: 24px;">
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <% plans.forEach(plan=> { %>
                <% const isActive=subscription && subscription.plan_slug===plan.slug; %>
                  <div class="pricing-card <%= isActive ? 'active-plan' : '' %>">
                    <% if (isActive) { %>
                      <span
                        style="position: absolute; top: -12px; right: 24px; background: var(--color-success); color: white; padding: 4px 16px; border-radius: 20px; font-size: 11px; font-weight: 800; letter-spacing: 1px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                        PLAN ACTUEL
                      </span>
                      <% } %>

                        <div
                          style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 16px;">
                          <div>
                            <h4 style="font-size: 22px; font-weight: 800; margin: 0; color: var(--color-primary);">
                              <%= plan.name %>
                            </h4>
                            <p style="font-size: 13px; color: var(--color-secondary); margin-top: 4px;">
                              <%= plan.description %>
                            </p>
                          </div>
                          <div style="text-align: right;">
                            <p
                              style="font-size: 28px; font-weight: 900; color: <%= isActive ? 'var(--color-primary)' : '#0f172a' %>; margin: 0; line-height: 1;">
                              <%= plan.price> 0 ? fmtCurrency(plan.price) : 'Gratuit' %>
                            </p>
                            <p
                              style="font-size: 12px; color: var(--color-tertiary); font-weight: 600; text-transform: uppercase;">
                              / mois</p>
                          </div>
                        </div>

                        <ul
                          style="list-style: none; padding: 0; margin: 0 0 24px 0; display: grid; grid-template-columns: 1fr; gap: 12px;">
                          <li
                            style="font-size: 14px; display: flex; align-items: center; gap: 10px; color: var(--color-primary); font-weight: 500;">
                            <div
                              style="background: #dcfce7; color: #10b981; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                              ✓</div>
                            <%= plan.max_products < 0 ? 'Produits illimités' : plan.max_products + ' Produits max' %>
                          </li>
                          <li
                            style="font-size: 14px; display: flex; align-items: center; gap: 10px; color: var(--color-primary); font-weight: 500;">
                            <div
                              style="background: #dcfce7; color: #10b981; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                              ✓</div>
                            <%= plan.max_orders_per_month < 0 ? 'Commandes illimitées' : plan.max_orders_per_month
                              + ' Commandes / semaine' %>
                          </li>
                          <% if (plan.has_analytics) { %>
                            <li
                              style="font-size: 14px; display: flex; align-items: center; gap: 10px; color: var(--color-primary); font-weight: 500;">
                              <div
                                style="background: #dcfce7; color: #10b981; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                ✓</div>
                              Statistiques avancées
                            </li>
                            <% } %>
                              <% if (plan.slug==='business' ) { %>
                                <li
                                  style="font-size: 14px; display: flex; align-items: center; gap: 10px; color: var(--color-primary); font-weight: 500;">
                                  <div
                                    style="background: #dcfce7; color: #10b981; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                    ✓</div>
                                  Personnalisation UI Premium
                                </li>
                                <li
                                  style="font-size: 14px; display: flex; align-items: center; gap: 10px; color: var(--color-primary); font-weight: 500;">
                                  <div
                                    style="background: #dcfce7; color: #10b981; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                    ✓</div>
                                  Intégration WhatsApp & Réseaux Sociaux
                                </li>
                                <% } %>
                        </ul>

                        <% if (!isActive) { %>
                          <button class="btn btn-outline btn-block"
                            style="width: 100%; justify-content: center; border-radius: 12px;"
                            onclick="UI.showNotification('Mise à niveau', 'Contactez l\'administration au bryantzoua4@gmail.com ou +237 671 646 335 pour changer de plan.', 'info')">
                            Passer au plan <%= plan.name %>
                          </button>
                          <% } else { %>
                            <button class="btn btn-primary btn-block"
                              style="width: 100%; justify-content: center; border-radius: 12px; cursor: default; opacity: 0.8;"
                              disabled>
                              Plan Actuel
                            </button>
                            <% } %>
                  </div>
                  <% }); %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>