<!-- views/dashboard/messages.ejs -->
<style>
  @media (max-width: 768px) {
    .messages-container {
      flex-direction: column !important;
      height: calc(100vh - 150px) !important;
      min-height: 0 !important;
    }
    .conversations-list {
      width: 100% !important;
      height: 100% !important;
      max-height: none !important;
    }
    .chat-area {
      height: 100% !important;
      width: 100% !important;
    }
    .msg-bubble {
      max-width: 95% !important;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    .message-input-container {
      flex-direction: column !important;
      align-items: stretch !important;
    }
    .message-input-container .form-input {
      min-height: 80px !important;
    }
    .message-input-container .btn {
      width: 100% !important;
      margin-top: 5px;
    }
    .messages-container.has-active-ticket .conversations-list {
      display: none !important;
    }
    .messages-container:not(.has-active-ticket) .chat-area {
      display: none !important;
    }
    .mobile-back-btn {
      display: block !important;
    }
  }
</style>
<div class="dashboard-header">
  <div class="header-content">
    <h2>Messagerie Support</h2>
    <p class="subtitle">Discutez directement avec l'équipe Aura Store.</p>
  </div>
  <button class="btn btn-primary" style="cursor: pointer;" onclick="openNewTicketModal()">+ Nouveau Ticket</button>
</div>

<div class="messages-container <%= activeTicket ? 'has-active-ticket' : '' %>" style="display: flex; gap: 20px; height: calc(100vh - 200px); min-height: 500px;">

  <!-- Liste des conversations (SSR) -->
  <div class="conversations-list" style="width: 300px; background: var(--bg-card,#fff); border-radius: var(--radius,12px); border: 1px solid var(--border,#ddd); display: flex; flex-direction: column; overflow: hidden;">
    <div style="padding: 16px; border-bottom: 1px solid var(--border,#ddd); font-weight: bold;">
      Vos tickets
    </div>
    <div style="overflow-y: auto; flex: 1;">
      <% if (!conversations || conversations.length === 0) { %>
        <div style="padding: 20px; text-align: center; color: #888; font-size: 13px;">
          Aucun ticket. Créez-en un pour contacter le support.
        </div>
      <% } else { %>
        <% conversations.forEach(conv => {
          const date = new Date(conv.updated_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
          const isActive = activeTicket && activeTicket.id == conv.id;
          const isUnread = conv.unread_count > 0;
        %>
          <a href="/dashboard/messages?ticket=<%= conv.id %>" style="text-decoration: none; color: inherit; display: block;">
            <div style="padding: 16px; border-bottom: 1px solid var(--border,#eee); cursor: pointer; transition: background 0.2s; background: <%= isActive ? '#f1f5f9' : 'white' %>; border-left: 3px solid <%= isActive ? 'var(--primary,#5C6C73)' : (isUnread ? '#ef4444' : 'transparent') %>;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div style="font-weight: <%= isUnread ? '700' : '600' %>; font-size: 14px; color: #333;"><%= conv.subject %></div>
                <div style="font-size: 11px; color: #888; flex-shrink: 0; margin-left: 8px;"><%= date %></div>
              </div>
              <div style="font-size: 12px; color: <%= conv.status === 'open' ? '#22c55e' : '#94a3b8' %>; margin-top: 4px;">
                <%= conv.status === 'open' ? '● Ouvert' : '○ Fermé' %>
                <% if (isUnread) { %> · <strong style="color:#ef4444;">Nouveau</strong><% } %>
              </div>
            </div>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Zone de chat (SSR) -->
  <div class="chat-area" style="flex: 1; background: var(--bg-card,#fff); border-radius: var(--radius,12px); border: 1px solid var(--border,#ddd); display: flex; flex-direction: column; overflow: hidden;">

    <!-- En-tête du chat -->
    <div style="padding: 16px; border-bottom: 1px solid var(--border,#ddd); display: flex; justify-content: space-between; flex-direction: column; background: #f9fafb;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="/dashboard/messages" class="mobile-back-btn" style="display: none; text-decoration: none; color: #333; font-size: 20px;" title="Retour aux tickets">&larr;</a>
        <div style="font-weight: bold; font-size: 16px; color: var(--text-primary,#333);">
          <%= activeTicket ? activeTicket.subject : 'Sélectionnez une conversation' %>
        </div>
      </div>
      <% if (activeTicket) { %>
        <span style="font-size: 12px; padding: 4px 8px; border-radius: 4px; background: <%= activeTicket.status === 'open' ? '#dcfce7' : '#f1f5f9' %>; color: <%= activeTicket.status === 'open' ? '#166534' : '#475569' %>;">
          <%= activeTicket.status === 'open' ? 'Actif' : 'Fermé' %>
        </span>
      <% } %>
    </div>

    <!-- Messages -->
    <div id="chatMessages" style="flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 16px; background: #fafafa;">
      <% if (!activeTicket) { %>
        <div style="text-align: center; color: #999; margin: auto;">Aucune conversation sélectionnée</div>
      <% } else if (!activeMessages || activeMessages.length === 0) { %>
        <div style="text-align: center; color: #888; margin: auto;">Aucun message pour l'instant.</div>
      <% } else { %>
        <% activeMessages.forEach(msg => {
          const isMe = msg.sender_role === 'vendor';
          const time = new Date(msg.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
        %>
          <div class="msg-bubble" style="max-width:80%; padding:12px 16px; border-radius:12px; font-size:14px; line-height:1.4; align-self:<%= isMe ? 'flex-end' : 'flex-start' %>; background:<%= isMe ? 'var(--primary,#5C6C73)' : 'white' %>; color:<%= isMe ? 'white' : '#333' %>; border:<%= isMe ? 'none' : '1px solid #ddd' %>; border-bottom-<%= isMe ? 'right' : 'left' %>-radius: 4px;">
            <div><%- msg.content.replace(/\n/g, '<br>') %></div>
            <% if (msg.attachments && msg.attachments.length > 0) { %>
              <div style="margin-top: 8px;">
                <% msg.attachments.forEach(att => { %>
                  <a href="<%= att.file_url %>" target="_blank" style="display:inline-flex;align-items:center;gap:8px;padding:6px 10px;background:rgba(0,0,0,0.1);border-radius:6px;margin-top:4px;color:inherit;text-decoration:none;font-size:12px;">
                    <svg class="svg-icon svg-icon-fi-rr-paperclip" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21.44 11.05 12.25 20.24a5.5 5.5 0 0 1-7.78-7.78l9.19-9.19a3.5 3.5 0 0 1 4.95 4.95L9.41 17.41a1.5 1.5 0 0 1-2.12-2.12l8.49-8.48"></path></svg> <%= att.file_name %>
                  </a>
                <% }) %>
              </div>
            <% } %>
            <div style="font-size: 11px; margin-top: 6px; opacity: 0.7; text-align: right;"><%= time %></div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- Formulaire d'envoi (uniquement si ticket ouvert) -->
    <% if (activeTicket && activeTicket.status === 'open') { %>
      <div style="padding: 16px; border-top: 1px solid var(--border,#ddd); background: white;">
        <form id="sendMessageForm" style="display: flex; flex-direction: column; gap: 10px;">
          <input type="hidden" id="currentConversationId" value="<%= activeTicket.id %>">
          <div class="message-input-container" style="display: flex; gap: 10px; align-items: flex-end;">
            <textarea id="messageContent" class="form-input" rows="2" placeholder="Écrivez votre message..." style="flex: 1; resize: none; border-radius: 8px;"></textarea>
            <!-- <label class="btn btn-secondary" style="padding: 10px; cursor: pointer; border-radius: 8px; display: none;" title="Joindre un fichier (Max 5Mo)">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
              <input type="file" id="messageAttachment" style="display: none;" multiple disabled>
            </label> -->
            <button type="submit" class="btn btn-primary" id="sendBtn" style="padding: 10px 20px; border-radius: 8px;">Envoyer</button>
          </div>
        </form>
      </div>
    <% } else if (activeTicket && activeTicket.status !== 'open') { %>
      <div style="padding: 16px; background: #f1f5f9; text-align: center; font-size: 13px; color: #64748b; border-top: 1px solid #ddd;">
        Ce ticket est clôturé. Créez un nouveau ticket si besoin.
      </div>
    <% } %>

  </div>
</div>

<!-- Modale Nouveau Ticket -->
<div id="newTicketModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
  <div style="background: white; width: 100%; max-width: 500px; padding: 24px; border-radius: 12px; position: relative;">
    <button onclick="closeNewTicketModal()" style="position: absolute; top: 16px; right: 16px; background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
    <h3 style="margin-top: 0;">Créer un nouveau ticket</h3>
    <form id="newTicketForm" style="display: flex; flex-direction: column; gap: 16px; margin-top: 20px;">
      <div>
        <label class="form-label">Sujet <span style="color:#e74c3c">*</span></label>
        <input type="text" id="ticketSubject" class="form-input" required placeholder="Ex : Problème avec ma boutique">
      </div>
      <div>
        <label class="form-label">Message <span style="color:#e74c3c">*</span></label>
        <textarea id="ticketMessage" class="form-input" rows="4" required placeholder="Décrivez votre problème..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Créer le ticket</button>
    </form>
  </div>
</div>

<script src="/js/vendor-messages.js"></script>
