<!-- views/dashboard/integrations.ejs -->

<!-- Page Header -->
<div class="page-header">
  <h1 class="page-title"><svg class="svg-icon svg-icon-fi-rr-link" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg> Intégrations Sociales</h1>
  <p class="page-subtitle">Connectez vos réseaux sociaux</p>
</div>

<!-- Container principal -->
<div id="integrationsContainer">

  <!-- WhatsApp -->
  <div class="card" style="margin-bottom: 24px;">
    <div class="card-header">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 48px; height: 48px; background: #25D366; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px;">
          <svg class="svg-icon svg-icon-fi-rr-smartphone" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
        </div>
        <div style="flex: 1;">
          <h3 class="card-title">WhatsApp Business</h3>
          <p style="font-size: 13px; color: var(--color-secondary); margin: 0;">
            Permettez aux clients de commander via WhatsApp
          </p>
        </div>
        <div id="whatsappStatus"></div>
      </div>
    </div>
    <form id="whatsappForm">
      <div style="padding: 24px;">
        <div class="form-group">
          <label class="form-label required">Numéro WhatsApp</label>
          <input 
            type="tel" 
            id="whatsappNumber" 
            class="form-input" 
            placeholder="+237 6XX XXX XXX"
            required
          >
          <p class="form-help">Format international requis (ex: +237671646335)</p>
        </div>

        <div class="form-group">
          <label style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
            <input type="checkbox" id="whatsappEnabled">
            <span>Activer WhatsApp sur ma boutique</span>
          </label>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <button type="submit" class="btn btn-primary">
            <svg class="svg-icon svg-icon-fi-rr-disk" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Enregistrer
          </button>
          <button type="button" class="btn btn-secondary" data-action="test-whatsapp">
            <svg class="svg-icon svg-icon-fi-rr-flask" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 3v6l-6 10a2 2 0 0 0 2 3h14a2 2 0 0 0 2-3L15 9V3"></path><line x1="9" y1="3" x2="15" y2="3"></line><line x1="7" y1="15" x2="17" y2="15"></line></svg> Tester le message
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Instagram -->
  <div class="card" style="margin-bottom: 24px;">
    <div class="card-header">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 48px; height: 48px; background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px;">
          <svg class="svg-icon svg-icon-fi-rr-camera" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        </div>
        <div style="flex: 1;">
          <h3 class="card-title">Instagram</h3>
          <p style="font-size: 13px; color: var(--color-secondary); margin: 0;">
            Lien vers votre profil Instagram
          </p>
        </div>
        <div id="instagramStatus"></div>
      </div>
    </div>
    <form id="instagramForm">
      <div style="padding: 24px;">
        <div class="form-group">
          <label class="form-label">URL ou nom d'utilisateur</label>
          <input 
            type="text" 
            id="instagramUrl" 
            class="form-input" 
            placeholder="@ma_boutique ou https://instagram.com/ma_boutique"
          >
        </div>

        <div class="form-group">
          <label style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
            <input type="checkbox" id="instagramEnabled">
            <span>Afficher le lien Instagram</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary">
          <svg class="svg-icon svg-icon-fi-rr-disk" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Enregistrer
        </button>
      </div>
    </form>
  </div>

  <!-- Facebook -->
  <div class="card" style="margin-bottom: 24px;">
    <div class="card-header">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 48px; height: 48px; background: #1877F2; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px;">
          <svg class="svg-icon svg-icon-fi-rr-users" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <div style="flex: 1;">
          <h3 class="card-title">Facebook</h3>
          <p style="font-size: 13px; color: var(--color-secondary); margin: 0;">
            Lien vers votre page Facebook
          </p>
        </div>
        <div id="facebookStatus"></div>
      </div>
    </div>
    <form id="facebookForm">
      <div style="padding: 24px;">
        <div class="form-group">
          <label class="form-label">URL de la page</label>
          <input 
            type="text" 
            id="facebookUrl" 
            class="form-input" 
            placeholder="ma_boutique ou https://facebook.com/ma_boutique"
          >
        </div>

        <div class="form-group">
          <label style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
            <input type="checkbox" id="facebookEnabled">
            <span>Afficher le lien Facebook</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary">
          <svg class="svg-icon svg-icon-fi-rr-disk" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Enregistrer
        </button>
      </div>
    </form>
  </div>

  <!-- Message personnalisé -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-comment-alt" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 11.5a8.38 8.38 0 0 1-4.06 7.2A8.5 8.5 0 0 1 4 15.8L3 21l5.2-1a8.5 8.5 0 0 1 3.8.9 8.38 8.38 0 0 1 4-1 8.5 8.5 0 0 1 5-8.2z"></path></svg> Message WhatsApp personnalisé</h3>
    </div>
    <form id="customMessageForm">
      <div style="padding: 24px;">
        <div class="form-group">
          <label class="form-label">Modèle de message</label>
          <textarea 
            id="customOrderMessage" 
            class="form-textarea" 
            rows="5"
          ></textarea>
          <p class="form-help">
            Variables disponibles : <code>{{product_name}}</code>, <code>{{product_price}}</code>, <code>{{currency}}</code>, <code>{{quantity}}</code>
          </p>
        </div>

        <div id="messagePreview" style="margin-bottom: 16px;"></div>

        <button type="submit" class="btn btn-primary">
          <svg class="svg-icon svg-icon-fi-rr-disk" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Enregistrer le message
        </button>
      </div>
    </form>
  </div>

</div>

<!-- Inject data for JS (SSR JSON block) -->
<script id="ssr-integrations-data" type="application/json">
  <%- JSON.stringify(integrations || {}) %>
</script>
<script src="/js/integrations.js"></script>