<%# ========================================
    views/dashboard/profile.ejs - SSR VERSION
    ======================================== %>

<% const p = profile || user || {}; %>

<!-- Page Header -->
<div class="page-header">
  <h1 class="page-title"><svg class="svg-icon svg-icon-fi-rr-user" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg> Mon Profil</h1>
  <p class="page-subtitle">Gérez vos informations personnelles</p>
</div>

<!-- Informations Compte -->
<div class="card">
  <div class="card-header">
    <h3 class="card-title">Informations du compte</h3>
    <% if (p.plan_name) { %>
      <span class="badge badge-<%= p.plan_name.toLowerCase() === 'gratuit' ? 'info' : (p.plan_name.toLowerCase().includes('business') ? 'success' : 'warning') %>">
        Plan <%= p.plan_name %>
      </span>
    <% } %>
  </div>
  <form id="profileForm">
    <div style="padding:24px;">
      <div class="form-group">
        <label for="business_name" class="form-label required">Nom de l'entreprise</label>
        <input type="text" id="business_name" name="business_name" class="form-input"
               value="<%= p.business_name || '' %>" placeholder="Ma Boutique" required>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input type="email" id="email" class="form-input" value="<%= p.email || '' %>"
               disabled style="background:var(--color-surface);cursor:not-allowed;">
        <p class="form-help">L'email ne peut pas être modifié</p>
      </div>

      <div class="form-group">
        <label for="phone" class="form-label">Téléphone</label>
        <input type="tel" id="phone" name="phone" class="form-input"
               value="<%= p.phone || '' %>" placeholder="+237 6XX XXX XXX">
      </div>

      <div class="form-group">
        <label for="whatsapp_number" class="form-label">Numéro WhatsApp</label>
        <input type="tel" id="whatsapp_number" name="whatsapp_number" class="form-input"
               value="<%= p.whatsapp_number || '' %>" placeholder="+237 6XX XXX XXX">
        <p class="form-help">Utilisé pour les liens de commande WhatsApp</p>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div class="form-group">
          <label for="country" class="form-label">Pays</label>
          <input type="text" id="country" name="country" class="form-input"
                 value="<%= p.country || '' %>" placeholder="ex: Cameroun">
        </div>
        <div class="form-group">
          <label for="city" class="form-label">Ville</label>
          <input type="text" id="city" name="city" class="form-input"
                 value="<%= p.city || '' %>" placeholder="ex: Douala">
        </div>
      </div>

      <% if (p.store_slug) { %>
      <div class="form-group">
        <label class="form-label">Lien de votre boutique</label>
        <div style="display:flex;gap:12px;">
          <input type="text" id="store_link" class="form-input" readonly
                 value="<%= process.env.APP_URL || '' %>/store/<%= p.store_slug %>"
                 style="background:var(--color-surface);">
          <button type="button" class="btn btn-secondary" data-action="copy-store-link"><svg class="svg-icon svg-icon-fi-rr-clipboard" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg> Copier</button>
        </div>
        <p class="form-help">Partagez ce lien pour afficher tous vos produits</p>
      </div>
      <% } %>

      <button type="submit" class="btn btn-primary"><svg class="svg-icon svg-icon-fi-rr-disk" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Enregistrer les modifications</button>
    </div>
  </form>
</div>

<!-- Changement de mot de passe -->
<div class="card">
  <div class="card-header">
    <h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-lock" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> Changer le mot de passe</h3>
  </div>
  <form id="passwordForm">
    <div style="padding:24px;">
      <div class="form-group">
        <label for="old_password" class="form-label required">Mot de passe actuel</label>
        <input type="password" id="old_password" name="old_password" class="form-input" required>
      </div>
      <div class="form-group">
        <label for="new_password" class="form-label required">Nouveau mot de passe</label>
        <input type="password" id="new_password" name="new_password" class="form-input" minlength="8" required>
        <p class="form-help">Minimum 8 caractères</p>
      </div>
      <div class="form-group">
        <label for="confirm_password" class="form-label required">Confirmer le nouveau mot de passe</label>
        <input type="password" id="confirm_password" name="confirm_password" class="form-input" required>
      </div>
      <button type="submit" class="btn btn-primary"><svg class="svg-icon svg-icon-fi-rr-lock" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> Changer le mot de passe</button>
    </div>
  </form>
</div>

<!-- Abonnement actuel -->
<% if (p.plan_name) { %>
<div class="card">
  <div class="card-header">
    <h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-clipboard" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg> Mon abonnement</h3>
    <a href="/subscription" class="card-action">Gérer →</a>
  </div>
  <div style="padding:24px;">
    <div style="display:flex;align-items:center;gap:16px;">
      <div style="font-size:48px;">
        <%- p.plan_name.toLowerCase() === 'gratuit' ? '🆓' : p.plan_name.toLowerCase().includes('business') ? '<svg class="svg-icon svg-icon-fi-rr-gem" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h12l4 6-10 12L2 9z"></path><path d="M11 3 8 9l4 12 4-12-3-6"></path><path d="M2 9h20"></path></svg>' : '<svg class="svg-icon svg-icon-fi-rr-star" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>' %>
      </div>
      <div>
        <h4 style="font-size:20px;font-weight:700;color:var(--color-primary);">Plan <%= p.plan_name %></h4>
        <% if (p.end_date) { %>
          <p style="color:var(--color-secondary);">Expire le : <%= new Date(p.end_date).toLocaleDateString('fr-FR') %></p>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% } %>

<script src="/js/profile.js"></script>