<%# ========================================
    views/dashboard/orders.ejs - SSR VERSION
    ======================================== %>

<%
  const statusColors  = { nouvelle:'info', confirmee:'success', en_preparation:'warning', en_livraison:'warning', livree:'success', annulee:'error' };
  const statusLabels  = { nouvelle:'🆕 Nouvelle', confirmee:'<svg class="svg-icon svg-icon-fi-rr-check-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Confirmée', en_preparation:'<svg class="svg-icon svg-icon-fi-rr-user" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>‍<svg class="svg-icon svg-icon-fi-rr-pot" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M4 8h16l-1.5 11a2 2 0 0 1-2 1.8H7.5a2 2 0 0 1-2-1.8z"></path><path d="M2 8h20"></path><path d="M8 8V6a4 4 0 0 1 8 0v2"></path></svg> En prép.', en_livraison:'<svg class="svg-icon svg-icon-fi-rr-truck-side" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="6" width="15" height="11" rx="1"></rect><path d="M16 10h4l3 3v4h-7z"></path><circle cx="6" cy="19" r="2"></circle><circle cx="17.5" cy="19" r="2"></circle></svg> En livraison', livree:'<svg class="svg-icon svg-icon-fi-rr-box" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 8v13H3V8"></path><path d="M1 3h22v5H1z"></path><line x1="10" y1="12" x2="14" y2="12"></line></svg> Livrée', annulee:'<svg class="svg-icon svg-icon-fi-rr-cross-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg> Annulée' };
  function fmtCurrency(n) { return (parseFloat(n)||0).toLocaleString('fr-FR') + ' FCFA'; }
  function fmtDate(d) { if(!d) return '-'; return new Date(d).toLocaleDateString('fr-FR'); }
  const currentOrders     = orders     || [];
  const currentPagination = pagination || { page:1, limit:20, total:0 };
  const currentFilters    = filters    || {};
  const stats             = orderStats || {};
  const totalPages        = Math.ceil(currentPagination.total / currentPagination.limit);
%>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title"><svg class="svg-icon svg-icon-fi-rr-box" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 8v13H3V8"></path><path d="M1 3h22v5H1z"></path><line x1="10" y1="12" x2="14" y2="12"></line></svg> Mes commandes</h1>
    <p class="page-subtitle">Suivez et gérez toutes vos commandes (<%= currentPagination.total %> au total)</p>
  </div>
  <button class="btn btn-primary" data-action="new-order">+ Nouvelle commande</button>
</div>

<!-- Stats Commandes -->
<div class="stats-grid" id="orderStats" style="margin-bottom:24px;">
  <div class="stat-card">
    <div class="stat-header"><span class="stat-label">Total</span><div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-box" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 8v13H3V8"></path><path d="M1 3h22v5H1z"></path><line x1="10" y1="12" x2="14" y2="12"></line></svg></div></div>
    <div class="stat-value"><%= stats.total_orders || 0 %></div>
    <div class="stat-change"><%= stats.pending_orders || 0 %> en attente</div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><span class="stat-label">Livrées</span><div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-check-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div></div>
    <div class="stat-value"><%= stats.delivered_orders || 0 %></div>
    <div class="stat-change positive">Complétées</div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><span class="stat-label">Chiffre d'affaires</span><div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-sack-dollar" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 5 7 2h10l-2 3"></path><path d="M7 5c-3 3-4.5 6.5-4.5 9.5A7.5 7.5 0 0 0 10 22h4a7.5 7.5 0 0 0 7.5-7.5c0-3-1.5-6.5-4.5-9.5z"></path><path d="M12 9v7"></path><path d="M14 11a2 2 0 0 0-2-2h0a2 2 0 0 0 0 4h0a2 2 0 0 1 0 4h0a2 2 0 0 1-2-2"></path></svg></div></div>
    <div class="stat-value"><%= fmtCurrency(stats.total_revenue || 0) %></div>
    <div class="stat-change">Panier moy: <%= fmtCurrency(stats.avg_order_value || 0) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><span class="stat-label">Annulées</span><div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-cross-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg></div></div>
    <div class="stat-value"><%= stats.cancelled_orders || 0 %></div>
    <div class="stat-change">Total annulées</div>
  </div>
</div>

<!-- Filters (GET form pour SSR) -->
<div class="card" style="margin-bottom:24px;">
  <form method="GET" action="/orders" style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;padding:16px;">
    <input type="search" name="search" class="form-input" style="flex:1;min-width:200px;"
           placeholder="Rechercher par n° commande, client..." value="<%= currentFilters.search || '' %>">
    <select name="status" class="form-select" style="flex:1;min-width:150px;" onchange="this.form.submit()">
      <option value="" <%= !currentFilters.status ? 'selected' : '' %>>Tous les statuts</option>
      <option value="nouvelle"      <%= currentFilters.status === 'nouvelle'      ? 'selected' : '' %>>Nouvelles</option>
      <option value="confirmee"     <%= currentFilters.status === 'confirmee'     ? 'selected' : '' %>>Confirmées</option>
      <option value="en_preparation"<%= currentFilters.status === 'en_preparation'? 'selected' : '' %>>En préparation</option>
      <option value="en_livraison"  <%= currentFilters.status === 'en_livraison'  ? 'selected' : '' %>>En livraison</option>
      <option value="livree"        <%= currentFilters.status === 'livree'        ? 'selected' : '' %>>Livrées</option>
      <option value="annulee"       <%= currentFilters.status === 'annulee'       ? 'selected' : '' %>>Annulées</option>
    </select>
    <button class="btn btn-secondary" data-action="export-orders" type="button" style="flex:1;min-width:150px;"><svg class="svg-icon svg-icon-fi-rr-chart-histogram" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg> Exporter</button>
  </form>
</div>

<!-- Orders Table -->
<div class="card">
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>Code WhatsApp</th>
          <th>Date</th>
          <th>Client</th>
          <th>Produit</th>
          <th style="text-align:right;">Qté</th>
          <th style="text-align:right;">Montant</th>
          <th>Statut</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="ordersTableBody">
        <% if (currentOrders.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align:center;padding:48px;">
              <div style="font-size:48px;margin-bottom:16px;"><svg class="svg-icon svg-icon-fi-rr-envelope-open" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2z"></path><polyline points="22 6 12 13 2 6"></polyline></svg></div>
              <p style="color:var(--color-secondary);">Aucune commande trouvée</p>
            </td>
          </tr>
        <% } else { %>
          <% currentOrders.forEach(order => { %>
            <tr>
              <td>
                <strong style="font-size:16px;letter-spacing:1px;">#<%= order.order_code || '---' %></strong>
                <div style="font-size:10px;color:var(--color-secondary);margin-top:2px;"><%= order.order_number %></div>
              </td>
              <td><%= fmtDate(order.created_at) %></td>
              <td>
                <div><strong><%= order.customer_name %></strong></div>
                <div style="font-size:12px;color:var(--color-secondary);"><%= order.customer_phone || '' %></div>
              </td>
              <td><%= order.product_name %></td>
              <td style="text-align:right;"><%= order.quantity %></td>
              <td style="text-align:right;"><strong><%= fmtCurrency(order.total_amount) %></strong></td>
              <td><span class="badge badge-<%= statusColors[order.status] || 'info' %>"><%- statusLabels[order.status] || order.status %></span></td>
              <td>
                <div style="display:flex;gap:6px;">
                  <button class="btn btn-secondary btn-sm" data-action="view-order" data-order-id="<%= order.id %>"><svg class="svg-icon svg-icon-fi-rr-eye" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg></button>
                  <button class="btn btn-outline btn-sm"   data-action="edit-order"   data-order-id="<%= order.id %>"><svg class="svg-icon svg-icon-fi-rr-pencil" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>️</button>
                  <button class="btn btn-primary btn-sm"   data-action="change-status" data-order-id="<%= order.id %>" data-status="<%= order.status %>"><svg class="svg-icon svg-icon-fi-rr-refresh" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg></button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination SSR -->
<% if (totalPages > 1) { %>
<div id="pagination" class="flex-center" style="margin-top:24px;gap:8px;">
  <% if (currentPagination.page > 1) { %>
    <a href="/orders?page=<%= currentPagination.page - 1 %>&status=<%= currentFilters.status || '' %>&search=<%= currentFilters.search || '' %>"
       class="btn btn-secondary btn-sm">← Précédent</a>
  <% } %>
  <span style="padding:8px 16px;color:var(--color-secondary);font-size:13px;">
    Page <%= currentPagination.page %> / <%= totalPages %>
  </span>
  <% if (currentPagination.page < totalPages) { %>
    <a href="/orders?page=<%= currentPagination.page + 1 %>&status=<%= currentFilters.status || '' %>&search=<%= currentFilters.search || '' %>"
       class="btn btn-secondary btn-sm">Suivant →</a>
  <% } %>
</div>
<% } %>

<!-- MODALS (CRUD via API fetch - comportement conservé) -->
<div class="modal-overlay" id="orderModal">
  <div class="modal" style="max-width:700px;">
    <div class="modal-header">
      <h3 class="modal-title" id="orderModalTitle">Nouvelle commande</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="orderForm">
      <div class="modal-body">
        <input type="hidden" id="orderId">
        <div class="form-group">
          <label class="form-label required">Produit</label>
          <input type="text" id="productSearch" class="form-input" placeholder="Rechercher un produit (tapez pour filtrer)..." style="margin-bottom: 8px;">
          <select id="productId" class="form-select" required>
            <option value="">-- Sélectionner un produit --</option>
          </select>
          <p class="form-help" id="productInfo"></p>
        </div>
        <div style="padding:16px;background:var(--color-surface);border-radius:var(--radius-sm);margin-bottom:16px;">
          <h4 style="font-size:16px;font-weight:700;margin-bottom:12px;"><svg class="svg-icon svg-icon-fi-rr-user" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg> Informations client</h4>
          <div class="form-group">
            <label class="form-label required">Nom du client</label>
            <input type="text" id="customerName" class="form-input" placeholder="Ex: lory basor" required>
          </div>
          <div class="form-group">
            <label class="form-label required">Téléphone</label>
            <input type="tel" id="customerPhone" class="form-input" placeholder="+237 6XX XXX XXX" required>
          </div>
          <div class="form-group">
            <label class="form-label">Adresse de livraison</label>
            <textarea id="customerAddress" class="form-textarea" rows="2" placeholder="Adresse complète..."></textarea>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label required">Quantité</label>
          <input type="number" id="quantity" class="form-input" min="1" value="1" required>
          <p class="form-help" id="stockInfo"></p>
        </div>
        <div id="totalAmountDisplay" style="padding:16px;background:var(--color-accent);border-radius:var(--radius-sm);margin-bottom:16px;display:none;">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <strong style="font-size:16px;">Montant total :</strong>
            <strong style="font-size:24px;color:var(--color-primary);" id="totalAmount">0 FCFA</strong>
          </div>
        </div>
        <div class="form-group" id="statusGroup" style="display:none;">
          <label class="form-label">Statut</label>
          <select id="orderStatus" class="form-select">
            <option value="nouvelle">🆕 Nouvelle</option>
            <option value="confirmee">✅ Confirmée</option>
            <option value="en_preparation">👨‍🍳 En préparation</option>
            <option value="en_livraison">🚚 En livraison</option>
            <option value="livree">📦 Livrée</option>
            <option value="annulee">❌ Annulée</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Notes (optionnel)</label>
          <textarea id="orderNotes" class="form-textarea" rows="3" placeholder="Informations complémentaires..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary" id="submitOrderBtn">Créer la commande</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="orderDetailsModal">
  <div class="modal" style="max-width:700px;">
    <div class="modal-header">
      <h3 class="modal-title"><svg class="svg-icon svg-icon-fi-rr-clipboard" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg> Détails de la commande</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <div class="modal-body" id="orderDetailsBody"><div class="loader"></div></div>
    <div class="modal-footer"><button class="btn btn-secondary modal-close">Fermer</button></div>
  </div>
</div>

<div class="modal-overlay" id="statusModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title"><svg class="svg-icon svg-icon-fi-rr-refresh" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg> Changer le statut</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="statusForm">
      <div class="modal-body">
        <input type="hidden" id="statusOrderId">
        <div class="form-group">
          <label for="newStatus" class="form-label required">Nouveau statut</label>
          <select id="newStatus" name="status" class="form-select" required>
            <option value="">-- Sélectionner --</option>
            <option value="nouvelle">🆕 Nouvelle</option>
            <option value="confirmee">✅ Confirmée</option>
            <option value="en_preparation">👨‍🍳 En préparation</option>
            <option value="en_livraison">🚚 En livraison</option>
            <option value="livree">📦 Livrée</option>
            <option value="annulee">❌ Annulée</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary">Mettre à jour</button>
      </div>
    </form>
  </div>
</div>

<!-- Inject data for JS interactivity (SSR JSON block) -->
<script id="ssr-orders-data" type="application/json">
  {
    "orders": <%- JSON.stringify(currentOrders) %>,
    "products": <%- JSON.stringify(availableProducts || []) %>
  }
</script>
<script src="/js/orders.js"></script>
