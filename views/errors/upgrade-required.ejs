<!-- views/errors/upgrade-required.ejs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fonctionnalité Business | AURA</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: linear-gradient(135deg, #0d1b1e, #1a3340);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      font-family: 'Inter', sans-serif;
    }

    .upgrade-container {
      max-width: 580px;
      width: 100%;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 24px;
      padding: 56px 48px;
      text-align: center;
      backdrop-filter: blur(20px);
      box-shadow: 0 32px 64px rgba(0,0,0,0.4);
    }

    .upgrade-icon {
      width: 90px;
      height: 90px;
      background: linear-gradient(135deg, #f59e0b, #ef4444);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 32px;
      font-size: 42px;
    }

    .upgrade-badge {
      display: inline-block;
      background: linear-gradient(135deg, #f59e0b, #f97316);
      color: white;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 100px;
      margin-bottom: 16px;
    }

    .upgrade-title {
      font-size: 28px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 12px;
    }

    .upgrade-feature {
      font-size: 15px;
      color: rgba(255,255,255,0.5);
      margin-bottom: 8px;
    }

    .upgrade-message {
      font-size: 15px;
      color: rgba(255,255,255,0.65);
      margin-bottom: 36px;
      line-height: 1.7;
    }

    .upgrade-perks {
      background: rgba(255,255,255,0.05);
      border-radius: 14px;
      padding: 20px 24px;
      margin-bottom: 32px;
      text-align: left;
    }

    .upgrade-perks li {
      list-style: none;
      font-size: 14px;
      color: rgba(255,255,255,0.75);
      padding: 6px 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .upgrade-perks li span.check {
      color: #25d366;
      font-size: 16px;
      flex-shrink: 0;
    }

    .upgrade-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-upgrade {
      background: linear-gradient(135deg, #f59e0b, #f97316);
      color: white;
      font-weight: 600;
      padding: 14px 28px;
      border-radius: 12px;
      border: none;
      font-size: 15px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-upgrade:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(245,158,11,0.35);
    }

    .btn-back {
      background: rgba(255,255,255,0.08);
      color: rgba(255,255,255,0.8);
      font-weight: 500;
      padding: 14px 28px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.12);
      font-size: 15px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: background 0.2s;
    }

    .btn-back:hover {
      background: rgba(255,255,255,0.14);
    }

    @media (max-width: 480px) {
      .upgrade-container { padding: 40px 24px; }
      .upgrade-title { font-size: 22px; }
      .upgrade-actions { flex-direction: column; }
    }
  </style>
</head>
<body>
  <div class="upgrade-container">
    <div class="upgrade-icon">💎</div>
    <div class="upgrade-badge">Plan Business requis</div>
    <h1 class="upgrade-title">Fonctionnalité exclusive</h1>
    <p class="upgrade-feature"><strong style="color:#f59e0b;"><%= feature %></strong></p>
    <p class="upgrade-message">
      Cette fonctionnalité est réservée aux abonnés du plan <strong style="color:#f59e0b;">Business</strong>.<br>
      Passez à un niveau supérieur pour profiter de l'automatisation WhatsApp, l'IA, et bien plus encore.
    </p>

    <ul class="upgrade-perks">
      <li><span class="check">✅</span> Connexion & automatisation WhatsApp</li>
      <li><span class="check">✅</span> Assistant IA qui répond à vos clients 24h/24</li>
      <li><span class="check">✅</span> Notifications de commandes en temps réel</li>
      <li><span class="check">✅</span> Réponses automatiques personnalisées</li>
      <li><span class="check">✅</span> Mise à jour des statuts par WhatsApp</li>
    </ul>

    <div class="upgrade-actions">
      <a href="/dashboard/subscription" class="btn-upgrade">
        ⭐ Passer au Business
      </a>
      <a href="/dashboard" class="btn-back">
        ← Mon Dashboard
      </a>
    </div>
  </div>
</body>
</html>
