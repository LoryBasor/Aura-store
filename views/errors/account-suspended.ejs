<!-- views/errors/account-suspended.ejs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Compte Suspendu | AURA</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: linear-gradient(135deg, #253337, #5C6C73);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .suspended-container {
      max-width: 600px;
      width: 100%;
      background: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 48px;
      text-align: center;
      box-shadow: var(--shadow-lg);
      border-top: 5px solid var(--color-error);
    }

    .suspended-icon {
      font-size: 80px;
      margin-bottom: 24px;
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    .suspended-title {
      font-size: 28px;
      font-weight: 700;
      color: var(--color-error);
      margin-bottom: 16px;
    }

    .suspended-message {
      font-size: 16px;
      color: var(--color-secondary);
      margin-bottom: 24px;
      line-height: 1.6;
    }

    .suspended-reason {
      padding: 20px;
      background: rgba(244, 67, 54, 0.1);
      border-left: 4px solid var(--color-error);
      border-radius: var(--radius-sm);
      margin-bottom: 24px;
      text-align: left;
    }

    .suspended-reason-title {
      font-weight: 700;
      color: var(--color-error);
      margin-bottom: 8px;
    }

    .suspended-reason-text {
      color: var(--color-primary);
      line-height: 1.6;
    }

    .contact-info {
      padding: 20px;
      background: var(--color-surface);
      border-radius: var(--radius-md);
      margin-top: 24px;
    }

    .contact-title {
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 12px;
    }

    .contact-details {
      font-size: 14px;
      color: var(--color-secondary);
    }

    @media (max-width: 768px) {
      .suspended-container {
        padding: 32px 24px;
      }

      .suspended-icon {
        font-size: 60px;
      }

      .suspended-title {
        font-size: 22px;
      }
    }
  </style>

  <style>.svg-icon{display:inline-block;vertical-align:-0.125em;flex-shrink:0;}</style>
</head>
<body>
  <div class="suspended-container">
    <div class="suspended-icon"><svg class="svg-icon svg-icon-fi-rr-ban" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg></div>
    
    <h1 class="suspended-title">Compte Suspendu</h1>
    
    <p class="suspended-message">
      Votre compte a été temporairement suspendu par l'administration.
      Vous ne pouvez pas accéder à la plateforme pour le moment.
    </p>

    <div class="suspended-reason">
      <div class="suspended-reason-title"><svg class="svg-icon svg-icon-fi-rr-clipboard" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg> Raison de la suspension :</div>
      <div class="suspended-reason-text">
        <%= reason || 'Aucune raison spécifiée' %>
      </div>
    </div>

    <div class="contact-info">
      <div class="contact-title"><svg class="svg-icon svg-icon-fi-rr-phone-call" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13 1 .36 1.99.68 2.94a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.14-1.14a2 2 0 0 1 2.11-.45c.95.32 1.94.55 2.94.68A2 2 0 0 1 22 16.92z"></path></svg> Contactez le support</div>
      <div class="contact-details">
        <p style="margin-bottom: 8px;">
          Pour contester cette suspension ou obtenir plus d'informations,
          veuillez contacter notre équipe support :
        </p>
        <p style="margin-bottom: 4px;">
          <strong>Email :</strong> bryantzoua4@gmail.com
        </p>
        <p style="margin-bottom: 4px;">
          <strong>Téléphone :</strong> +237 671 64 63 35
        </p>
      </div>
    </div>

    <button class="btn btn-secondary deco" style="margin-top: 24px; width: 100%;">
      Retour à la connexion
    </button>
  </div>

  <script src="/js/errors/account-suspended.js"></script>
</body>
</html>
