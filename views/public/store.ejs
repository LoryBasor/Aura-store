<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title id="pageTitle">Boutique | AURA</title>
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    body {
      background: #F5F7F9;
      min-height: 100vh;
    }

    .store-header {
      background: linear-gradient(135deg, #253337, #5C6C73);
      color: white;
      padding: 48px 24px;
      text-align: center;
    }

    .store-name {
      font-size: 48px;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .store-subtitle {
      font-size: 18px;
      opacity: 0.9;
    }

    .store-container {
      max-width: 1200px;
      margin: -32px auto 0;
      padding: 0 24px 48px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }

    .product-card {
      background: white;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
      cursor: pointer;
    }

    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow-lg);
    }

    .product-image {
      width: 100%;
      height: 250px;
      object-fit: cover;
      background: linear-gradient(135deg, var(--color-surface), var(--color-accent));
    }

    .product-info {
      padding: 20px;
    }

    .product-name {
      font-size: 18px;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 8px;
      display: -webkit-box;
      --webkit-line-clamp: 2;
      --webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-price {
      font-size: 24px;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 12px;
    }

    .product-cta {
      width: 100%;
      background: #25D366;
      color: white;
      padding: 12px;
      border-radius: var(--radius-sm);
      border: none;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
    }

    .product-cta:hover {
      background: #20BA5A;
    }

    @media (max-width: 768px) {
      .store-name {
        font-size: 32px;
      }

      .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
      }
    }
  </style>
</head>
<body>
  <!-- Header Boutique -->
  <div class="store-header">
    <div id="storeInfo">
      <div class="store-name">Chargement...</div>
    </div>
  </div>

  <!-- Conteneur Produits -->
  <div class="store-container">
    <div id="productsGridStore" class="products-grid">
      <!-- Produits chargés dynamiquement -->
    </div>
  </div>
  
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/planManager.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>