     views/public/store.ejs
     ======================================== -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title id="pageTitle">Boutique | AURA</title>
  <link rel="stylesheet" href="/css/style.css">
  
  <style>
    body {
      background: #F5F7F9;
      min-height: 100vh;
    }

    .store-header {
      background: linear-gradient(135deg, #253337, #5C6C73);
      color: white;
      padding: 48px 24px;
      text-align: center;
    }

    .store-name {
      font-size: 48px;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .store-subtitle {
      font-size: 18px;
      opacity: 0.9;
    }

    .store-container {
      max-width: 1200px;
      margin: -32px auto 0;
      padding: 0 24px 48px;
    }

    /* Barre de recherche */
    .search-container {
      background: white;
      border-radius: var(--radius-lg);
      padding: 24px;
      margin-bottom: 32px;
      box-shadow: var(--shadow-sm);
    }

    .search-wrapper {
      position: relative;
      max-width: 600px;
      margin: 0 auto;
    }

    .search-input {
      width: 100%;
      padding: 16px 48px 16px 20px;
      font-size: 16px;
      border: 2px solid #E5E7EB;
      border-radius: var(--radius-md);
      transition: var(--transition);
      outline: none;
    }

    .search-input:focus {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(37, 51, 55, 0.1);
    }

    .search-icon {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 20px;
      color: var(--color-secondary);
      pointer-events: none;
    }

    .search-results-count {
      text-align: center;
      margin-top: 12px;
      color: var(--color-secondary);
      font-size: 14px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }

    .product-card {
      background: white;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
      cursor: pointer;
    }

    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow-lg);
    }

    .product-card.hidden {
      display: none;
    }

    .product-image {
      width: 100%;
      height: 250px;
      object-fit: cover;
      background: linear-gradient(135deg, var(--color-surface), var(--color-accent));
    }

    .product-info {
      padding: 20px;
    }

    .product-name {
      font-size: 18px;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 8px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-price {
      font-size: 24px;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 12px;
    }

    .product-cta {
      width: 100%;
      background: #25D366;
      color: white;
      padding: 12px;
      border-radius: var(--radius-sm);
      border: none;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
    }

    .product-cta:hover {
      background: #20BA5A;
    }

    .no-results {
      grid-column: 1 / -1;
      text-align: center;
      padding: 64px 24px;
    }

    @media (max-width: 768px) {
      .store-name {
        font-size: 32px;
      }

      .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
      }

      .search-container {
        padding: 16px;
      }

      .search-input {
        padding: 12px 40px 12px 16px;
        font-size: 14px;
      }
    }
  </style>
</head>
<body>
  <!-- Header Boutique -->
  <div class="store-header">
    <div id="storeInfo">
      <div class="store-name">Chargement...</div>
    </div>
  </div>

  <!-- Conteneur Produits -->
  <div class="store-container">
    <!-- Barre de recherche -->
    <div id="searchContainer" class="search-container" style="display: none;">
      <div class="search-wrapper">
        <input 
          type="text" 
          id="searchInput" 
          class="search-input" 
          placeholder="🔍 Rechercher un produit..."
          autocomplete="off"
        >
        <span class="search-icon">🔍</span>
      </div>
      <div id="searchResultsCount" class="search-results-count"></div>
    </div>

    <div id="productsGridStore" class="products-grid">
      <!-- Produits chargés dynamiquement -->
    </div>
  </div>
  
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/planManager.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>