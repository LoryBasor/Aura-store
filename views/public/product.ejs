              <option value="" disabled selected>Sélectionnez une raison</option>
              <option value="Arnaque">Arnaque suspectée</option>
              <option value="Produit interdit">Produit interdit ou illégal</option>
              <option value="Faux produit">Contrefaçon / Faux produit</option>
              <option value="Mauvaise description">Description trompeuse</option>
              <option value="Spam">Spam</option>
              <option value="Autre">Autre raison</option>
