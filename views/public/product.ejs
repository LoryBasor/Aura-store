        <div class="modal-footer">
          <button type="button" class="btn-cancel" id="cancelReport">Annuler</button>
          <button type="submit" class="btn-confirm" id="submitReport" style="background: #ef4444; border-color: #ef4444;">Signaler</button>
        </div>
      </form>
    </div>
