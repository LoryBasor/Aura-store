          <img src="<%= product.image_url %>" alt="<%= product.name %>" class="product-main-img" width="200px" height="200px" data-zoomable="1" data-index="0">
        </div>
      <% } else { %>
        <div class="product-img-placeholder"><svg class="svg-icon svg-icon-fi-rr-box" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 8v13H3V8"></path><path d="M1 3h22v5H1z"></path><line x1="10" y1="12" x2="14" y2="12"></line></svg></div>
      <% } %>

      <% if (product.store_slug) { %>
        <a href="/store/<%= product.store_slug %>" class="store-badge">
          <% if (c.logo_url) { %>
            <img src="<%= c.logo_url %>" style="width:28px;height:28px;border-radius:50%;object-fit:cover;" alt="Logo">
          <% } else { %>
            <span style="width:28px;height:28px;border-radius:50%;background:var(--store-primary);display:inline-flex;align-items:center;justify-content:center;color:white;font-weight:800;font-size:14px;">
              <%= (c.store_title || product.business_name || 'S').charAt(0) %>
            </span>
          <% } %>
          Voir toute la boutique →
        </a>
      <% } %>
    </div>

    <!-- Right: Info -->
    <div class="product-info">
      
      <div>
        <div class="product-category"><%= product.category_name || 'Produit' %></div>
        <h1 class="product-title" style="margin-top:8px;"><%= product.name %></h1>
      </div>

      <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <% if (product.is_promotion_active) { %>
          <div>
            <div style="font-size:18px;color:var(--store-desc);text-decoration:line-through;font-weight:600;">
              <%= product.price.toLocaleString() %> <%= product.currency %>
            </div>
            <div class="product-price" style="line-height:1;">
              <%= product.effective_price.toLocaleString() %> <%= product.currency %>
            </div>
            <div style="margin-top:6px;">
              <span style="display:inline-block;background:#fef08a;color:#713f12;font-weight:800;font-size:14px;border-radius:100px;padding:4px 12px;">
                -<%= Math.round((1 - product.effective_price / product.price) * 100) %>% &nbsp;🎷 Promo
              </span>
            </div>
          </div>
        <% } else { %>
          <div class="product-price"><%= product.price.toLocaleString() %> <%= product.currency %></div>
        <% } %>
        <span class="availability-badge <%= product.is_available ? 'in-stock' : 'out-stock' %>">
          <span class="availability-dot"></span>
          <%= product.is_available ? 'En stock' : 'Indisponible' %>
        </span>
      </div>

