  <!-- SSR Data (JSON) -->
  <script id="ssr-product-data" type="application/json">
    <%- JSON.stringify({
      id: product.id,
      name: product.name,
      price: product.price,
      currency: product.currency,
      token: product.share_token
    }) %>
  </script>
  <script id="ssr-custom-message-data" type="application/json">
    <%- JSON.stringify(customMessage || '') %>
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {

      /* ============ LIGHTBOX (zoom) ============ */
      (function initLightbox() {
        const overlay = document.getElementById('lightboxOverlay');
        const img = document.getElementById('lightboxImg');
        const stage = document.getElementById('lightboxStage');
        const closeBtn = document.getElementById('lightboxClose');
        const prevBtn = document.getElementById('lightboxPrev');
        const nextBtn = document.getElementById('lightboxNext');
        if (!overlay || !img) return;

        const zoomables = Array.from(document.querySelectorAll('img[data-zoomable="1"]'));
        if (zoomables.length === 0) return;

        let lbIndex = 0;
        let scale = 1, panX = 0, panY = 0;
        const MIN_SCALE = 1, MAX_SCALE = 4;

        function applyTransform() {
          img.style.transform = 'translate(' + panX + 'px,' + panY + 'px) scale(' + scale + ')';
          img.classList.toggle('zoomed', scale > 1);
        }

        function resetZoom() {
          scale = 1; panX = 0; panY = 0;
          applyTransform();
        }

        function openLightbox(index) {
          lbIndex = index;
          img.src = zoomables[lbIndex].src;
          img.alt = zoomables[lbIndex].alt || '';
          resetZoom();
          overlay.classList.add('open');
          document.body.style.overflow = 'hidden';
          const multi = zoomables.length > 1;
          prevBtn.style.display = multi ? '' : 'none';
          nextBtn.style.display = multi ? '' : 'none';
        }

        function closeLightbox() {
          overlay.classList.remove('open');
          document.body.style.overflow = '';
          resetZoom();
        }

        function showAt(index) {
          if (index < 0) index = zoomables.length - 1;
          if (index >= zoomables.length) index = 0;
          lbIndex = index;
          img.src = zoomables[lbIndex].src;
          resetZoom();
        }

        zoomables.forEach((el, i) => {
          el.addEventListener('click', () => openLightbox(i));
        });

        closeBtn.addEventListener('click', closeLightbox);
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay || e.target === stage) closeLightbox();
        });
        document.addEventListener('keydown', (e) => {
          if (!overlay.classList.contains('open')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowLeft') showAt(lbIndex - 1);
          if (e.key === 'ArrowRight') showAt(lbIndex + 1);
        });
        prevBtn.addEventListener('click', () => showAt(lbIndex - 1));
        nextBtn.addEventListener('click', () => showAt(lbIndex + 1));

        // Clic simple : zoom avant/arrière progressif
        img.addEventListener('click', (e) => {
          e.stopPropagation();
          if (scale === 1) {
            scale = 2.5; applyTransform();
          } else {
            resetZoom();
          }
        });

        // Double-clic desktop : idem, sécurité
        img.addEventListener('dblclick', (e) => {
          e.stopPropagation();
          scale === 1 ? (scale = 2.5) : (scale = 1, panX = 0, panY = 0);
          applyTransform();
        });

        // Molette souris : zoom fin
        stage.addEventListener('wheel', (e) => {
          if (!overlay.classList.contains('open')) return;
          e.preventDefault();
          const delta = e.deltaY < 0 ? 0.25 : -0.25;
          scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale + delta));
          if (scale === 1) { panX = 0; panY = 0; }
          applyTransform();
        }, { passive: false });

        // Glisser pour déplacer quand zoomé (souris/tactile)
        let dragging = false, lastX = 0, lastY = 0;
        img.addEventListener('pointerdown', (e) => {
          if (scale === 1) return;
          dragging = true;
          img.classList.add('dragging');
          lastX = e.clientX; lastY = e.clientY;
          img.setPointerCapture(e.pointerId);
        });
        img.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          panX += e.clientX - lastX;
          panY += e.clientY - lastY;
          lastX = e.clientX; lastY = e.clientY;
          applyTransform();
        });
        img.addEventListener('pointerup', () => { dragging = false; img.classList.remove('dragging'); });
        img.addEventListener('pointerleave', () => { dragging = false; img.classList.remove('dragging'); });

        // Pincer pour zoomer (tactile)
        let pinchStartDist = null, pinchStartScale = 1;
        function touchDist(t) {
          const dx = t[0].clientX - t[1].clientX;
          const dy = t[0].clientY - t[1].clientY;
          return Math.hypot(dx, dy);
        }
        stage.addEventListener('touchstart', (e) => {
          if (e.touches.length === 2) {
            pinchStartDist = touchDist(e.touches);
            pinchStartScale = scale;
          }
        }, { passive: true });
        stage.addEventListener('touchmove', (e) => {
          if (e.touches.length === 2 && pinchStartDist) {
            e.preventDefault();
            const dist = touchDist(e.touches);
            scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, pinchStartScale * (dist / pinchStartDist)));
            if (scale === 1) { panX = 0; panY = 0; }
            applyTransform();
          }
        }, { passive: false });
        stage.addEventListener('touchend', () => { pinchStartDist = null; });
      })();

      /* ============ CAROUSEL + DÉFILEMENT AUTOMATIQUE ============ */
      const track = document.getElementById('galleryTrack');
      if (!track) return; // pas de galerie (image unique ou placeholder)

      const slides = Array.from(track.children);
      const dots = Array.from(document.querySelectorAll('#galleryDots .gallery-dot'));
      const thumbs = Array.from(document.querySelectorAll('#galleryThumbs .gallery-thumb'));
      const prevBtn = document.getElementById('galleryPrev');
      const nextBtn = document.getElementById('galleryNext');
      const galleryMain = document.getElementById('galleryMain');
      let current = 0;

      const AUTOPLAY_DELAY = 4000; // ms entre chaque slide
      const RESUME_DELAY = 6000;   // ms avant reprise après interaction
      let autoplayTimer = null;
      let resumeTimer = null;

      // Pause les vidéos qui ne sont plus visibles
      function pauseAllVideos() {
        slides.forEach(slide => {
          const video = slide.querySelector('video');
          if (video) video.pause();
        });
      }

      function goTo(index) {
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
        current = index;
        track.style.transform = 'translateX(-' + (current * 100) + '%)';

        dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
        thumbs.forEach((thumb, i) => thumb.classList.toggle('active', i === current));

        const activeThumb = thumbs[current];
        if (activeThumb) {
          activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        pauseAllVideos();
      }

      function startAutoplay() {
        if (slides.length <= 1) return;
        stopAutoplay();
        autoplayTimer = setInterval(() => {
          // Ne pas avancer automatiquement si une vidéo est en cours de lecture
          const currentVideo = slides[current].querySelector('video');
          if (currentVideo && !currentVideo.paused) return;
          goTo(current + 1);
        }, AUTOPLAY_DELAY);
      }

      function stopAutoplay() {
        if (autoplayTimer) { clearInterval(autoplayTimer); autoplayTimer = null; }
      }

      // Interaction utilisateur : on met en pause puis on reprend après un délai
      function handleUserInteraction() {
        stopAutoplay();
        if (resumeTimer) clearTimeout(resumeTimer);
        resumeTimer = setTimeout(startAutoplay, RESUME_DELAY);
      }

      if (prevBtn) prevBtn.addEventListener('click', () => { goTo(current - 1); handleUserInteraction(); });
      if (nextBtn) nextBtn.addEventListener('click', () => { goTo(current + 1); handleUserInteraction(); });

      dots.forEach(dot => {
        dot.addEventListener('click', () => { goTo(parseInt(dot.dataset.index, 10)); handleUserInteraction(); });
      });
      thumbs.forEach(thumb => {
        thumb.addEventListener('click', () => { goTo(parseInt(thumb.dataset.index, 10)); handleUserInteraction(); });
      });

      // Navigation au clavier (flèches gauche/droite)
      if (galleryMain) {
        galleryMain.setAttribute('tabindex', '0');
        galleryMain.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') { goTo(current - 1); handleUserInteraction(); }
          if (e.key === 'ArrowRight') { goTo(current + 1); handleUserInteraction(); }
        });
        // Pause au survol (desktop), reprend à la sortie
        galleryMain.addEventListener('mouseenter', stopAutoplay);
        galleryMain.addEventListener('mouseleave', startAutoplay);
      }

      // Swipe tactile / souris
      let startX = 0;
      let isDragging = false;
      const swipeThreshold = 40;

      track.addEventListener('pointerdown', (e) => {
        if (e.target.closest('video')) return; // laisse les contrôles natifs de la vidéo fonctionner
        isDragging = true;
        startX = e.clientX;
        track.style.transition = 'none';
        stopAutoplay();
      });
      track.addEventListener('pointerup', (e) => {
        if (!isDragging) return;
        isDragging = false;
        track.style.transition = '';
        const diff = e.clientX - startX;
        if (diff > swipeThreshold) goTo(current - 1);
        else if (diff < -swipeThreshold) goTo(current + 1);
        else goTo(current);
        handleUserInteraction();
      });
      track.addEventListener('pointerleave', () => {
        if (isDragging) {
          isDragging = false;
          track.style.transition = '';
          goTo(current);
          handleUserInteraction();
        }
      });

      // Vidéos : ne pas changer de slide pendant la lecture, et reprendre l'autoplay à la pause/fin
      slides.forEach(slide => {
        const video = slide.querySelector('video');
        if (!video) return;
        video.addEventListener('play', stopAutoplay);
        video.addEventListener('pause', handleUserInteraction);
        video.addEventListener('ended', handleUserInteraction);
      });

      // Pause l'autoplay si l'onglet n'est plus visible
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });

      goTo(0);
      startAutoplay();
    });
  </script>
  <script src="/js/public-product.js"></script>

</body>
</html>
