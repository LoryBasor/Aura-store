<!-- views/admin/reports.ejs -->
<div class="dashboard-header">
  <div class="header-content">
    <h2>Signalements</h2>
    <p class="subtitle">Modération des boutiques et produits signalés.</p>
  </div>
</div>

<div class="filters-section" style="background: white; padding: 16px; border-radius: 12px; margin-bottom: 24px; border: 1px solid var(--border, #eee); display: flex; gap: 16px; align-items: center;">
  <form method="GET" action="/admin/reports" style="display: flex; gap: 12px; align-items: center;">
    <select name="type" class="form-select" style="padding: 8px; border-radius: 6px; border: 1px solid #ddd;" onchange="this.form.submit()">
      <option value="product" <%= currentType === 'product' ? 'selected' : '' %>>Produits signalés</option>
      <option value="store" <%= currentType === 'store' ? 'selected' : '' %>>Boutiques signalées</option>
    </select>
    <select name="status" class="form-select" style="padding: 8px; border-radius: 6px; border: 1px solid #ddd;" onchange="this.form.submit()">
      <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>Tous les statuts</option>
      <option value="pending" <%= currentStatus === 'pending' ? 'selected' : '' %>>En attente</option>
      <option value="resolved" <%= currentStatus === 'resolved' ? 'selected' : '' %>>Résolus</option>
      <option value="dismissed" <%= currentStatus === 'dismissed' ? 'selected' : '' %>>Ignorés</option>
    </select>
  </form>
</div>

<div class="card" style="background: white; border-radius: 12px; border: 1px solid var(--border, #eee); overflow: hidden;">
  <table class="table" style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead style="background: #f8fafc; border-bottom: 1px solid var(--border, #eee);">
      <tr>
        <th style="padding: 12px 16px;">Date</th>
        <th style="padding: 12px 16px;">Raison</th>
        <th style="padding: 12px 16px;">Cible</th>
        <th style="padding: 12px 16px;">Détails</th>
        <th style="padding: 12px 16px;">Statut</th>
        <th style="padding: 12px 16px; text-align: right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!reports || reports.length === 0) { %>
        <tr>
          <td colspan="6" style="padding: 20px; text-align: center; color: #888;">Aucun signalement trouvé.</td>
        </tr>
      <% } else { %>
        <% reports.forEach(item => {
          const date = new Date(item.created_at).toLocaleDateString('fr-FR');
          const targetId = currentType === 'product' ? item.product_id : item.store_id;
          const targetName = item.target_name || '#' + targetId;

          let statusBadge = '';
          if(item.status === 'pending')   statusBadge = '<span style="background:#fef3c7;color:#92400e;padding:4px 8px;border-radius:4px;font-size:12px;">En attente</span>';
          if(item.status === 'resolved')  statusBadge = '<span style="background:#dcfce7;color:#166534;padding:4px 8px;border-radius:4px;font-size:12px;">Résolu</span>';
          if(item.status === 'dismissed') statusBadge = '<span style="background:#f1f5f9;color:#475569;padding:4px 8px;border-radius:4px;font-size:12px;">Ignoré</span>';
        %>
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 12px 16px;"><%= date %></td>
            <td style="padding: 12px 16px; font-weight: bold; color: #e74c3c;"><%= item.reason %></td>
            <td style="padding: 12px 16px;"><%= targetName %></td>
            <td style="padding: 12px 16px; max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= item.details || '-' %></td>
            <td style="padding: 12px 16px;"><%- statusBadge %></td>
            <td style="padding: 12px 16px; text-align: right;">
              <% if (item.status === 'pending') { %>
                <button onclick="updateReportStatus('<%= currentType %>', <%= item.id %>, 'resolved')" style="background:#22c55e;color:white;border:none;padding:6px 12px;border-radius:4px;cursor:pointer;margin-right:4px;" title="Résoudre"><svg class="svg-icon svg-icon-fi-rr-check-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></button>
                <button onclick="updateReportStatus('<%= currentType %>', <%= item.id %>, 'dismissed')" style="background:#94a3b8;color:white;border:none;padding:6px 12px;border-radius:4px;cursor:pointer;" title="Ignorer"><svg class="svg-icon svg-icon-fi-rr-cross-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg></button>
              <% } else { %>
                -
              <% } %>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<script src="/js/admin-actions.js"></script>
