<%# ========================================
    views/admin/activity.ejs - WITH PLAN PRICE MANAGEMENT
    ======================================== %>

<%
  function fmtDate(d) { if(!d) return '-'; return new Date(d).toLocaleString('fr-FR'); }
  function fmtCurrency(n) { return (parseFloat(n)||0).toLocaleString('fr-FR') + ' FCFA'; }
  
  const stats = globalStats || {};
  const vendors = recentVendors || [];
  const orders = recentOrders || [];
  const logs = activityLogs || [];
  const currentPlans = plans || [];
%>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title"><svg class="svg-icon svg-icon-fi-rr-chart-histogram" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg> Activité de la Plateforme</h1>
    <p class="page-subtitle">Monitoring global en temps réel</p>
  </div>
  <div class="page-header-actions">
    <button class="btn btn-secondary" onclick="location.reload()"><svg class="svg-icon svg-icon-fi-rr-refresh" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg> Actualiser</button>
  </div>
</div>

<!-- Global Stats Row -->
<div class="stats-grid" style="margin-bottom: 24px;">
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Total Vendeurs</span>
      <div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-users" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
    </div>
    <div class="stat-value"><%= stats.total_vendors || 0 %></div>
    <div class="stat-change">+<%= stats.new_vendors_this_month || 0 %> ce mois</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Total Commandes</span>
      <div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-shopping-cart" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg></div>
    </div>
    <div class="stat-value"><%= stats.total_orders || 0 %></div>
    <div class="stat-change">+<%= stats.orders_this_month || 0 %> ce mois</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Chiffre d'Affaires</span>
      <div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-sack-dollar" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 5 7 2h10l-2 3"></path><path d="M7 5c-3 3-4.5 6.5-4.5 9.5A7.5 7.5 0 0 0 10 22h4a7.5 7.5 0 0 0 7.5-7.5c0-3-1.5-6.5-4.5-9.5z"></path><path d="M12 9v7"></path><path d="M14 11a2 2 0 0 0-2-2h0a2 2 0 0 0 0 4h0a2 2 0 0 1 0 4h0a2 2 0 0 1-2-2"></path></svg></div>
    </div>
    <div class="stat-value"><%= fmtCurrency(stats.total_revenue) %></div>
    <div class="stat-change"><%= fmtCurrency(stats.revenue_this_month) %> ce mois</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Total Produits</span>
      <div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-box" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 8v13H3V8"></path><path d="M1 3h22v5H1z"></path><line x1="10" y1="12" x2="14" y2="12"></line></svg></div>
    </div>
    <div class="stat-value"><%= stats.total_products || 0 %></div>
    <div class="stat-change"><%= stats.active_products || 0 %> actifs</div>
  </div>
</div>

<!-- Charts Row -->
<div class="grid-auto-fit-400">
  <div class="card">
    <div class="card-header"><h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-stats-up" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg> Évolution (30 jours)</h3></div>
    <div class="chart-container"><canvas id="evolutionChart" style="max-height: 300px;"></canvas></div>
  </div>
  <div class="card">
    <div class="card-header"><h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-sack-dollar" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 5 7 2h10l-2 3"></path><path d="M7 5c-3 3-4.5 6.5-4.5 9.5A7.5 7.5 0 0 0 10 22h4a7.5 7.5 0 0 0 7.5-7.5c0-3-1.5-6.5-4.5-9.5z"></path><path d="M12 9v7"></path><path d="M14 11a2 2 0 0 0-2-2h0a2 2 0 0 0 0 4h0a2 2 0 0 1 0 4h0a2 2 0 0 1-2-2"></path></svg> Revenus (30 jours)</h3></div>
    <div class="chart-container"><canvas id="revenueChart" style="max-height: 300px;"></canvas></div>
  </div>
</div>

<!-- Plan Pricing Section -->
<div class="card" style="margin-bottom: 24px; border-left: 5px solid var(--color-primary);">
  <div class="card-header">
    <h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-label" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20.59 13.41 12 22l-9-9V4a2 2 0 0 1 2-2h8.59a2 2 0 0 1 1.41.59l7 7a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>️ Gestion des Tarifs d'Abonnement</h3>
  </div>
  <div class="table-container">
    <table class="table">
      <thead>
        <tr><th>Plan</th><th>Cycle</th><th>Prix Actuel</th><th>Statut</th><th>Action</th></tr>
      </thead>
      <tbody>
        <% currentPlans.forEach(plan => { %>
          <tr>
            <td><strong><%= plan.name %></strong></td>
            <td><%= plan.billing_cycle %></td>
            <td><strong style="color:var(--color-primary);"><%= fmtCurrency(plan.price) %></strong></td>
            <td><span class="badge <%= plan.is_active ? 'badge-success' : 'badge-danger' %>"><%= plan.is_active ? 'Actif' : 'Inactif' %></span></td>
            <td>
              <button class="btn btn-sm btn-primary" onclick="openEditPrice('<%= plan.id %>', '<%= plan.name %>', '<%= plan.price %>')">
                <svg class="svg-icon svg-icon-fi-rr-pencil" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>️ Modifier Prix
              </button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- Activity Lists -->
<div class="grid-2col">
  <div class="card">
    <div class="card-header"><h3 class="card-title">🆕 Nouvelles inscriptions</h3></div>
    <div class="table-container">
      <table class="table">
        <thead><tr><th>Vendeur</th><th>Date</th><th>Statut</th></tr></thead>
        <tbody>
          <% if (vendors.length === 0) { %>
            <tr><td colspan="3" style="text-align:center; padding:20px;">Aucune inscription récente</td></tr>
          <% } else { %>
            <% vendors.forEach(v => { %>
              <tr>
                <td><strong><%= v.business_name %></strong><br><small><%= v.email %></small></td>
                <td><%= fmtDate(v.created_at) %></td>
                <td><span class="badge badge-info"><%= v.account_status %></span></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-shopping-cart" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg> Dernières commandes</h3></div>
    <div class="table-container">
      <table class="table">
        <thead><tr><th>N°</th><th>Vendeur</th><th>Montant</th><th>Statut</th></tr></thead>
        <tbody>
          <% if (orders.length === 0) { %>
            <tr><td colspan="4" style="text-align:center; padding:20px;">Aucune commande récente</td></tr>
          <% } else { %>
            <% orders.forEach(o => { %>
              <tr>
                <td><strong>#<%= o.order_number %></strong></td>
                <td><%= o.vendor_name %></td>
                <td><%= fmtCurrency(o.total_amount) %></td>
                <td><span class="badge badge-success"><%= o.status %></span></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Admin Audit Logs -->
<div class="card" style="margin-bottom: 24px;">
  <div class="card-header"><h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-document" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg> Journal d'audit Admin</h3></div>
  <div class="table-container" style="max-height: 400px; overflow-y: auto;">
    <table class="table">
      <thead style="position:sticky; top:0; z-index:10; background:var(--color-surface);">
        <tr><th>Action</th><th>Entité</th><th>Admin</th><th>Date</th><th>Notes</th></tr>
      </thead>
      <tbody>
        <% if (logs.length === 0) { %>
          <tr><td colspan="5" style="text-align:center; padding:20px;">Aucun log d'audit trouvé</td></tr>
        <% } else { %>
          <% logs.forEach(log => { %>
            <tr>
              <td><span class="badge badge-info"><%= log.action %></span></td>
              <td><%= log.entity_type %> (#<%= log.entity_id %>)</td>
              <td><%= log.admin_name %><br><small><%= log.admin_email %></small></td>
              <td><%= fmtDate(log.created_at) %></td>
              <td><small><%= log.notes || '-' %></small></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal Edit Price -->
<div class="modal-overlay" id="editPriceModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title"><svg class="svg-icon svg-icon-fi-rr-sack-dollar" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M9 5 7 2h10l-2 3"></path><path d="M7 5c-3 3-4.5 6.5-4.5 9.5A7.5 7.5 0 0 0 10 22h4a7.5 7.5 0 0 0 7.5-7.5c0-3-1.5-6.5-4.5-9.5z"></path><path d="M12 9v7"></path><path d="M14 11a2 2 0 0 0-2-2h0a2 2 0 0 0 0 4h0a2 2 0 0 1 0 4h0a2 2 0 0 1-2-2"></path></svg> Modifier le prix</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="editPriceForm">
      <div class="modal-body">
        <input type="hidden" id="editPlanId">
        <p id="editPlanName" style="font-weight:700; margin-bottom:16px;"></p>
        <div class="form-group">
          <label class="form-label">Nouveau prix (FCFA)</label>
          <input type="number" id="newPlanPrice" class="form-select" required min="0">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<style>
  .table { width: 100%; border-collapse: collapse; }
  .table th, .table td { padding: 12px; text-align: left; font-size: 13px; border-bottom: 1px solid var(--color-border); }
  .table th { font-weight: 700; color: var(--color-secondary); text-transform: uppercase; font-size: 11px; }
  .table-container { background: white; border-radius: var(--radius-md); overflow: hidden; }
  .badge-danger { background: rgba(244, 67, 54, 0.1); color: #f44336; }
</style>

<!-- Injection SSR des données pour les graphiques -->
<script id="ssr-activity-data" type="application/json">
  <%- JSON.stringify(trends || {}) %>
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/admin/activity.js"></script>