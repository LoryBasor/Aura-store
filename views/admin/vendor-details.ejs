<%
  const v = vendor.user;
  const s = vendor.stats;
  const ro = vendor.recent_orders || [];
  function fmtCurrency(n) { return (parseFloat(n)||0).toLocaleString('fr-FR') + ' FCFA'; }
  function fmtDate(d) { if(!d) return '-'; return new Date(d).toLocaleDateString('fr-FR'); }
%>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title" id="vendorName"><%= v.business_name %></h1>
    <p class="page-subtitle" id="vendorEmail"><%= v.email %> • Inscrit le <%= fmtDate(v.created_at) %></p>
  </div>
  <div class="page-header-actions">
    <% if (v.whatsapp_number || v.phone) { 
        const waNum = (v.whatsapp_number || v.phone).replace(/\D/g, '');
        const finalWaNum = waNum.length <= 9 ? '237' + waNum : waNum;
    %>
      <a href="https://wa.me/<%= finalWaNum %>" target="_blank" class="btn btn-success" style="color: aqua;" >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="color: aqua;">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        WhatsApp</a>
    <% } %>
    <a href="/admin/vendors" class="btn btn-secondary">← Retour</a>
    <a href="/admin/subscriptions/<%= v.id %>" class="btn btn-primary"><svg class="svg-icon svg-icon-fi-rr-clipboard" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg> Gérer l'abonnement</a>
  </div>
</div>

<div class="grid-1fr-2fr vendor-detail-grid">
  <!-- Info Card -->
  <div class="card">
    <div class="card-header"><h3 class="card-title">ℹ️ Informations</h3></div>
    <div style="padding: 20px;">
      <div style="margin-bottom: 16px;">
        <label style="display:block; font-size:12px; color:var(--color-secondary); text-transform:uppercase;">Statut Compte</label>
        <span class="badge badge-<%= v.account_status === 'active' ? 'success' : 'error' %>"><%= v.account_status %></span>
      </div>
      <div style="margin-bottom: 16px;">
        <label style="display:block; font-size:12px; color:var(--color-secondary); text-transform:uppercase;">Téléphone</label>
        <div style="font-weight:600;"><%= v.phone || '-' %></div>
      </div>
      <div style="margin-bottom: 16px;">
        <label style="display:block; font-size:12px; color:var(--color-secondary); text-transform:uppercase;">WhatsApp</label>
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <div style="font-weight:600;"><%= v.whatsapp_number || '-' %></div>
          <% if (v.whatsapp_number || v.phone) { 
              const waNum = (v.whatsapp_number || v.phone).replace(/\D/g, '');
              const finalWaNum = waNum.length <= 9 ? '237' + waNum : waNum;
          %>
            <a href="https://wa.me/<%= finalWaNum %>" target="_blank" title="Contacter sur WhatsApp" style="text-decoration:none; font-size:18px;"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="color: aqua;">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg></a>
          <% } %>
        </div>
      </div>
      <div style="margin-bottom: 16px;">
        <label style="display:block; font-size:12px; color:var(--color-secondary); text-transform:uppercase;">Localisation</label>
        <div style="font-weight:600;"><%= [v.city, v.country].filter(Boolean).join(', ') || '-' %></div>
      </div>
      <div>
        <label style="display:block; font-size:12px; color:var(--color-secondary); text-transform:uppercase;">Plan Actuel</label>
        <div style="font-weight:600;"><span class="badge badge-info"><%= v.plan_name || 'Gratuit' %></span></div>
      </div>
    </div>
  </div>

  <!-- Stats Grid -->
  <div style="display: flex; flex-direction: column; gap: 24px;">
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-header"><span class="stat-label">Produits</span></div>
        <div class="stat-value"><%= s.total_products %></div>
      </div>
      <div class="stat-card">
        <div class="stat-header"><span class="stat-label">Commandes</span></div>
        <div class="stat-value"><%= s.total_orders %></div>
      </div>
      <div class="stat-card">
        <div class="stat-header"><span class="stat-label">CA Global</span></div>
        <div class="stat-value" style="font-size: 20px;"><%= fmtCurrency(s.total_revenue) %></div>
      </div>
      <div class="stat-card">
        <div class="stat-header"><span class="stat-label">Clients</span></div>
        <div class="stat-value"><%= s.total_customers %></div>
      </div>
    </div>

    <!-- Recent Orders -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-box" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 8v13H3V8"></path><path d="M1 3h22v5H1z"></path><line x1="10" y1="12" x2="14" y2="12"></line></svg> Commandes récentes</h3>
      </div>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr><th>Numéro</th><th>Client</th><th>Montant</th><th>Statut</th><th>Date</th></tr>
          </thead>
          <tbody>
            <% if (ro.length === 0) { %>
              <tr><td colspan="5" style="text-align:center; padding:20px;">Aucune commande</td></tr>
            <% } else { %>
              <% ro.forEach(o => { %>
                <tr>
                  <td><strong><%= o.order_number %></strong></td>
                  <td><%= o.customer_name %></td>
                  <td><%= fmtCurrency(o.total_amount) %></td>
                  <td><span class="badge badge-info"><%= o.status %></span></td>
                  <td><%= fmtDate(o.created_at) %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Catalogue Produits -->
    <div class="card">
      <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
        <h3 class="card-title"><svg class="svg-icon svg-icon-fi-rr-shopping-bag" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>️ Catalogue Produits</h3>
        <div style="display:flex; gap:12px;">
          <svg class="svg-icon svg-icon-fi-rr-search" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><input type="text" id="productSearch" class="form-input" placeholder=" Rechercher..." style="width:200px; padding:6px 12px; margin:0;">
          <select id="statusFilter" class="form-input" style="width:150px; padding:6px 12px; margin:0;">
            <option value="all">Tous les statuts</option>
            <option value="available">Disponible</option>
            <option value="disabled">Désactivé (Admin)</option>
          </select>
        </div>
      </div>
      <div class="table-container">
        <table class="table" id="productsTable">
          <thead>
            <tr>
              <th>Produit</th>
              <th>Catégorie</th>
              <th>Prix</th>
              <th>Stock</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (vendor.products && vendor.products.length > 0) { %>
              <% vendor.products.forEach(p => { %>
                <tr data-name="<%= p.name.toLowerCase() %>" data-status="<%= p.admin_disabled ? 'disabled' : 'available' %>">
                  <td style="display:flex; align-items:center; gap:12px;">
                    <% if (p.image_url) { %>
                      <img src="<%= p.image_url %>" style="width:40px; height:40px; border-radius:8px; object-fit:cover;">
                    <% } else { %>
                      <div style="width:40px; height:40px; border-radius:8px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; font-size:20px;"><svg class="svg-icon svg-icon-fi-rr-box" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 8v13H3V8"></path><path d="M1 3h22v5H1z"></path><line x1="10" y1="12" x2="14" y2="12"></line></svg></div>
                    <% } %>
                    <div>
                      <div style="font-weight:600;"><%= p.name %></div>
                      <div style="font-size:11px; color:var(--color-tertiary);">ID: <%= p.id %></div>
                    </div>
                  </td>
                  <td><span class="badge badge-info"><%= p.category_name || '-' %></span></td>
                  <td><strong><%= fmtCurrency(p.price) %></strong></td>
                  <td><%= p.stock_quantity %></td>
                  <td>
                    <% if (p.admin_disabled) { %>
                      <span class="badge badge-error">Indisponible (Admin)</span>
                    <% } else { %>
                      <span class="badge badge-<%= p.is_available ? 'success' : 'warning' %>">
                        <%= p.is_available ? 'Disponible' : 'Masqué (Vendeur)' %>
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <div style="display:flex; gap:8px;">
                      <button class="btn-icon <%= p.admin_disabled ? 'btn-success' : 'btn-warning' %>" 
                              onclick="toggleProductStatus(<%= p.id %>, <%= p.admin_disabled %>)"
                              title="<%= p.admin_disabled ? 'Réactiver' : 'Rendre indisponible' %>">
                        <%- p.admin_disabled ? '<svg class="svg-icon svg-icon-fi-rr-lock-open-alt" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>' : '<svg class="svg-icon svg-icon-fi-rr-lock" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>' %>
                      </button>
                      <button class="btn-icon btn-error" onclick="deleteProduct(<%= p.id %>)" title="Supprimer"><svg class="svg-icon svg-icon-fi-rr-trash" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>️</button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="6" style="text-align:center; padding:40px;">Aucun produit dans le catalogue</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="/js/admin/vendor-details.js"></script>