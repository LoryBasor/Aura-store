<%# ========================================
    views/admin/vendors.ejs - SSR VERSION
    ======================================== %>

<%
  function fmtDate(d) { if(!d) return '-'; return new Date(d).toLocaleDateString('fr-FR'); }
  const currentVendors    = vendors    || [];
  const currentPagination = pagination || { page:1, limit:20, total:0 };
  const currentFilters    = filters    || {};
  const totalPages        = Math.ceil(currentPagination.total / currentPagination.limit);
%>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title"><svg class="svg-icon svg-icon-fi-rr-users" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> Gestion des vendeurs</h1>
    <p class="page-subtitle">Administrez tous les comptes vendeurs (<%= currentPagination.total %> au total)</p>
  </div>
  <button class="btn btn-secondary" id="exportBtn"><svg class="svg-icon svg-icon-fi-rr-chart-histogram" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg> Exporter CSV</button>
</div>

<!-- Filters -->
<div class="card" style="margin-bottom:24px;">
  <form method="GET" action="/admin/vendors" class="filter-bar">
    <input type="search" name="search" id="searchInput" class="form-input"
           placeholder="Rechercher par nom, email ou téléphone..." value="<%= currentFilters.search || '' %>">
    <select name="status" id="statusFilter" class="form-select" onchange="this.form.submit()">
      <option value="" <%= !currentFilters.status ? 'selected' : '' %>>Tous les statuts</option>
      <option value="active"      <%= currentFilters.status === 'active'      ? 'selected' : '' %>>Actifs</option>
      <option value="suspended"   <%= currentFilters.status === 'suspended'   ? 'selected' : '' %>>Suspendus</option>
      <option value="deactivated" <%= currentFilters.status === 'deactivated' ? 'selected' : '' %>>Désactivés</option>
    </select>
    <button type="submit" class="btn btn-primary" id="searchBtn"><svg class="svg-icon svg-icon-fi-rr-search" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Rechercher</button>
  </form>
</div>

<!-- Vendors Table -->
<div class="card" style="padding: 0; overflow: hidden;">
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>Vendeur</th>
          <th>Contact</th>
          <th>Abonnement</th>
          <th>Produits</th>
          <th>Commandes</th>
          <th>CA Total</th>
          <th>Vérifié</th>
          <th>Statut</th>
          <th>Inscription</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="vendorsTableBody">
        <% if (currentVendors.length === 0) { %>
          <tr>
            <td colspan="10" style="text-align:center;padding:48px;">
              <div style="font-size:48px;margin-bottom:16px;"><svg class="svg-icon svg-icon-fi-rr-user" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
              <p style="color:var(--color-secondary);">Aucun vendeur trouvé</p>
            </td>
          </tr>
        <% } else { %>
          <% currentVendors.forEach(vendor => { %>
            <tr>
              <td data-label="Vendeur">
                <div style="display:flex;align-items:center;gap:12px;">
                  <div style="width:40px;height:40px;border-radius:50%;background:var(--color-primary);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:16px;">
                    <%= vendor.business_name ? vendor.business_name.charAt(0).toUpperCase() : 'V' %>
                  </div>
                  <div>
                    <div style="font-weight:700;"><%= vendor.business_name %></div>
                    <div style="font-size:12px;color:var(--color-secondary);">/<%= vendor.store_slug %></div>
                  </div>
                </div>
              </td>
              <td data-label="Contact">
                <div><%= vendor.email %></div>
                <div style="font-size:12px;color:var(--color-secondary);"><%= vendor.phone || '-' %></div>
              </td>
              <td data-label="Abonnement"><span class="badge badge-info"><%= vendor.plan_name || 'Gratuit' %></span></td>
              <td data-label="Produits"><%= vendor.product_count || 0 %></td>
              <td data-label="Commandes"><%= vendor.order_count || 0 %></td>
              <td data-label="CA Total"><%= (parseFloat(vendor.total_revenue)||0).toLocaleString('fr-FR') %> FCFA</td>
              <td data-label="Vérifié">
                <button class="btn btn-sm btn-<%= vendor.is_verified ? 'success' : 'outline' %>" 
                        data-action="toggle-verify" 
                        data-vendor-id="<%= vendor.id %>" 
                        data-current="<%= vendor.is_verified %>"
                        title="<%= vendor.is_verified ? 'Retirer la vérification' : 'Marquer comme vérifié' %>">
                  <%- vendor.is_verified ? '<svg class="svg-icon svg-icon-fi-rr-check-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Vérifié' : '<svg class="svg-icon svg-icon-fi-rr-square" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg> Vérifier' %>
                </button>
              </td>
              <td data-label="Statut">
                <span class="badge badge-<%= vendor.account_status === 'active' ? 'success' : vendor.account_status === 'suspended' ? 'warning' : 'error' %>">
                  <%= vendor.account_status %>
                </span>
              </td>
              <td data-label="Inscription"><%= fmtDate(vendor.created_at) %></td>
              <td data-label="Actions">
                <div style="display:flex;gap:6px;">
                  <a href="/admin/vendors/<%= vendor.id %>" class="btn btn-secondary btn-sm"><svg class="svg-icon svg-icon-fi-rr-eye" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg> Détails</a>
                  <button class="btn btn-outline btn-sm" data-action="vendor-actions" data-vendor-id="<%= vendor.id %>"><svg class="svg-icon svg-icon-fi-rr-settings" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>️</button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination SSR -->
<% if (totalPages > 1) { %>
<div id="pagination" class="flex-center" style="margin-top:24px;gap:8px;">
  <% if (currentPagination.page > 1) { %>
    <a href="/admin/vendors?page=<%= currentPagination.page - 1 %>&search=<%= currentFilters.search || '' %>&status=<%= currentFilters.status || '' %>"
       class="btn btn-secondary btn-sm">← Précédent</a>
  <% } %>
  <span style="padding:8px 16px;color:var(--color-secondary);font-size:13px;">
    Page <%= currentPagination.page %> / <%= totalPages %> (<%= currentPagination.total %> vendeurs)
  </span>
  <% if (currentPagination.page < totalPages) { %>
    <a href="/admin/vendors?page=<%= currentPagination.page + 1 %>&search=<%= currentFilters.search || '' %>&status=<%= currentFilters.status || '' %>"
       class="btn btn-secondary btn-sm">Suivant →</a>
  <% } %>
</div>
<% } %>

<!-- Modals (actions CRUD via API fetch) -->
<div class="modal-overlay" id="vendorActionsModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">Actions vendeur</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <div class="modal-body" id="vendorActionsBody"></div>
  </div>
</div>

<div class="modal-overlay" id="suspendModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title"><svg class="svg-icon svg-icon-fi-rr-ban" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg> Suspendre le vendeur</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="suspendForm">
      <div class="modal-body">
        <input type="hidden" id="suspendUserId">
        <div class="form-group">
          <label for="suspendReason" class="form-label required">Raison de la suspension</label>
          <textarea id="suspendReason" name="reason" class="form-textarea"
                    placeholder="Expliquez la raison de la suspension..." required></textarea>
          <p class="form-help">Cette raison sera visible par le vendeur</p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-danger">Suspendre</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="resetPasswordModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title"><svg class="svg-icon svg-icon-fi-rr-key" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="7.5" cy="16.5" r="4.5"></circle><path d="M10.8 13.2 20 4m0 0h-4m4 0v4m-6.6-1.8 2.4 2.4"></path></svg> Réinitialiser le mot de passe</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="resetPasswordUserId">
      <p style="margin-bottom:16px;color:var(--color-secondary);">Un mot de passe temporaire sera généré et affiché après confirmation.</p>
      <div id="temporaryPasswordDisplay" style="display:none;padding:16px;background:var(--color-accent);border-radius:var(--radius-sm);margin-bottom:16px;">
        <strong style="color:var(--color-primary);">Mot de passe temporaire :</strong>
        <div style="font-size:24px;font-weight:700;color:var(--color-primary);margin:12px 0;font-family:monospace;">
          <span id="temporaryPasswordValue"></span>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" id="copyPasswordBtn"><svg class="svg-icon svg-icon-fi-rr-clipboard" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg> Copier</button>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary modal-close">Annuler</button>
      <button type="button" class="btn btn-primary" id="confirmResetPasswordBtn">Générer le mot de passe</button>
    </div>
  </div>
</div>

</div>

<!-- Inject vendors data for JS (SSR JSON block) -->
<script id="ssr-vendors-data" type="application/json">
  <%- JSON.stringify(currentVendors) %>
</script>
<script src="/js/admin/vendors.js"></script>

<style>
  .table { width: 100%; border-collapse: collapse; min-width: 1000px; }
  .table-container { overflow-x: auto; background: white; border-radius: var(--radius-md); }
  
  .table th, .table td { padding: 16px; text-align: left; vertical-align: middle; }
  .table th { background: var(--color-surface); color: var(--color-primary); font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
  .table tbody tr { border-bottom: 1px solid var(--color-border); transition: background 0.2s; }
  .table tbody tr:hover { background: rgba(37, 99, 235, 0.02); }

  /* Ajustements spécifiques aux colonnes */
  .table td[data-label="Vendeur"] { min-width: 200px; }
  .table td[data-label="Actions"] { white-space: nowrap; width: 150px; }
  .table td[data-label="Vérifié"] { width: 120px; }

  /* Mode Mobile / Tablette */
  @media (max-width: 768px) {
    .table { min-width: unset; }
    .table thead { display: none; }
    .table tr { 
      display: block; 
      margin-bottom: 16px; 
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: white;
      padding: 12px;
    }
    .table td { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      padding: 10px 0;
      border: none;
      text-align: right;
      border-bottom: 1px dashed var(--color-border);
    }
    .table td:last-child { border-bottom: none; }
    .table td::before {
      content: attr(data-label);
      font-weight: 700;
      font-size: 11px;
      color: var(--color-secondary);
      text-transform: uppercase;
      margin-right: 12px;
      text-align: left;
    }
    .table td:first-child { background: var(--color-surface); margin: -12px -12px 12px -12px; padding: 12px; border-radius: var(--radius-md) var(--radius-md) 0 0; border-bottom: 1px solid var(--color-border); }
    .table td .btn { width: 100%; justify-content: center; margin-top: 4px; }
  }

  .w-100 { width: 100%; }

</style>