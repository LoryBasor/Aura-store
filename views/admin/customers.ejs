<!-- Page Header -->
<div class="page-header">
  <h1 class="page-title"><svg class="svg-icon svg-icon-fi-rr-users" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> Mes Clients</h1>
  <p class="page-subtitle">Gérez votre base de clients</p>
</div>

<!-- Stats Clients -->
<div class="stats-grid" style="margin-bottom: 24px;">
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Total Clients</span>
      <div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-users" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
    </div>
    <div class="stat-value" id="totalCustomers">0</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Clients Actifs (30j)</span>
      <div class="stat-icon"><svg class="svg-icon svg-icon-fi-rr-check-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
    </div>
    <div class="stat-value" id="activeCustomers">0</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Nouveau ce mois</span>
      <div class="stat-icon">🆕</div>
    </div>
    <div class="stat-value" id="newCustomers">0</div>
  </div>
</div>

<!-- Filters -->
<div class="card" style="margin-bottom: 24px;">
  <div style="padding: 20px;">
    <input 
      type="search" 
      id="searchInput" 
      class="form-input" 
      placeholder="Rechercher un client par nom ou téléphone..."
      onkeyup="searchCustomers()"
    >
  </div>
</div>

<!-- Table Clients -->
<div class="card">
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Téléphone</th>
          <th>WhatsApp</th>
          <th style="text-align: center;">Commandes</th>
          <th style="text-align: right;">Dépenses Totales</th>
          <th>Dernière Commande</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="customersTableBody">
        <tr>
          <td colspan="7" style="text-align: center; padding: 48px;">
            Chargement...
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script src="/js/admin/customers.js"></script>