<%# ========================================
    views/admin/dashboard.ejs - SSR VERSION
    ======================================== %>

<% 
  function fmtCurrency(n) { return (parseFloat(n)||0).toLocaleString('fr-FR') + ' FCFA'; }
  function fmtDate(d) { if(!d) return '-'; return new Date(d).toLocaleDateString('fr-FR'); }
  const gs = globalStats || {};
  const dist = subDistrib || [];
%>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title">📊 Administration AURA</h1>
    <p class="page-subtitle">Vue globale de la plateforme</p>
  </div>
  <div class="page-header-actions">
    <a href="/admin/dashboard" class="btn btn-secondary">🔄 Actualiser</a>
  </div>
</div>

<!-- Global Stats Grid -->
<div class="stats-grid" id="globalStats">
  <div class="stat-card">
    <div class="stat-header"><span class="stat-label">Total Vendeurs</span><div class="stat-icon">👥</div></div>
    <div class="stat-value"><%= gs.total_vendors || 0 %></div>
    <div class="stat-change positive">+<%= gs.new_vendors_this_month || 0 %> ce mois</div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><span class="stat-label">Total Produits</span><div class="stat-icon">📦</div></div>
    <div class="stat-value"><%= gs.total_products || 0 %></div>
    <div class="stat-change"><%= gs.active_products || 0 %> actifs</div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><span class="stat-label">Total Commandes</span><div class="stat-icon">🛒</div></div>
    <div class="stat-value"><%= gs.total_orders || 0 %></div>
    <div class="stat-change positive">+<%= gs.orders_this_month || 0 %> ce mois</div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><span class="stat-label">Chiffre d'Affaires</span><div class="stat-icon">💰</div></div>
    <div class="stat-value"><%= fmtCurrency(gs.total_revenue || 0) %></div>
    <div class="stat-change positive"><%= fmtCurrency(gs.revenue_this_month || 0) %> ce mois</div>
  </div>
</div>

<!-- Evolution Chart -->
<div class="card" style="margin-bottom: 24px;">
  <div class="card-header"><h3 class="card-title">📈 Évolution de l'Activité (30 jours)</h3></div>
  <div class="chart-container">
    <canvas id="trendsChart" height="80"></canvas>
  </div>
</div>

<!-- Charts & Stats -->
<div class="grid-2fr-1fr">
  <!-- Conversion -->
  <div class="card">
    <div class="card-header"><h3 class="card-title">📈 Taux de Conversion</h3></div>
    <div id="conversionStats" style="padding:24px;">
      <% const cr = conversionRate || {}; %>
      <div class="grid-3col">
        <div style="text-align:center;padding:16px;background:var(--color-surface);border-radius:var(--radius-sm);">
          <div style="font-size:28px;font-weight:700;color:var(--color-primary);"><%= cr.total_views || 0 %></div>
          <div style="font-size:13px;color:var(--color-secondary);">Vues produits</div>
        </div>
        <div style="text-align:center;padding:16px;background:var(--color-surface);border-radius:var(--radius-sm);">
          <div style="font-size:28px;font-weight:700;color:var(--color-primary);"><%= cr.total_orders || 0 %></div>
          <div style="font-size:13px;color:var(--color-secondary);">Commandes</div>
        </div>
        <div style="text-align:center;padding:16px;background:var(--color-surface);border-radius:var(--radius-sm);">
          <div style="font-size:28px;font-weight:700;color:var(--color-primary);"><%= cr.conversion_rate || 0 %>%</div>
          <div style="font-size:13px;color:var(--color-secondary);">Taux conversion</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Distribution Abonnements -->
  <div class="card">
    <div class="card-header"><h3 class="card-title">📊 Répartition Abonnements</h3></div>
    <div id="subscriptionDistribution" style="padding:24px;">
      <% if (dist.length === 0) { %>
        <p style="color:var(--color-secondary);text-align:center;">Aucune donnée</p>
      <% } else { %>
        <% dist.forEach(d => { %>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <span style="font-weight:600;"><%= d.plan_name || d.name %></span>
            <span class="badge badge-info"><%= d.count %> vendeurs</span>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<!-- Tables Row -->
<div class="grid-2col">
  <!-- Top Vendors -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">🏆 Top Vendeurs</h3>
      <a href="/admin/vendors" class="card-action">Voir tout →</a>
    </div>
    <div id="topVendors">
      <% if (!topVendors || topVendors.length === 0) { %>
        <div style="padding:24px;text-align:center;color:var(--color-secondary);">Aucun vendeur</div>
      <% } else { %>
        <div class="table-container">
          <table class="table table-cards">
            <thead>
              <tr><th>Boutique</th><th>Commandes</th><th>CA</th></tr>
            </thead>
            <tbody>
              <% topVendors.slice(0, 5).forEach(v => { %>
                <tr>
                  <td>
                    <strong><%= v.business_name %></strong>
                    <div style="font-size:12px;color:var(--color-secondary);"><%= v.email %></div>
                  </td>
                  <td><%= v.total_orders || 0 %></td>
                  <td><%= fmtCurrency(v.total_revenue || 0) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="card">
    <div class="card-header"><h3 class="card-title">🕐 Vendeurs récents</h3></div>
    <div id="recentActivity">
      <% if (!recentVendors || recentVendors.length === 0) { %>
        <div style="padding:24px;text-align:center;color:var(--color-secondary);">Aucun vendeur récent</div>
      <% } else { %>
        <div style="padding:16px;display:flex;flex-direction:column;gap:12px;">
          <% recentVendors.slice(0, 5).forEach(v => { %>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;background:var(--color-surface);border-radius:var(--radius-sm);">
              <div>
                <strong style="font-size:14px;"><%= v.business_name %></strong>
                <div style="font-size:12px;color:var(--color-secondary);"><%= v.email %></div>
              </div>
              <div style="text-align:right;">
                <div style="font-size:12px;color:var(--color-tertiary);"><%= fmtDate(v.created_at) %></div>
                <span class="badge badge-<%= v.account_status === 'active' ? 'success' : 'error' %>" style="font-size:10px;"><%= v.account_status %></span>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Inject data for optional JS interactions -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  window.__SSR_ADMIN_STATS__ = <%- JSON.stringify({ globalStats: gs, topVendors: topVendors || [], subDistrib: dist }) %>;
  window.__SSR_ADMIN_TRENDS__ = <%- JSON.stringify(typeof trends !== 'undefined' ? trends : {}) %>;

  document.addEventListener('DOMContentLoaded', () => {
    const ctx = document.getElementById('trendsChart')?.getContext('2d');
    if (!ctx || !window.__SSR_ADMIN_TRENDS__.orders) return;

    const data = window.__SSR_ADMIN_TRENDS__.orders;
    const labels = data.map(d => new Date(d.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }));
    
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Commandes',
            data: data.map(d => d.count),
            borderColor: '#2563eb',
            backgroundColor: 'rgba(37, 99, 235, 0.1)',
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            yAxisID: 'y'
          },
          {
            label: 'Revenu (FCFA)',
            data: data.map(d => d.revenue),
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.1)',
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'top' },
          tooltip: { mode: 'index', intersect: false }
        },
        scales: {
          y: {
            type: 'linear',
            display: true,
            position: 'left',
            title: { display: true, text: 'Nb. Commandes' },
            grid: { drawOnChartArea: false }
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',
            title: { display: true, text: 'Revenu (FCFA)' },
            ticks: { callback: value => value.toLocaleString() }
          }
        }
      }
    });
  });
</script>
<script src="/js/admin/dashboard.js"></script>