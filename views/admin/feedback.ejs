<!-- views/admin/feedback.ejs -->
<div class="dashboard-header">
  <div class="header-content">
    <h2>Avis Utilisateurs</h2>
    <p class="subtitle">Gérez les retours et suggestions concernant Aura Store.</p>
  </div>
</div>

<div class="filters-section" style="background: white; padding: 16px; border-radius: 12px; margin-bottom: 24px; border: 1px solid var(--border, #eee); display: flex; gap: 16px; align-items: center;">
  <form method="GET" action="/admin/feedback" style="display: flex; gap: 12px; align-items: center;">
    <select name="status" class="form-select" style="padding: 8px; border-radius: 6px; border: 1px solid #ddd;" onchange="this.form.submit()">
      <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>Tous les statuts</option>
      <option value="pending" <%= currentStatus === 'pending' ? 'selected' : '' %>>En attente</option>
      <option value="processed" <%= currentStatus === 'processed' ? 'selected' : '' %>>Traités</option>
    </select>
    <noscript><button type="submit" class="btn btn-secondary" style="padding: 8px 12px;">Filtrer</button></noscript>
  </form>
</div>

<div class="card" style="background: white; border-radius: 12px; border: 1px solid var(--border, #eee); overflow: hidden;">
  <table class="table" style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead style="background: #f8fafc; border-bottom: 1px solid var(--border, #eee);">
      <tr>
        <th style="padding: 12px 16px;">Date</th>
        <th style="padding: 12px 16px;">Utilisateur</th>
        <th style="padding: 12px 16px;">Note</th>
        <th style="padding: 12px 16px;">Commentaire</th>
        <th style="padding: 12px 16px;">Statut</th>
        <th style="padding: 12px 16px; text-align: right;">Actions</th>
      </tr>
    </thead>
    <tbody id="feedbackTableBody">
      <% if (!feedbacks || feedbacks.length === 0) { %>
        <tr><td colspan="6" style="padding: 20px; text-align: center; color: #888;">Aucun avis trouvé.</td></tr>
      <% } else { %>
        <% feedbacks.forEach(item => { 
          const date = new Date(item.created_at).toLocaleDateString('fr-FR');
          const stars = '<svg class="svg-icon svg-icon-fi-ss-star" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>'.repeat(item.rating) + '<svg class="svg-icon svg-icon-fi-rr-star" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>'.repeat(5 - item.rating);
          const userType = item.user_id ? 'Vendeur' : 'Visiteur';
          
          let statusBadge = '';
          if(!item.is_processed) statusBadge = '<span style="background:#fef3c7; color:#92400e; padding:4px 8px; border-radius:4px; font-size:12px;">En attente</span>';
          if(item.is_processed) statusBadge = '<span style="background:#dcfce7; color:#166534; padding:4px 8px; border-radius:4px; font-size:12px;">Traité</span>';
        %>
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 12px 16px;"><%= date %></td>
            <td style="padding: 12px 16px;"><%= userType %></td>
            <td style="padding: 12px 16px; color: #f59e0b;"><%- stars %></td>
            <td style="padding: 12px 16px; max-width: 300px;"><%= item.comment %></td>
            <td style="padding: 12px 16px;"><%- statusBadge %></td>
            <td style="padding: 12px 16px; text-align: right;">
              <% if (!item.is_processed) { %>
                <button onclick="markFeedbackProcessed(<%= item.id %>)" style="background: #22c55e; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">Traiter</button>
              <% } else { %>
                -
              <% } %>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<script src="/js/admin-actions.js"></script>
