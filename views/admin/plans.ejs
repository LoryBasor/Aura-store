<%# ========================================
    views/admin/plans.ejs - SSR VERSION
    ======================================== %>

<%
  function fmtDate(d) { if(!d) return '-'; return new Date(d).toLocaleDateString('fr-FR'); }
  const currentSubs       = subscriptions || [];
  const currentPlans      = plans || [];
  const currentPagination = pagination    || { page:1, limit:20, total:0 };
  const currentFilters    = filters       || {};
  const totalPages        = Math.ceil(currentPagination.total / currentPagination.limit);
  const statusColors = { trial:'info', active:'success', expired:'error', cancelled:'error', suspended:'warning' };
  const statusLabels = { trial:'Trial', active:'Actif', expired:'Expiré', cancelled:'Annulé', suspended:'Suspendu' };
%>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title"><svg class="svg-icon svg-icon-fi-rr-clipboard" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg> Gestion des Abonnements</h1>
    <p class="page-subtitle">Administrez les abonnements vendeurs (<%= currentPagination.total %> au total)</p>
  </div>
  <button class="btn btn-primary" data-action="new-subscription">+ Créer un abonnement</button>
</div>

<!-- Plans disponibles -->
<div class="stats-grid" style="margin-bottom:24px;">
  <% currentPlans.forEach(plan => { %>
    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label"><%= plan.name %></span>
        <div class="stat-icon"><%- plan.price === 0 ? '🆓' : plan.price < 5000 ? '<svg class="svg-icon svg-icon-fi-rr-star" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>' : '<svg class="svg-icon svg-icon-fi-rr-gem" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h12l4 6-10 12L2 9z"></path><path d="M11 3 8 9l4 12 4-12-3-6"></path><path d="M2 9h20"></path></svg>' %></div>
      </div>
      <div class="stat-value"><%= (parseFloat(plan.price)||0).toLocaleString('fr-FR') %> FCFA</div>
      <div class="stat-change"><%= plan.billing_cycle || 'mensuel' %></div>
    </div>
  <% }); %>
</div>

<!-- Filters (GET form SSR) -->
<div class="card" style="margin-bottom:24px;">
  <form method="GET" action="/admin/subscriptions" class="filter-bar">
    <input type="search" name="search" class="form-input" id="searchVendor"
           placeholder="Rechercher un vendeur..." value="<%= currentFilters.search || '' %>">

    <select class="form-select" name="plan" id="planFilter" onchange="this.form.submit()">
      <option value="" <%= !currentFilters.plan ? 'selected' : '' %>>Tous les plans</option>
      <% currentPlans.forEach(plan => { %>
        <option value="<%= plan.slug %>" <%= currentFilters.plan === plan.slug ? 'selected' : '' %>><%= plan.name %></option>
      <% }); %>
    </select>

    <select class="form-select" name="status" id="statusFilter" onchange="this.form.submit()">
      <option value="" <%= !currentFilters.status ? 'selected' : '' %>>Tous les statuts</option>
      <option value="trial"     <%= currentFilters.status === 'trial'     ? 'selected' : '' %>>Trial</option>
      <option value="active"    <%= currentFilters.status === 'active'    ? 'selected' : '' %>>Actifs</option>
      <option value="expired"   <%= currentFilters.status === 'expired'   ? 'selected' : '' %>>Expirés</option>
      <option value="cancelled" <%= currentFilters.status === 'cancelled' ? 'selected' : '' %>>Annulés</option>
    </select>

    <button type="submit" class="btn btn-primary"><svg class="svg-icon svg-icon-fi-rr-search" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Filtrer</button>
  </form>
</div>

<!-- Abonnements Table -->
<div class="card" style="padding: 0; overflow: hidden;">
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>Vendeur</th>
          <th>Plan</th>
          <th>Statut</th>
          <th>Début</th>
          <th>Expiration</th>
          <th>Notes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="subscriptionsList">
        <% if (currentSubs.length === 0) { %>
          <tr>
            <td colspan="7" style="text-align:center;padding:48px;">
              <div style="font-size:48px;margin-bottom:16px;"><svg class="svg-icon svg-icon-fi-rr-clipboard" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg></div>
              <p style="color:var(--color-secondary);">Aucun abonnement trouvé</p>
            </td>
          </tr>
        <% } else { %>
          <% currentSubs.forEach(sub => { %>
            <tr>
              <td data-label="Vendeur">
            <tr>
              <td data-label="Vendeur">
                <div><strong><%= sub.business_name %></strong></div>
                <div style="font-size:12px;color:var(--color-secondary);"><%= sub.email %></div>
              </td>
              <td data-label="Plan"><span class="badge badge-info"><%= sub.plan_name %></span></td>
              <td data-label="Statut"><span class="badge badge-<%= statusColors[sub.status] || 'info' %>"><%- statusLabels[sub.status] || sub.status %></span></td>
              <td data-label="Début"><%= fmtDate(sub.started_at) %></td>
              <td data-label="Expiration"><%= fmtDate(sub.expires_at) %></td>
              <td data-label="Notes"><%= sub.notes || '-' %></td>
              <td data-label="Actions">
                <div style="display:flex;gap:6px;">
                  <a href="/admin/subscriptions/<%= sub.user_id %>" class="btn btn-secondary btn-sm" title="Détails"><svg class="svg-icon svg-icon-fi-rr-eye" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>️</a>
                  <button class="btn btn-outline btn-sm" onclick="AdminSubscriptions.openChangeStatus('<%= sub.id %>', '<%= sub.business_name %>', '<%= sub.status %>')" title="Changer statut"><svg class="svg-icon svg-icon-fi-rr-label" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20.59 13.41 12 22l-9-9V4a2 2 0 0 1 2-2h8.59a2 2 0 0 1 1.41.59l7 7a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>️</button>
                  <button class="btn btn-outline btn-sm" onclick="AdminSubscriptions.openChangePlan('<%= sub.user_id %>')" title="Changer plan"><svg class="svg-icon svg-icon-fi-rr-refresh" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg></button>
                  <button class="btn btn-outline btn-sm" onclick="AdminSubscriptions.openExtend('<%= sub.user_id %>')" title="Prolonger"><svg class="svg-icon svg-icon-fi-rr-calendar" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></button>
                  <button class="btn btn-danger btn-sm" onclick="AdminSubscriptions.openCancel('<%= sub.user_id %>')" title="Annuler"><svg class="svg-icon svg-icon-fi-rr-cross-circle" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg></button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination SSR -->
<% if (totalPages > 1) { %>
<div id="pagination" class="flex-center" style="margin-top:24px;gap:8px;">
  <% if (currentPagination.page > 1) { %>
    <a href="/admin/subscriptions?page=<%= currentPagination.page - 1 %>&search=<%= currentFilters.search || '' %>&plan=<%= currentFilters.plan || '' %>&status=<%= currentFilters.status || '' %>"
       class="btn btn-secondary btn-sm">← Précédent</a>
  <% } %>
  <span style="padding:8px 16px;color:var(--color-secondary);font-size:13px;">
    Page <%= currentPagination.page %> / <%= totalPages %>
  </span>
  <% if (currentPagination.page < totalPages) { %>
    <a href="/admin/subscriptions?page=<%= currentPagination.page + 1 %>&search=<%= currentFilters.search || '' %>&plan=<%= currentFilters.plan || '' %>&status=<%= currentFilters.status || '' %>"
       class="btn btn-secondary btn-sm">Suivant →</a>
  <% } %>
</div>
<% } %>

<!-- Modal Changer Statut -->
<div class="modal-overlay" id="changeStatusModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title"><svg class="svg-icon svg-icon-fi-rr-label" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20.59 13.41 12 22l-9-9V4a2 2 0 0 1 2-2h8.59a2 2 0 0 1 1.41.59l7 7a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>️ Modifier le statut</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="changeStatusForm">
      <div class="modal-body">
        <input type="hidden" id="statusSubId">
        <p id="statusVendorName" style="font-weight:700; margin-bottom:16px;"></p>
        <div class="form-group">
          <label class="form-label">Nouveau statut</label>
          <select id="newSubStatus" class="form-select" required>
            <option value="active">Actif</option>
            <option value="trial">Essai</option>
            <option value="expired">Expiré</option>
            <option value="suspended">Suspendu</option>
            <option value="cancelled">Annulé</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<!-- Modals -->
<div class="modal-overlay" id="createSubscriptionModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">Créer un abonnement</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="createSubscriptionForm">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label required">Vendeur</label>
          <select id="selectVendor" class="form-select" required>
            <option value="">-- Sélectionner un vendeur --</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label required">Plan</label>
          <select id="selectPlan" class="form-select" required>
            <option value="">-- Sélectionner un plan --</option>
            <% currentPlans.forEach(plan => { %>
              <option value="<%= plan.id %>"><%= plan.name %> — <%= (parseFloat(plan.price)||0).toLocaleString('fr-FR') %> FCFA</option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Notes</label>
          <textarea id="subscriptionNotes" class="form-textarea" placeholder="Notes internes..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary">Créer</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="changePlanModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">Changer de plan</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="changePlanForm">
      <div class="modal-body">
        <input type="hidden" id="changePlanUserId">
        <div class="form-group">
          <label class="form-label required">Nouveau plan</label>
          <select id="newPlanSelect" class="form-select" required>
            <option value="">-- Sélectionner --</option>
            <% currentPlans.forEach(plan => { %>
              <option value="<%= plan.id %>"><%= plan.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary">Changer</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="extendModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">Prolonger l'abonnement</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="extendForm">
      <div class="modal-body">
        <input type="hidden" id="extendUserId">
        <div class="form-group">
          <label class="form-label required">Nombre de jours</label>
          <input type="number" id="extendDays" class="form-input" min="1" max="365" value="30" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary">Prolonger</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="cancelModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">Annuler l'abonnement</h3>
      <button class="modal-close"><svg class="svg-icon svg-icon-fi-rr-cross-small" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    </div>
    <form id="cancelForm">
      <div class="modal-body">
        <input type="hidden" id="cancelUserId">
        <div class="form-group">
          <label class="form-label required">Raison</label>
          <textarea id="cancelReason" class="form-textarea" required placeholder="Expliquez la raison..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Fermer</button>
        <button type="submit" class="btn btn-danger">Confirmer</button>
      </div>
    </form>
  </div>
</div>

<!-- Injection SSR des plans pour le JS -->
<script id="ssr-plans-data" type="application/json">
  <%- JSON.stringify(currentPlans) %>
</script>
<script src="/js/admin/subscriptions.js"></script>

<style>
  .table { width: 100%; border-collapse: collapse; min-width: 900px; }
  .table-container { overflow-x: auto; background: white; border-radius: var(--radius-md); }
  
  .table th, .table td { padding: 16px; text-align: left; vertical-align: middle; }
  .table th { background: var(--color-surface); color: var(--color-primary); font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
  .table tbody tr { border-bottom: 1px solid var(--color-border); transition: background 0.2s; }
  .table tbody tr:hover { background: rgba(37, 99, 235, 0.02); }

  @media (max-width: 768px) {
    .table { min-width: unset; }
    .table thead { display: none; }
    .table tr { 
      display: block; 
      margin-bottom: 16px; 
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: white;
      padding: 12px;
    }
    .table td { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      padding: 10px 0;
      border: none;
      text-align: right;
      border-bottom: 1px dashed var(--color-border);
    }
    .table td:last-child { border-bottom: none; }
    .table td::before {
      content: attr(data-label);
      font-weight: 700;
      font-size: 11px;
      color: var(--color-secondary);
      text-transform: uppercase;
      margin-right: 12px;
      text-align: left;
    }
    .table td .btn { width: auto; font-size: 11px; padding: 6px 10px; }
  }


</style>