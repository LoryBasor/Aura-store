<!-- ========================================
     views/layouts/main.ejs
     ======================================== -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="AURA - Plateforme SaaS pour vendeurs WhatsApp et Instagram">
  <title><%= title || 'AURA' %> | Plateforme Vendeurs</title>
  
  <!-- Styles -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✨</text></svg>">
  
  <% if (typeof additionalStyles !== 'undefined') { %>
    <%= additionalStyles %>
  <% } %>
</head>
<body>
  <div class="app-container">
    <!-- Sidebar -->
    <% if (typeof showSidebar === 'undefined' || showSidebar) { %>
      <%- include('../partials/sidebar') %>
    <% } %>

    <!-- Main Content -->
    <div class="main-content">
      <!-- Header -->
      <% if (typeof showHeader === 'undefined' || showHeader) { %>
        <%- include('../partials/header') %>
      <% } %>

      <!-- Page Content -->
      <div class="content">
        <%- body %>
      </div>

      <!-- Footer -->
      <% if (typeof showFooter !== 'undefined' && showFooter) { %>
        <%- include('../partials/footer') %>
      <% } %>
    </div>
  </div>
  
  <!-- Scripts Globaux -->
   <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/planManager.js"></script>
  <script src="/js/app.js"></script>
  
  <% if (typeof additionalScripts !== 'undefined') { %>
    <%= additionalScripts %>
  <% } %>
</body>
</html>