<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/css/aura-design-system.css">
  <link rel="stylesheet" href="/css/marketplace-home.css">
  <meta name="description" content="Découvrez des milliers de produits et boutiques sur Aura Marketplace — la plateforme e-commerce moderne.">
  <style>.svg-icon{display:inline-block;vertical-align:-0.125em;flex-shrink:0;}</style>
</head>
<body>
  <% const { popularProducts, recommendedStores, trendingCategories, recentProducts } = data %>
  
  <%- include('../partials/navbar', { currentPage: 'home', user: typeof user !== 'undefined' ? user : null }) %>
  
  <!-- Hero Section -->
  <section class="hero-section">
    <!-- Particules animées -->
    <div class="hero-particles" aria-hidden="true"></div>

    <div class="hero-content">
      <!-- Label badge -->
      <div class="hero-label">
        <span></span>
        Aura Marketplace
        <span></span>
      </div>

      <h1 class="hero-title">Découvrez des produits <span class="highlight">exceptionnels</span></h1>
      <p class="hero-subtitle">Explorez notre marketplace et trouvez les meilleurs vendeurs locaux. Des milliers de produits vous attendent.</p>

      <!-- Search Bar Glassmorphism -->
      <div class="search-container">
        <input
          type="text"
          id="searchInput"
          placeholder="Rechercher un produit, une boutique..."
          class="search-input"
          autocomplete="off"
        >
        <button id="searchBtn" class="search-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          <span>Rechercher</span>
        </button>
      </div>

      <!-- Quick Stats -->
      <div class="quick-stats">
        <div class="stat-item">
          <span class="stat-number"><%= popularProducts.length %>+</span>
          <span class="stat-label">Produits</span>
        </div>
        <div class="stat-item">
          <span class="stat-number"><%= recommendedStores.length %>+</span>
          <span class="stat-label">Boutiques</span>
        </div>
        <div class="stat-item">
          <span class="stat-number"><%= trendingCategories.length %>+</span>
          <span class="stat-label">Catégories</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Products Carousel -->
  <section class="section-container reveal">
    <div class="section-header">
      <div>
        <h2 class="section-title">Produits Populaires</h2>
        <p class="section-subtitle">Les produits les plus appréciés du moment</p>
      </div>
      <a href="/marketplace/products?sort=popular" class="see-all-link">Voir tout →</a>
    </div>
    
    <div class="carousel-container" id="popularProducts">
      <div class="carousel-nav" style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px;">
        <button class="carousel-btn carousel-prev" data-carousel="popular" aria-label="Précédent">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="carousel-btn carousel-next" data-carousel="popular" aria-label="Suivant">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
      
      <div class="carousel-track" data-carousel="popular">
        <% if (popularProducts && popularProducts.length > 0) { %>
          <% popularProducts.forEach(product => { %>
            <a href="/p/<%= product.share_token %>" class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= product.image_url || '/images/placeholder.png' %>" alt="<%= product.name %>" class="product-image">
                <div class="product-badge">Populaire</div>
              </div>
              <div class="product-info">
                <h3 class="product-name"><%= product.name %></h3>
                <p class="product-price"><%= product.price %> <%= product.currency %></p>
                <div class="product-vendor">
                  <span><%= product.business_name %></span>
                  <% if (product.is_verified) { %>
                    <svg class="verified-badge" width="16" height="16" viewBox="0 0 24 24" fill="#5C6C73">
                      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                    </svg>
                  <% } %>
                </div>
                <% if (product.city) { %>
                  <p class="product-location"><svg class="svg-icon svg-icon-fi-rr-marker" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= product.city %>, <%= product.country || '' %></p>
                <% } %>
              </div>
            </a>
          <% }); %>
        <% } else { %>
          <p class="empty-message">Aucun produit populaire pour le moment.</p>
        <% } %>
      </div>
      
    </div>
  </section>

  <!-- Trending Categories -->
  <section class="section-container categories-section">
    <div class="section-header">
      <h2 class="section-title">Catégories Tendances</h2>
    </div>
    
    <div class="categories-grid" id="trendingCategories">
      <% if (trendingCategories && trendingCategories.length > 0) { %>
        <% trendingCategories.slice(0, 8).forEach(category => { %>
          <a href="/marketplace/products?category=<%= category.slug %>" class="category-card">
            <div class="category-icon"><svg class="svg-icon svg-icon-fi-rr-label" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M20.59 13.41 12 22l-9-9V4a2 2 0 0 1 2-2h8.59a2 2 0 0 1 1.41.59l7 7a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>️</div>
            <h3 class="category-name"><%= category.name %></h3>
            <p class="category-count"><%= category.product_count %> produits</p>
          </a>
        <% }); %>
      <% } else { %>
        <p class="empty-message">Aucune catégorie disponible.</p>
      <% } %>
    </div>
  </section>

  <!-- Recommended Stores Carousel -->
  <section class="section-container reveal">
    <div class="section-header">
      <div>
        <h2 class="section-title">Boutiques Recommandées</h2>
        <p class="section-subtitle">Des vendeurs de confiance vérifiés</p>
      </div>
      <a href="/marketplace/stores" class="see-all-link">Voir tout →</a>
    </div>
    
    <div class="carousel-container" id="recommendedStores">
      <div class="carousel-nav" style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px;">
        <button class="carousel-btn carousel-prev" data-carousel="stores" aria-label="Précédent">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="carousel-btn carousel-next" data-carousel="stores" aria-label="Suivant">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
      
      <div class="carousel-track" data-carousel="stores">
        <% if (recommendedStores && recommendedStores.length > 0) { %>
          <% recommendedStores.forEach(store => { %>
            <a href="/store/<%= store.store_slug %>" class="store-card">
              <div class="store-header">
                <% if (store.logo_url) { %>
                  <img src="<%= store.logo_url %>" alt="<%= store.business_name %>" class="store-logo">
                <% } else { %>
                  <div class="store-logo-placeholder"><svg class="svg-icon svg-icon-fi-rr-shop" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 9l1-5h16l1 5"></path><path d="M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0"></path><path d="M5 9v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"></path><path d="M10 21v-6h4v6"></path></svg></div>
                <% } %>
                <div class="store-info">
                  <h3 class="store-name">
                    <%= store.business_name %>
                    <% if (store.is_verified) { %>
                      <svg class="verified-badge" width="16" height="16" viewBox="0 0 24 24" fill="#5C6C73">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                      </svg>
                    <% } %>
                  </h3>
                  <% if (store.city) { %>
                    <p class="store-location"><svg class="svg-icon svg-icon-fi-rr-marker" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= store.city %>, <%= store.country || '' %></p>
                  <% } %>
                </div>
              </div>
              
              <div class="store-stats">
                <div class="stat">
                  <span class="stat-value"><%= store.product_count %></span>
                  <span class="stat-label">Produits</span>
                </div>
                <div class="stat">
                  <span class="stat-value"><%= store.total_views || 0 %></span>
                  <span class="stat-label">Vues</span>
                </div>
              </div>

              <% if (store.products && store.products.length > 0) { %>
                <div class="store-products">
                  <% store.products.slice(0, 3).forEach(product => { %>
                    <img src="<%= product.image_url || '/images/placeholder.png' %>" alt="<%= product.name %>" class="store-product-thumb">
                  <% }); %>
                </div>
              <% } %>
            </a>
          <% }); %>
        <% } else { %>
          <p class="empty-message">Aucune boutique recommandée pour le moment.</p>
        <% } %>
      </div>
      
    </div>
  </section>

  <!-- Recent Products -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Produits Récents</h2>
      <a href="/marketplace/products?sort=recent" class="see-all-link">Voir tout →</a>
    </div>
    
    <div class="products-grid" id="recentProducts">
      <% if (recentProducts && recentProducts.length > 0) { %>
        <% recentProducts.slice(0, 8).forEach(product => { %>
          <a href="/p/<%= product.share_token %>" class="product-card">
            <div class="product-image-wrapper">
              <img src="<%= product.image_url || '/images/placeholder.png' %>" alt="<%= product.name %>" class="product-image">
              <div class="product-badge badge-new">Nouveau</div>
            </div>
            <div class="product-info">
              <h3 class="product-name"><%= product.name %></h3>
              <p class="product-price"><%= product.price %> <%= product.currency %></p>
              <div class="product-vendor">
                <span><%= product.business_name %></span>
                <% if (product.is_verified) { %>
                  <svg class="verified-badge" width="16" height="16" viewBox="0 0 24 24" fill="#5C6C73">
                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                  </svg>
                <% } %>
              </div>
              <% if (product.city) { %>
                <p class="product-location"><svg class="svg-icon svg-icon-fi-rr-marker" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= product.city %>, <%= product.country || '' %></p>
              <% } %>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <p class="empty-message">Aucun produit récent pour le moment.</p>
      <% } %>
    </div>
  </section>

  <!-- Footer Marketplace -->
  <footer class="marketplace-footer">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="brand-name">Aura Marketplace</div>
        <p>La plateforme e-commerce qui connecte les vendeurs locaux à leurs clients. Découvrez, achetez, vendez — simplement.</p>
      </div>
      <div class="footer-col">
        <h4>Navigation</h4>
        <ul>
          <li><a href="/marketplace">Accueil</a></li>
          <li><a href="/marketplace/products">Tous les produits</a></li>
          <li><a href="/marketplace/stores">Toutes les boutiques</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Vendeurs</h4>
        <ul>
          <li><a href="/about">Devenir vendeur</a></li>
          <li><a href="/login">Se connecter</a></li>
          <li><a href="/register">Créer un compte</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Aide</h4>
        <ul>
          <li><a href="#" id="openFeedbackModalBtn">Donner un avis</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> Aura Marketplace. Tous droits réservés.</span>
      <span>Plateforme e-commerce moderne</span>
    </div>
  </footer>

  <script src="/js/marketplace-home.js"></script>
  <script src="/js/aura-animations.js"></script>
</body>
</html>