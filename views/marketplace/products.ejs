<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/css/aura-design-system.css">
  <link rel="stylesheet" href="/css/marketplace-products.css">
  <meta name="description" content="Explorez tous les produits disponibles sur Aura Marketplace. Filtrez, triez et trouvez ce qu'il vous faut.">
  <style>.svg-icon{display:inline-block;vertical-align:-0.125em;flex-shrink:0;}</style>
</head>
<body>

  <% const { filters, categories, cities, countries, products, total }=data %>

    <%- include('../partials/navbar', { currentPage: 'products' , user: typeof user !=='undefined' ? user : null }) %>

  <div class="page-container">
    <!-- Header Section -->
    <header class="page-header">
    <div class="header-content">
        <h1 class="page-title">Découvrez nos produits</h1>
        <p class="page-subtitle">Explorez notre sélection de produits exceptionnels</p>
      </div>
      
      <!-- Mobile Filter Toggle -->
      <button id="filterToggle" class="filter-toggle-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        Filtres
      </button>
    </header>

    <div class="content-wrapper">
      <!-- Filters Sidebar -->
      <aside class="filters-sidebar">
        <div class="filters-header">
          <h2 class="filters-title">Filtres</h2>
          <div class="filters-header-actions">
            <button id="clearFilters" class="clear-filters-btn">Réinitialiser</button>
            <button id="closeFilters" class="close-filters-btn open" aria-label="Fermer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        <form id="filterForm" class="filters-form">
          <!-- Search -->
          <div class="filter-group">
            <label class="filter-label">Recherche</label>
            <div class="search-box">
              <input 
                type="text" 
                id="productSearchInput" 
                name="search"
                placeholder="Rechercher..." 
                value="<%= filters.search || '' %>"
                class="filter-input"
              >
              <button type="button" id="productSearchBtn" class="search-icon-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.35-4.35"></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Categories -->
          <div class="filter-group">
            <label class="filter-label">Catégories</label>
            <div class="filter-options">
              <label class="filter-option">
                <input type="radio" name="category" value="" <%= !filters.category ? 'checked' : '' %>>
                <span>Toutes les catégories</span>
              </label>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <label class="filter-option">
                    <input type="radio" name="category" value="<%= cat.slug %>" <%= filters.category === cat.slug ? 'checked' : '' %>>
                    <span><%= cat.name %> (<%= cat.product_count %>)</span>
                  </label>
                <% }); %>
              <% } %>
            </div>
          </div>

          <!-- Location -->
          <div class="filter-group">
            <label class="filter-label">Ville</label>
            <select name="city" class="filter-select">
              <option value="">Toutes les villes</option>
              <% if (cities && cities.length > 0) { %>
                <% cities.forEach(city => { %>
                  <option value="<%= city.city %>" <%= filters.city === city.city ? 'selected' : '' %>>
                    <%= city.city %> (<%= city.product_count %>)
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label">Pays</label>
            <select name="country" class="filter-select">
              <option value="">Tous les pays</option>
              <% if (countries && countries.length > 0) { %>
                <% countries.forEach(country => { %>
                  <option value="<%= country.country %>" <%= filters.country === country.country ? 'selected' : '' %>>
                    <%= country.country %> (<%= country.product_count %>)
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <!-- Price Range -->
          <div class="filter-group">
            <label class="filter-label">Fourchette de prix</label>
            <div class="price-inputs">
              <input 
                type="number" 
                name="minPrice" 
                placeholder="Min" 
                value="<%= filters.minPrice || '' %>"
                class="filter-input price-input"
                min="0"
              >
              <span class="price-separator">-</span>
              <input 
                type="number" 
                name="maxPrice" 
                placeholder="Max" 
                value="<%= filters.maxPrice || '' %>"
                class="filter-input price-input"
                min="0"
              >
            </div>
          </div>
        </form>
      </aside>

      <!-- Main Content -->
      <main class="main-content">
        <!-- Toolbar -->
        <div class="toolbar">
          <div class="results-info">
            <span class="results-count" id="resultsCount"><%= total || 0 %></span>
            <span class="results-label">produits trouvés</span>
          </div>

          <div class="sort-container">
            <label for="sortSelect" class="sort-label">Trier par:</label>
            <select id="sortSelect" class="sort-select">
              <option value="recent" <%= filters.sort === 'recent' ? 'selected' : '' %>>Plus récents</option>
              <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>Plus populaires</option>
              <option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Prix croissant</option>
              <option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Prix décroissant</option>
            </select>
          </div>
        </div>

        <!-- Loading Indicator -->
        <div id="loadingIndicator" class="loading-indicator" style="display: none;">
          <div class="spinner"></div>
          <p>Chargement des produits...</p>
        </div>

        <!-- Products Grid -->
        <div id="productsContainer" class="products-grid">
          <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
              <a href="/p/<%= product.share_token %>" class="product-card">
                <div class="product-image-wrapper">
                  <img src="<%= product.image_url || '/images/placeholder.png' %>" alt="<%= product.name %>" class="product-image">
                  <% if (product.view_count > 100) { %>
                    <div class="product-badge">Populaire</div>
                  <% } %>
                </div>
                <div class="product-info">
                  <h3 class="product-name"><%= product.name %></h3>
                  <% if (product.is_promotion_active) { %>
                    <p class="product-price" style="color:#ca8a04;">
                      <span style="font-size:11px;text-decoration:line-through;color:#9ca3af;font-weight:400;margin-right:4px;"><%= product.price %></span>
                      <%= product.effective_price %> <%= product.currency %>
                      <span style="background:#fef08a;color:#713f12;font-size:9px;font-weight:800;border-radius:4px;padding:1px 5px;">-<%= Math.round((1 - product.effective_price / product.price) * 100) %>%</span>
                    </p>
                  <% } else { %>
                    <p class="product-price"><%= product.price %> <%= product.currency %></p>
                  <% } %>
                  <div class="product-vendor">
                    <span><%= product.business_name %></span>
                    <% if (product.is_verified) { %>
                      <svg class="verified-badge" width="16" height="16" viewBox="0 0 24 24" fill="#5C6C73" title="Vendeur vérifié">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                      </svg>
                    <% } %>
                    <% if (product.is_sponsored) { %>
                      <span class="badge badge-warning" style="font-size: 10px; margin-left: 4px;">✨ Sponsorisé</span>
                    <% } %>
                  </div>
                  <% if (product.city) { %>
                    <p class="product-location"><svg class="svg-icon svg-icon-fi-rr-marker" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= product.city %>, <%= product.country || '' %></p>
                  <% } %>
                </div>
              </a>
            <% }); %>
          <% } else { %>
            <p class="empty-message">Aucun produit trouvé avec vos critères.</p>
          <% } %>
        </div>

        <!-- Infinite Scroll Sentinel -->
        <div id="scrollLoading" style="display: none; text-align: center; padding: 20px;">
          <div class="spinner" style="width: 30px; height: 30px; margin: 0 auto; border: 3px solid var(--color-surface); border-top-color: var(--color-primary); border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
        </div>
        <div id="scrollSentinel" style="height: 20px; width: 100%;"></div>
      </main>
    </div>
  </div>

  <!-- Intégration des modales -->
  <%- include('../partials/feedback-modal') %>
  <%- include('../partials/report-modal') %>
  <%- include('../partials/support-modal') %>

  <!-- Bouton d'action flottant (Support / Feedback) -->
  <div class="floating-actions">
    <button onclick="openSupportModal()" title="Contacter le support" class="fab-support" style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#253337,#5C6C73);color:white;border:none;box-shadow:0 4px 16px rgba(37,51,55,0.35);cursor:pointer;display:flex;justify-content:center;align-items:center;transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1);">
      <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
      </svg>
    </button>
    <button onclick="openFeedbackModal()" title="Donner un avis" class="fab-feedback" style="width:50px;height:50px;border-radius:50%;background:white;color:#5C6C73;border:2px solid rgba(157,181,192,0.4);box-shadow:0 4px 12px rgba(37,51,55,0.12);cursor:pointer;display:flex;justify-content:center;align-items:center;transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1);">
      <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
      </svg>
    </button>
  </div>
  <style>.floating-actions button:hover{transform:scale(1.12) translateY(-2px);}</style>

  <script src="/js/modals.js"></script>
  <script src="/js/marketplace-filters.js"></script>
  <script src="/js/aura-animations.js"></script>
</body>
</html>