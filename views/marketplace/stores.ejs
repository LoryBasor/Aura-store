<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/css/aura-design-system.css">
  <link rel="stylesheet" href="/css/marketplace-stores.css">
  <meta name="description" content="Découvrez toutes les boutiques de vendeurs sur Aura Marketplace. Trouvez des vendeurs de confiance.">
  <style>.svg-icon{display:inline-block;vertical-align:-0.125em;flex-shrink:0;}</style>
</head>

<body>
  <% const { stores, cities, countries, filters, total }=data %>

    <%- include('../partials/navbar', { currentPage: 'stores' , user: typeof user !=='undefined' ? user : null }) %>

      <div class="page-container">
        <!-- Header Section -->
        <header class="page-header">
          <div class="header-content">
            <h1 class="page-title">Découvrez nos boutiques</h1>
            <p class="page-subtitle">Explorez notre sélection de vendeurs de confiance</p>
          </div>

          <!-- Mobile Filter Toggle -->
          <button id="filterToggle" class="filter-toggle-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
            Filtres
          </button>
        </header>

        <div class="content-wrapper">
          <!-- Filters Sidebar -->
          <aside class="filters-sidebar">
            <div class="filters-header">
              <h2 class="filters-title">Filtres</h2>
              <button id="clearFilters" class="clear-filters-btn">Réinitialiser</button>
              <button id="closeFilters" class="close-filters-btn" aria-label="Fermer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>

            <form id="filterForm" class="filters-form">
              <!-- Search -->
              <div class="filter-group">
                <label class="filter-label">Recherche</label>
                <div class="search-box">
                  <input type="text" id="storeSearchInput" name="search" placeholder="Nom de boutique..."
                    class="filter-input">
                  <button type="button" id="storeSearchBtn" class="search-icon-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="11" cy="11" r="8"></circle>
                      <path d="m21 21-4.35-4.35"></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Location -->
              <div class="filter-group">
                <label class="filter-label">Ville</label>
                <select name="city" class="filter-select">
                  <option value="">Toutes les villes</option>
                  <% if (cities && cities.length> 0) { %>
                    <% cities.forEach(city=> { %>
                      <option value="<%= city.city %>" <%=filters.city===city.city ? 'selected' : '' %>>
                        <%= city.city %> (<%= city.product_count %>)
                      </option>
                      <% }); %>
                        <% } %>
                </select>
              </div>

              <div class="filter-group">
                <label class="filter-label">Pays</label>
                <select name="country" class="filter-select">
                  <option value="">Tous les pays</option>
                  <% if (countries && countries.length> 0) { %>
                    <% countries.forEach(country=> { %>
                      <option value="<%= country.country %>" <%=filters.country===country.country ? 'selected' : '' %>>
                        <%= country.country %> (<%= country.product_count %>)
                      </option>
                      <% }); %>
                        <% } %>
                </select>
              </div>
            </form>
          </aside>

          <!-- Main Content -->
          <main class="main-content">
            <!-- Toolbar -->
            <div class="toolbar">
              <div class="results-info">
                <span class="results-count" id="resultsCount">
                  <%= total || 0 %>
                </span>
                <span class="results-label">boutiques trouvées</span>
              </div>

              <div class="sort-container">
                <label for="sortSelect" class="sort-label">Trier par:</label>
                <select id="sortSelect" class="sort-select">
                  <option value="recent" <%=filters.sort==='recent' ? 'selected' : '' %>>Plus récentes</option>
                  <option value="popular" <%=filters.sort==='popular' ? 'selected' : '' %>>Plus populaires</option>
                </select>
              </div>
            </div>

            <!-- Loading Indicator -->
            <div id="loadingIndicator" class="loading-indicator" style="display: none;">
              <div class="spinner"></div>
              <p>Chargement des boutiques...</p>
            </div>

            <!-- Stores Grid -->
            <div id="storesContainer" class="stores-grid">
              <% if (stores && stores.length> 0) { %>
                <% stores.forEach(store=> { %>
                  <a href="/store/<%= store.store_slug %>" class="store-card">
                    <div class="store-header" style="<%- store.banner_url ? `background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('${store.banner_url}'); background-size: cover; background-position: center;` : '' %>">
                      <% if (store.logo_url) { %>
                        <img src="<%= store.logo_url %>" alt="<%= store.business_name %>" class="store-logo">
                        <% } else { %>
                          <div class="store-logo-placeholder"><svg class="svg-icon svg-icon-fi-rr-shop" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 9l1-5h16l1 5"></path><path d="M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0"></path><path d="M5 9v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"></path><path d="M10 21v-6h4v6"></path></svg></div>
                          <% } %>

                            <div class="store-info">
                              <h3 class="store-name">
                                <%= store.business_name %>
                                  <% if (store.is_verified) { %>
                                    <svg class="verified-badge" width="18" height="18" viewBox="0 0 24 24"
                                      fill="#5C6C73" title="Vendeur vérifié">
                                      <path
                                        d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                                    </svg>
                                    <% } %>
                              </h3>
                              <% if (store.city) { %>
                                <p class="store-location"><svg class="svg-icon svg-icon-fi-rr-marker" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= store.city %>, <%= store.country || '' %>
                                </p>
                                <% } %>
                            </div>
                    </div>

                    <div class="store-stats">
                      <div class="stat-item">
                        <span class="stat-value">
                          <%= store.product_count %>
                        </span>
                        <span class="stat-label">Produits</span>
                      </div>
                      <div class="stat-item">
                        <span class="stat-value">
                          <%= store.total_views || 0 %>
                        </span>
                        <span class="stat-label">Vues</span>
                      </div>
                    </div>

                    <% if (store.products && store.products.length> 0) { %>
                      <div class="store-products">
                        <% store.products.slice(0, 4).forEach(product=> { %>
                          <div class="product-thumb-wrapper">
                            <img src="<%= product.image_url || '/images/placeholder.png' %>" alt="<%= product.name %>"
                              class="product-thumb">
                          </div>
                          <% }); %>
                      </div>
                      <% } %>
                  </a>
                  <% }); %>
                    <% } else { %>
                      <p class="empty-message">Aucune boutique trouvée avec vos critères.</p>
                      <% } %>
            </div>

            <!-- Pagination -->
            <% if (data.pagination.totalPages > 1) { 
                 const cleanFilters = {};
                 for (const key in filters) {
                   if (key !== 'limit' && key !== 'offset' && filters[key] !== '' && filters[key] !== null && filters[key] !== undefined) {
                     cleanFilters[key] = filters[key];
                   }
                 }
            %>
              <div class="pagination-container">
                <a href="?<%= new URLSearchParams({...cleanFilters, page: data.pagination.page - 1}).toString() %>" 
                   class="pagination-btn <%= data.pagination.page <= 1 ? 'disabled' : '' %>"
                   id="prevBtn">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                  Précédent
                </a>
                
                <span id="pagination" class="pagination-info">
                  Page <%= data.pagination.page %> / <%= data.pagination.totalPages %>
                </span>
                
                <a href="?<%= new URLSearchParams({...cleanFilters, page: data.pagination.page + 1}).toString() %>" 
                   class="pagination-btn <%= data.pagination.page >= data.pagination.totalPages ? 'disabled' : '' %>"
                   id="nextBtn">
                  Suivant
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              </div>
            <% } %>
          </main>
        </div>
      </div>

      <!-- Intégration des modales -->
      <%- include('../partials/feedback-modal') %>
      <%- include('../partials/report-modal') %>
      <%- include('../partials/support-modal') %>

      <!-- Bouton d'action flottant (Support / Feedback) -->
      <div class="floating-actions">
        <button onclick="openSupportModal()" title="Contacter le support" style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,#253337,#5C6C73);color:white;border:none;box-shadow:0 4px 16px rgba(37,51,55,0.35);cursor:pointer;display:flex;justify-content:center;align-items:center;transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1);">
          <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
          </svg>
        </button>
        <button onclick="openFeedbackModal()" title="Donner un avis" style="width:50px;height:50px;border-radius:50%;background:white;color:#5C6C73;border:2px solid rgba(157,181,192,0.4);box-shadow:0 4px 12px rgba(37,51,55,0.12);cursor:pointer;display:flex;justify-content:center;align-items:center;transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1);">
          <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
        </button>
      </div>
      <style>.floating-actions button:hover{transform:scale(1.12) translateY(-2px);}</style>

      <script src="/js/modals.js"></script>
      <script src="/js/marketplace-stores.js"></script>
      <script src="/js/aura-animations.js"></script>
</body>
</html>