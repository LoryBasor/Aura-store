<!-- views/auth/login.ejs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/images/logo.png" type="image/png">
  <title>Connexion | AURA</title>
  <link rel="stylesheet" href="/css/style.css">

  <link rel="stylesheet" href="/css/aura-design-system.css">
  <style>
    body { margin: 0; overflow-x: hidden; }
    .auth-split-layout {
      display: flex;
      min-height: 100vh;
      width: 100%;
    }
    .auth-visual {
      flex: 1.2;
      background: linear-gradient(135deg, var(--aura-primary-deep) 0%, var(--aura-primary) 100%);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4rem;
      color: white;
    }
    .auth-visual::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(circle at 20% 80%, rgba(224,252,252,0.1) 0%, transparent 50%);
    }
    .auth-visual-content {
      position: relative;
      z-index: 2;
      max-width: 480px;
      animation: fadeInLeft 0.8s ease;
    }
    .auth-visual-title {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }
    .auth-visual-title span {
      background: linear-gradient(135deg, var(--aura-accent), var(--aura-surface));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .auth-visual-subtitle {
      font-size: 1.1rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.6;
    }
    .auth-form-side {
      flex: 1;
      background: var(--aura-white);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      position: relative;
    }
    .auth-box-premium {
      width: 100%;
      max-width: 400px;
      animation: fadeInRight 0.8s ease;
    }
    .password-wrapper {
      position: relative;
    }
    .password-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: var(--aura-tertiary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px;
      transition: color 0.2s;
    }
    .password-toggle:hover { color: var(--aura-primary); }
    
    @media (max-width: 900px) {
      .auth-visual { display: none; }
      .auth-form-side { background: linear-gradient(135deg, var(--aura-primary-deep) 0%, var(--aura-primary) 100%); }
      .auth-box-premium {
        background: var(--aura-white);
        padding: 2rem;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xl);
      }
    }
  </style>
</head>
<body>
  <div class="auth-split-layout">
    <!-- Côté Visuel (Desktop uniquement) -->
    <div class="auth-visual hide-mobile">
      <div class="auth-visual-content">
        <h1 class="auth-visual-title">Gérez votre boutique <span>comme un pro.</span></h1>
        <p class="auth-visual-subtitle">Accédez à votre tableau de bord Aura, suivez vos ventes, analysez vos statistiques et développez votre activité e-commerce.</p>
      </div>
    </div>

    <!-- Côté Formulaire -->
    <div class="auth-form-side">
      <div class="auth-box-premium">
      <!-- Logo -->
      <div class="auth-logo">
        <h1>AURA</h1>
        <p class="auth-subtitle">Plateforme pour vendeurs modernes</p>
      </div>

      <!-- Formulaire de connexion -->
      <form id="loginForm" data-ajax="true">
        <div class="form-group">
          <label for="email" class="form-label required">Email</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            placeholder="votre@email.com"
          >
          <div class="form-error" id="emailError"></div>
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <label for="password" class="form-label required" style="margin-bottom: 0;">Mot de passe</label>
            <a href="/forgot-password" style="font-size: 13px; color: var(--primary, #5C6C73); text-decoration: underline;">Oublié ?</a>
          </div>
          <div class="password-wrapper">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-input input-premium" 
              placeholder="••••••••"
            >
            <button type="button" class="password-toggle" id="togglePassword" aria-label="Afficher le mot de passe">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eye-icon">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
          <div class="form-error" id="passwordError"></div>
        </div>

        <div class="form-group" style="margin-top: 2rem;">
          <button type="submit" class="btn-aura w-full" style="padding: 14px;">
            <span>Se connecter à mon espace</span>
          </button>
        </div>
      </form>

      <!-- Lien inscription -->
      <div class="auth-link" style="margin-top: 2rem;">
        Pas encore de compte ? <a href="/register" style="color:var(--aura-secondary);text-decoration:underline;">Créer un compte</a>
      </div>
    </div>
  </div>
</div>

  <script src="/js/ui.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/auth/login.js"></script>
  <script src="/js/aura-animations.js"></script>
  <script>
    // Password toggle
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');
    if(togglePassword && password) {
      togglePassword.addEventListener('click', function (e) {
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        if(type === 'text') {
          this.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path><line x1="2" y1="2" x2="22" y2="22"></line></svg>';
        } else {
          this.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
        }
      });
    }
  </script>
</body>
</html>