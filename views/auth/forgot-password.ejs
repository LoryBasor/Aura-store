<!-- views/auth/forgot-password.ejs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/images/logo.png" type="image/png">
  <title>Mot de passe oublié | AURA</title>
  <link rel="stylesheet" href="/css/style.css">

  <style>.svg-icon{display:inline-block;vertical-align:-0.125em;flex-shrink:0;}</style>
</head>
<body>
  <div class="auth-container">
    <div class="auth-box">
      <!-- Logo -->
      <div class="auth-logo">
        <h1>AURA</h1>
        <p class="auth-subtitle">Mot de passe oublié</p>
      </div>

      <div class="text-center mb-6">
        <p class="text-secondary" style="font-size: 14px; margin-bottom: 20px;">
          Entrez l'adresse email associée à votre compte. Nous vous enverrons un code pour réinitialiser votre mot de passe.
        </p>
      </div>

      <form id="forgotForm" data-ajax="true">
        <div class="form-group">
          <label for="email" class="form-label required">Adresse Email</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            placeholder="votre@email.com"
            required
          >
        </div>

        <div class="form-group">
          <button type="submit" class="btn btn-primary w-full" id="submitBtn">
            Envoyer le code
          </button>
        </div>
      </form>

      <div class="auth-link text-center" style="margin-top: 20px;">
        <a href="/login">Retour à la connexion</a>
      </div>
    </div>
  </div>

  <script src="/js/ui.js"></script>
  <script src="/js/auth/forgot-password.js"></script>
</body>
</html>
