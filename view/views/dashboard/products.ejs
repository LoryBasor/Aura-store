<%# ========================================
    views/dashboard/products.ejs - SSR VERSION
    ======================================== %>

<% 
  function fmtCurrency(n, cur='XAF') { return (parseFloat(n)||0).toLocaleString('fr-FR') + ' ' + cur; }
  const currentFilters = filters || {};
  const currentProducts = products || [];
  const currentCategories = categories || [];
  const currentPagination = pagination || { page:1, limit:20, total:0 };
  const totalPages = Math.ceil(currentPagination.total / currentPagination.limit);
%>

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title">Mes produits</h1>
    <p class="page-subtitle">Gérez votre catalogue de produits (<%= currentPagination.total %> produits)</p>
  </div>
  <button class="btn btn-primary" data-action="new-product">
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
    </svg>
    Nouveau produit
  </button>
</div>

<!-- Filters (formulaire GET pour SSR) -->
<div class="card" style="margin-bottom:24px;">
  <form method="GET" action="/products" style="display:flex;flex-direction:column;gap:16px;align-items:center;padding:16px;">
    <div style="flex:1;width:100%;">
      <input type="search" name="search" class="form-input" placeholder="Rechercher un produit..."
             value="<%= currentFilters.search || '' %>">
    </div>
    <select name="status" class="form-select" style="width:100%;" onchange="this.form.submit()">
      <option value="undefined" <%= currentFilters.status === 'undefined' ? 'selected' : '' %>>Tous les statuts</option>
      <option value="true"      <%= currentFilters.status === 'true'      ? 'selected' : '' %>>Disponible</option>
      <option value="false"     <%= currentFilters.status === 'false'     ? 'selected' : '' %>>Indisponible</option>
    </select>
    <select name="category" class="form-select" style="width:100%;" id="categoryFilter" onchange="this.form.submit()">
      <option value="">Toutes les catégories</option>
      <% currentCategories.forEach(cat => { %>
        <option value="<%= cat.id %>" <%= String(currentFilters.category) === String(cat.id) ? 'selected' : '' %>>
          <%= cat.name %> (<%= cat.product_count || 0 %>)
        </option>
      <% }); %>
    </select>
    <button type="submit" class="btn btn-primary" style="width:100%;">🔍 Filtrer</button>
  </form>
</div>

<!-- Products Grid -->
<div id="productsGrid" class="stats-grid">
  <% if (currentProducts.length === 0) { %>
    <div class="empty-state" style="grid-column:1/-1;text-align:center;padding:64px 24px;">
      <div style="font-size:64px;margin-bottom:16px;">📦</div>
      <h3 style="font-size:20px;font-weight:700;color:var(--color-primary);margin-bottom:8px;">Aucun produit trouvé</h3>
      <p style="color:var(--color-secondary);margin-bottom:24px;">
        <% if (currentFilters.search) { %>Aucun résultat pour "<%= currentFilters.search %>"<% } else { %>Commencez par créer votre premier produit<% } %>
      </p>
      <button class="btn btn-primary" data-action="new-product">+ Nouveau produit</button>
    </div>
  <% } else { %>
    <% currentProducts.forEach(product => { %>
      <div class="stat-card product-card" style="position:relative;">
        <% if (product.image_url) { %>
          <img src="<%= product.image_url %>" alt="<%= product.name %>"
               style="width:100%;height:180px;object-fit:cover;border-radius:var(--radius-sm);margin-bottom:12px;">
        <% } else { %>
          <div style="width:100%;height:180px;background:var(--color-accent);border-radius:var(--radius-sm);margin-bottom:12px;display:flex;align-items:center;justify-content:center;font-size:48px;">📦</div>
        <% } %>

        <span class="badge badge-<%= product.is_available ? 'success' : 'error' %>"
              style="position:absolute;top:12px;right:12px;">
          <%= product.is_available ? 'Disponible' : 'Indisponible' %>
        </span>

        <% if (product.category_name) { %>
          <span class="badge badge-info" style="font-size:11px;margin-bottom:8px;display:inline-block;"><%= product.category_name %></span>
        <% } %>

        <h3 style="font-size:16px;font-weight:700;color:var(--color-primary);margin-bottom:8px;"><%= product.name %></h3>

        <% if (product.description) { %>
          <p style="font-size:13px;color:var(--color-secondary);margin-bottom:12px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
            <%= product.description %>
          </p>
        <% } %>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <strong style="font-size:18px;color:var(--color-primary);">
            <%= fmtCurrency(product.price, product.currency) %>
          </strong>
          <% if (product.stock_quantity > 0) { %>
            <span style="font-size:12px;color:var(--color-secondary);">Stock: <%= product.stock_quantity %></span>
          <% } %>
        </div>

        <div style="display:flex;gap:8px;align-items:center;margin-bottom:12px;">
          <span style="font-size:12px;color:var(--color-tertiary);">👁 <%= product.view_count || 0 %> vues</span>
          <span style="font-size:12px;color:var(--color-tertiary);">🛒 <%= product.order_count || 0 %> commandes</span>
        </div>

        <div style="display:flex;gap:8px;">
          <button class="btn btn-secondary btn-sm" style="flex:1;"
                  data-action="edit-product" data-product-id="<%= product.id %>">✏️ Modifier</button>
          <% if (product.share_link) { %>
            <button class="btn btn-outline btn-sm"
                    data-action="copy-link" data-share-link="<%= product.share_link %>">🔗</button>
          <% } %>
          <button class="btn btn-danger btn-sm"
                  data-action="delete-product" data-product-id="<%= product.id %>">🗑</button>
        </div>
      </div>
    <% }); %>
  <% } %>
</div>

<!-- Pagination SSR -->
<% if (totalPages > 1) { %>
<div id="pagination" class="flex-center" style="margin-top:24px;gap:8px;">
  <% if (currentPagination.page > 1) { %>
    <a href="/products?page=<%= currentPagination.page - 1 %>&search=<%= currentFilters.search || '' %>&status=<%= currentFilters.status || '' %>&category=<%= currentFilters.category || '' %>"
       class="btn btn-secondary btn-sm">← Précédent</a>
  <% } %>
  <span style="padding:8px 16px;color:var(--color-secondary);font-size:13px;">
    Page <%= currentPagination.page %> / <%= totalPages %> (<%= currentPagination.total %> produits)
  </span>
  <% if (currentPagination.page < totalPages) { %>
    <a href="/products?page=<%= currentPagination.page + 1 %>&search=<%= currentFilters.search || '' %>&status=<%= currentFilters.status || '' %>&category=<%= currentFilters.category || '' %>"
       class="btn btn-secondary btn-sm">Suivant →</a>
  <% } %>
</div>
<% } %>

<!-- Modal Produit (les actions CRUD restent via API fetch) -->
<div class="modal-overlay" id="productModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitle">Nouveau produit</h3>
      <button class="modal-close">✕</button>
    </div>
    <form id="productForm" enctype="multipart/form-data">
      <div class="modal-body">
        <input type="hidden" id="productId" name="productId">

        <div class="form-group">
          <label for="name" class="form-label required">Nom du produit</label>
          <input type="text" id="name" name="name" class="form-input" placeholder="Ex: iPhone 15 Pro Max" required>
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Description</label>
          <textarea id="description" name="description" class="form-textarea" placeholder="Décrivez votre produit en détail..."></textarea>
        </div>

        <div class="form-group">
          <label for="category_id" class="form-label">Catégorie</label>
          <select id="category_id" name="category_id" class="form-select">
            <option value="">Aucune catégorie</option>
            <% currentCategories.forEach(cat => { %>
              <option value="<%= cat.id %>"><%= cat.name %></option>
            <% }); %>
          </select>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="form-group">
            <label for="price" class="form-label required">Prix</label>
            <input type="number" id="price" name="price" class="form-input" placeholder="50000" step="0.01" min="0" required>
          </div>
          <div class="form-group">
            <label for="currency" class="form-label">Devise</label>
            <select id="currency" name="currency" class="form-select">
              <option value="XAF">FCFA (XAF)</option>
            </select>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="form-group">
            <label for="stock_quantity" class="form-label">Quantité en stock</label>
            <input type="number" id="stock_quantity" name="stock_quantity" class="form-input" placeholder="0" min="0" value="0">
            <p class="form-help">Laisser à 0 pour stock illimité</p>
          </div>
          <div class="form-group">
            <label for="is_available" class="form-label">Disponibilité *</label>
            <select id="is_available" name="is_available" class="form-select" required>
              <option value="true">Disponible</option>
              <option value="false">Indisponible</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="image" class="form-label">Image du produit</label>
          <input type="file" id="image" name="image" class="form-input" accept="image/jpeg,image/png,image/gif,image/webp">
          <p class="form-help">Format acceptés: JPG, PNG, GIF, WEBP (max 5MB)</p>
          <div id="imagePreview" style="margin-top:12px;"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-lg annuler">Annuler</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<!-- Inject categories as JSON for JS (pour le modal dynamique) -->
<script>
  window.__SSR_CATEGORIES__ = <%- JSON.stringify(currentCategories) %>;
  window.__SSR_PRODUCTS__ = <%- JSON.stringify(currentProducts) %>;
</script>