<%# ========================================
    views/dashboard/index.ejs - SSR VERSION
    ======================================== %>

<% 
  const statusColors = { nouvelle:'info', confirmee:'success', en_preparation:'warning', en_livraison:'warning', livree:'success', annulee:'error' };
  const statusLabels = { nouvelle:'Nouvelle', confirmee:'Confirmée', en_preparation:'En prép.', en_livraison:'En livraison', livree:'Livrée', annulee:'Annulée' };
  function fmtCurrency(n, cur='FCFA') { return (parseFloat(n)||0).toLocaleString('fr-FR') + ' ' + cur; }
  function fmtDate(d) { if(!d) return '-'; return new Date(d).toLocaleDateString('fr-FR'); }
%>

<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Page Header -->
<div class="page-header">
  <h1 class="page-title">Tableau de bord</h1>
  <p class="page-subtitle">Vue d'ensemble de votre activité</p>
</div>

<!-- Stats Cards (Visible to all) -->
<div class="stats-grid" id="statsGrid">
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Total Produits</span>
      <div class="stat-icon">📦</div>
    </div>
    <div class="stat-value"><%= stats && stats.products ? stats.products.total : 0 %></div>
    <div class="stat-change positive"><%= stats && stats.products ? stats.products.available : 0 %> disponibles</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Commandes</span>
      <div class="stat-icon">🛒</div>
    </div>
    <div class="stat-value"><%= stats && stats.orders ? stats.orders.total : 0 %></div>
    <div class="stat-change positive">+<%= stats && stats.orders ? stats.orders.this_month : 0 %> ce mois</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Chiffre d'affaires</span>
      <div class="stat-icon">💰</div>
    </div>
    <div class="stat-value"><%= fmtCurrency(stats && stats.revenue ? stats.revenue.total : 0) %></div>
    <div class="stat-change positive"><%= fmtCurrency(stats && stats.revenue ? stats.revenue.this_month : 0) %> ce mois</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Clients</span>
      <div class="stat-icon">👥</div>
    </div>
    <div class="stat-value"><%= stats && stats.customers ? stats.customers.total : 0 %></div>
    <div class="stat-change"><%= stats && stats.customers ? stats.customers.active_30_days : 0 %> actifs (30j)</div>
  </div>
</div>

<% if (!user.has_advanced_stats) { %>
<!-- Upgrade Banner for Free Users -->
<div class="card" style="margin-top: 24px; padding: 32px; text-align: center; background: linear-gradient(135deg, var(--color-accent), var(--color-surface)); border: 2px solid var(--color-primary);">
  <div style="font-size: 48px; margin-bottom: 16px;">🚀</div>
  <h3 style="font-size: 24px; font-weight: 700; margin-bottom: 12px; color: var(--color-primary);">
    Passez au plan Pro pour débloquer :
  </h3>
  <ul style="list-style: none; display: inline-block; text-align: left; margin: 24px 0;">
    <li style="padding: 8px 0; display: flex; align-items: center; gap: 8px;">
      <span style="color: var(--color-success); font-size: 20px;">✓</span>
      Graphiques visuels et statistiques avancées
    </li>
    <li style="padding: 8px 0; display: flex; align-items: center; gap: 8px;">
      <span style="color: var(--color-success); font-size: 20px;">✓</span>
      Export de vos données (JSON, Excel)
    </li>
    <li style="padding: 8px 0; display: flex; align-items: center; gap: 8px;">
      <span style="color: var(--color-success); font-size: 20px;">✓</span>
      Produits et commandes illimités
    </li>
  </ul>
  <div>
    <a href="/subscription" class="btn btn-primary btn-lg">Découvrir les plans</a>
  </div>
</div>
<% } else { %>
<!-- Evolution Chart for PRO/BUSINESS -->
<div class="card" style="margin-top: 24px;">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h3 class="card-title">📈 Évolution du Chiffre d'Affaires (30 derniers jours)</h3>
    <a href="/advanced-stats" class="btn btn-secondary btn-sm">Voir l'analyse complète</a>
  </div>
  <div style="padding: 24px; height: 350px;">
    <canvas id="dashboardEvolutionChart"></canvas>
  </div>
</div>
<% } %>

<!-- Charts Row -->
<div class="card grille2" style="margin-top: 24px;">
  <!-- Recent Orders -->
  <div class="card cardOrders">
    <div class="card-header">
      <h3 class="card-title">Commandes récentes</h3>
      <a href="/orders" class="card-action">Voir tout →</a>
    </div>
    <div class="card" id="recentOrders">
      <% if (!recentOrders || recentOrders.length === 0) { %>
        <div class="empty-state"><p class="empty-state-text">Aucune commande récente</p></div>
      <% } else { %>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>N° Commande</th>
                <th>Client</th>
                <th>Produit</th>
                <th>Montant</th>
                <th>Statut</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% recentOrders.slice(0, 5).forEach(order => { %>
                <tr>
                  <td><strong><%= order.order_number %></strong></td>
                  <td><%= order.customer_name %></td>
                  <td><%= order.product_name %></td>
                  <td><%= fmtCurrency(order.total_amount) %></td>
                  <td><span class="badge badge-<%= statusColors[order.status] || 'info' %>"><%= statusLabels[order.status] || order.status %></span></td>
                  <td><%= fmtDate(order.created_at) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Top Products -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Top produits</h3>
      <a href="/products" class="card-action">Voir tout →</a>
    </div>
    <div class="card" id="topProducts">
      <% if (!topProducts || topProducts.length === 0) { %>
        <div class="empty-state"><p class="empty-state-text">Aucun produit</p></div>
      <% } else { %>
        <div style="display:flex;flex-direction:column;gap:12px;padding:16px;">
          <% topProducts.slice(0, 5).forEach(product => { %>
            <div style="padding:12px;background:var(--color-surface);border-radius:var(--radius-sm);">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <strong style="font-size:14px;color:var(--color-primary);"><%= product.name %></strong>
                <span style="font-size:13px;font-weight:600;color:var(--color-secondary);"><%= product.order_count || 0 %> ventes</span>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <span style="font-size:13px;color:var(--color-secondary);"><%= fmtCurrency(product.price, product.currency) %></span>
                <span style="font-size:12px;color:var(--color-tertiary);"><%= product.view_count || 0 %> vues</span>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="card" style="margin-top: 24px;">
  <div class="card-header">
    <h3 class="card-title">Actions rapides</h3>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;padding:16px;">
    <a href="/products" class="btn btn-primary" style="justify-content: center;">
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
      </svg>
      Nouveau produit
    </a>
    <a href="/orders" class="btn btn-secondary" style="justify-content: center;">
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      Voir les commandes
    </a>
    <a href="/profile" class="btn btn-outline" style="justify-content: center;">
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      Paramètres
    </a>
  </div>
</div>

<% if (user.has_advanced_stats && typeof chartData !== 'undefined' && chartData) { %>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const rawData = <%- chartData %>;
    if (!rawData || rawData.length === 0) return;

    const labels = rawData.map(d => d.label || d.period);
    const revenueData = rawData.map(d => d.revenue);

    const ctx = document.getElementById('dashboardEvolutionChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: "Chiffre d'affaires (FCFA)",
          data: revenueData,
          borderColor: '#8b5cf6',
          backgroundColor: 'rgba(139, 92, 246, 0.1)',
          borderWidth: 2,
          fill: true,
          tension: 0.4,
          pointBackgroundColor: '#8b5cf6',
          pointRadius: 3
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) {
                let label = context.dataset.label || '';
                if (label) label += ': ';
                if (context.parsed.y !== null) {
                  label += new Intl.NumberFormat('fr-FR').format(context.parsed.y) + ' FCFA';
                }
                return label;
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(value) {
                return new Intl.NumberFormat('fr-FR').format(value);
              }
            }
          }
        }
      }
    });
  });
</script>
<% } %>