<!-- ========================================
     views/layouts/main.ejs
     ======================================== -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="AURA - Plateforme SaaS pour vendeurs WhatsApp et Instagram">
  <title><%= title || 'AURA' %> | Plateforme Vendeurs</title>
  
  <!-- Styles -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Favicon -->
   <link rel="shortcut icon" href="/images/logo.png" type="image/png">
  
  <% if (typeof additionalStyles !== 'undefined') { %>
    <%= additionalStyles %>
  <% } %>
</head>
<body>
  <div class="app-container">
    <!-- Sidebar -->
    <% if (typeof showSidebar === 'undefined' || showSidebar) { %>
      <%- include('../partials/sidebar') %>
    <% } %>

    <!-- Main Content -->
    <div class="main-content">
      <!-- Header -->
      <% if (typeof showHeader === 'undefined' || showHeader) { %>
        <%- include('../partials/header') %>
      <% } %>

      <!-- Page Content -->
      <div class="content">
        <%- body %>
      </div>

      <!-- Footer -->
      <% if (typeof showFooter !== 'undefined' && showFooter) { %>
        <%- include('../partials/footer') %>
      <% } %>
    </div>
  </div>
  
  <!-- Scripts Globaux -->
  <% if (typeof user !== 'undefined' && user) { %>
  <script>
    window.__SSR_USER__ = <%- JSON.stringify({
      id: user.id,
      email: user.email,
      business_name: user.business_name,
      store_slug: user.store_slug,
      role: user.role,
      plan_name: user.plan_name || 'Gratuit',
      plan_slug: user.plan_slug || 'free',
      has_advanced_stats: user.has_advanced_stats || false,
      has_export: user.has_export || false,
      has_customization: user.has_customization || false,
      has_integrations: user.has_integrations || false
    }) %>;
  </script>
  <% } %>
   <script src="/js/ui.js"></script>
  <script src="/js/app.js"></script>
  
  <% if (typeof additionalScripts !== 'undefined') { %>
    <%= additionalScripts %>
  <% } %>
</body>
</html>