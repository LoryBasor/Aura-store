<!-- ========================================
     views/admin/subscription-details.ejs
     ======================================== -->

<!-- Page Header -->
<div class="page-header">
  <div>
    <h1 class="page-title" id="pageTitle">📋 Gestion Abonnement</h1>
    <p class="page-subtitle" id="vendorInfo">Chargement...</p>
  </div>
  <div style="display: flex; gap: 12px;">
    <button class="btn btn-secondary" onclick="window.location.href='/admin/subscriptions'">
      ← Retour
    </button>
    <button class="btn btn-primary" id="viewVendorBtn">
      👁️ Voir le vendeur
    </button>
  </div>
</div>

<!-- Subscription Info Card -->
<div class="card" id="subscriptionInfoCard">
  <div class="loader"></div>
</div>

<!-- Actions Rapides -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 24px;">
  <div class="card" style="padding: 24px; text-align: center; cursor: pointer;" id="changePlanCard">
    <div style="font-size: 48px; margin-bottom: 12px;">🔄</div>
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 8px;">Changer de plan</h3>
    <p style="font-size: 14px; color: var(--color-secondary);">Modifier le plan actuel</p>
  </div>

  <div class="card" style="padding: 24px; text-align: center; cursor: pointer;" id="extendCard">
    <div style="font-size: 48px; margin-bottom: 12px;">⏰</div>
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 8px;">Prolonger</h3>
    <p style="font-size: 14px; color: var(--color-secondary);">Ajouter des jours</p>
  </div>

  <div class="card" style="padding: 24px; text-align: center; cursor: pointer;" id="cancelCard">
    <div style="font-size: 48px; margin-bottom: 12px;">❌</div>
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 8px;">Annuler</h3>
    <p style="font-size: 14px; color: var(--color-secondary);">Annuler l'abonnement</p>
  </div>

  <div class="card" style="padding: 24px; text-align: center; cursor: pointer;" id="historyCard">
    <div style="font-size: 48px; margin-bottom: 12px;">📜</div>
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 8px;">Historique</h3>
    <p style="font-size: 14px; color: var(--color-secondary);">Voir tous les changements</p>
  </div>
</div>

<!-- Plan Details -->
<div class="card">
  <div class="card-header">
    <h3 class="card-title">📦 Détails du Plan</h3>
  </div>
  <div id="planDetails">
    <div class="loader"></div>
  </div>
</div>

<!-- Usage Stats -->
<div class="card">
  <div class="card-header">
    <h3 class="card-title">📊 Utilisation</h3>
  </div>
  <div id="usageStats">
    <div class="loader"></div>
  </div>
</div>

<!-- History Timeline -->
<div class="card">
  <div class="card-header">
    <h3 class="card-title">🕐 Historique complet</h3>
  </div>
  <div id="historyTimeline">
    <div class="loader"></div>
  </div>
</div>

<!-- Modal Changer Plan -->
<div class="modal-overlay" id="changePlanModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">🔄 Changer de plan</h3>
      <button class="modal-close">✕</button>
    </div>
    <form id="changePlanForm">
      <div class="modal-body">
        <input type="hidden" id="changePlanUserId">
        
        <div style="padding: 16px; background: var(--color-surface); border-radius: var(--radius-sm); margin-bottom: 16px;">
          <strong>Plan actuel :</strong>
          <span id="currentPlanName" style="color: var(--color-primary);"></span>
        </div>

        <div class="form-group">
          <label class="form-label required">Nouveau plan</label>
          <select id="newPlanSelect" class="form-select" required>
            <option value="">-- Sélectionner --</option>
          </select>
        </div>

        <div id="planComparisonInfo" style="display: none; padding: 16px; background: var(--color-accent); border-radius: var(--radius-sm); margin-top: 16px;">
          <!-- Comparaison dynamique -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary">Confirmer le changement</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Prolonger -->
<div class="modal-overlay" id="extendModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">⏰ Prolonger l'abonnement</h3>
      <button class="modal-close">✕</button>
    </div>
    <form id="extendForm">
      <div class="modal-body">
        <input type="hidden" id="extendUserId">
        
        <div style="padding: 16px; background: var(--color-surface); border-radius: var(--radius-sm); margin-bottom: 16px;">
          <strong>Date d'expiration actuelle :</strong>
          <span id="currentExpiryDate" style="color: var(--color-primary);"></span>
        </div>

        <div class="form-group">
          <label class="form-label required">Nombre de jours à ajouter</label>
          <input type="number" id="extendDays" class="form-input" min="1" max="365" value="30" required>
          <p class="form-help">Entre 1 et 365 jours</p>
        </div>

        <div id="newExpiryPreview" style="padding: 16px; background: var(--color-accent); border-radius: var(--radius-sm); margin-top: 16px;">
          <strong>Nouvelle date d'expiration :</strong>
          <span id="newExpiryDate" style="color: var(--color-primary);"></span>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Annuler</button>
        <button type="submit" class="btn btn-primary">Prolonger</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Annuler -->
<div class="modal-overlay" id="cancelModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">❌ Annuler l'abonnement</h3>
      <button class="modal-close">✕</button>
    </div>
    <form id="cancelForm">
      <div class="modal-body">
        <input type="hidden" id="cancelUserId">
        
        <div style="padding: 16px; background: rgba(244, 67, 54, 0.1); border-left: 4px solid var(--color-error); border-radius: var(--radius-sm); margin-bottom: 16px;">
          <strong style="color: var(--color-error);">⚠️ Action irréversible</strong>
          <p style="margin-top: 8px; color: var(--color-secondary);">
            L'abonnement sera définitivement annulé. Le vendeur perdra l'accès aux fonctionnalités payantes.
          </p>
        </div>

        <div class="form-group">
          <label class="form-label required">Raison de l'annulation</label>
          <textarea id="cancelReason" class="form-textarea" rows="4" required placeholder="Expliquez la raison (visible par le vendeur)..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary modal-close">Retour</button>
        <button type="submit" class="btn btn-danger">Confirmer l'annulation</button>
      </div>
    </form>
  </div>
</div>

<!-- Script dédié -->
<script src="/js/admin/subscription-details.js"></script>