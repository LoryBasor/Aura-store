<!-- Page Header -->
<div class="page-header">
  <h1 class="page-title">👥 Mes Clients</h1>
  <p class="page-subtitle">Gérez votre base de clients</p>
</div>

<!-- Stats Clients -->
<div class="stats-grid" style="margin-bottom: 24px;">
  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Total Clients</span>
      <div class="stat-icon">👥</div>
    </div>
    <div class="stat-value" id="totalCustomers">0</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Clients Actifs (30j)</span>
      <div class="stat-icon">✅</div>
    </div>
    <div class="stat-value" id="activeCustomers">0</div>
  </div>

  <div class="stat-card">
    <div class="stat-header">
      <span class="stat-label">Nouveau ce mois</span>
      <div class="stat-icon">🆕</div>
    </div>
    <div class="stat-value" id="newCustomers">0</div>
  </div>
</div>

<!-- Filters -->
<div class="card" style="margin-bottom: 24px;">
  <div style="padding: 20px;">
    <input 
      type="search" 
      id="searchInput" 
      class="form-input" 
      placeholder="Rechercher un client par nom ou téléphone..."
      onkeyup="searchCustomers()"
    >
  </div>
</div>

<!-- Table Clients -->
<div class="card">
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Téléphone</th>
          <th>WhatsApp</th>
          <th style="text-align: center;">Commandes</th>
          <th style="text-align: right;">Dépenses Totales</th>
          <th>Dernière Commande</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="customersTableBody">
        <tr>
          <td colspan="7" style="text-align: center; padding: 48px;">
            Chargement...
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  async function loadCustomers() {
    try {
      const response = await fetch('/api/dashboard', {
        headers: {
          'Authorization': `Bearer ${localStorage.getItem('aura_token')}`
        }
      });
      
      const data = await response.json();
      
      if (data.success && data.data && data.data.overview) {
        // Mettre à jour les stats
        document.getElementById('totalCustomers').textContent = data.data.overview.customers.total || 0;
        document.getElementById('activeCustomers').textContent = data.data.overview.customers.active_30_days || 0;
        document.getElementById('newCustomers').textContent = 0; // TODO: ajouter dans l'API
      }

      // Pour l'instant, afficher un message
      renderEmptyCustomers();
    } catch (error) {
      console.error('Erreur chargement clients:', error);
      renderEmptyCustomers();
    }
  }

  function renderEmptyCustomers() {
    const tbody = document.getElementById('customersTableBody');
    tbody.innerHTML = `
      <tr>
        <td colspan="7" style="text-align: center; padding: 64px;">
          <div class="empty-state">
            <div class="empty-state-icon">👥</div>
            <h3 class="empty-state-title">Gestion des clients</h3>
            <p class="empty-state-text">
              Les clients qui passent commande apparaîtront automatiquement ici.<br>
              Vous pourrez voir leur historique et les contacter facilement.
            </p>
          </div>
        </td>
      </tr>
    `;
  }

  function searchCustomers() {
    // TODO: Implémenter la recherche
  }

  function contactCustomer(phone) {
    const cleanPhone = phone.replace(/[^\d+]/g, '');
    window.open(`https://wa.me/${cleanPhone}`, '_blank');
  }

  // Charger les clients
  loadCustomers();
</script>