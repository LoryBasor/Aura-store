<!-- views/errors/account-suspended.ejs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Compte Suspendu | AURA</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: linear-gradient(135deg, #253337, #5C6C73);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .suspended-container {
      max-width: 600px;
      width: 100%;
      background: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 48px;
      text-align: center;
      box-shadow: var(--shadow-lg);
      border-top: 5px solid var(--color-error);
    }

    .suspended-icon {
      font-size: 80px;
      margin-bottom: 24px;
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    .suspended-title {
      font-size: 28px;
      font-weight: 700;
      color: var(--color-error);
      margin-bottom: 16px;
    }

    .suspended-message {
      font-size: 16px;
      color: var(--color-secondary);
      margin-bottom: 24px;
      line-height: 1.6;
    }

    .suspended-reason {
      padding: 20px;
      background: rgba(244, 67, 54, 0.1);
      border-left: 4px solid var(--color-error);
      border-radius: var(--radius-sm);
      margin-bottom: 24px;
      text-align: left;
    }

    .suspended-reason-title {
      font-weight: 700;
      color: var(--color-error);
      margin-bottom: 8px;
    }

    .suspended-reason-text {
      color: var(--color-primary);
      line-height: 1.6;
    }

    .contact-info {
      padding: 20px;
      background: var(--color-surface);
      border-radius: var(--radius-md);
      margin-top: 24px;
    }

    .contact-title {
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 12px;
    }

    .contact-details {
      font-size: 14px;
      color: var(--color-secondary);
    }

    @media (max-width: 768px) {
      .suspended-container {
        padding: 32px 24px;
      }

      .suspended-icon {
        font-size: 60px;
      }

      .suspended-title {
        font-size: 22px;
      }
    }
  </style>
</head>
<body>
  <div class="suspended-container">
    <div class="suspended-icon">⛔</div>
    
    <h1 class="suspended-title">Compte Suspendu</h1>
    
    <p class="suspended-message">
      Votre compte a été temporairement suspendu par l'administration.
      Vous ne pouvez pas accéder à la plateforme pour le moment.
    </p>

    <div class="suspended-reason">
      <div class="suspended-reason-title">📋 Raison de la suspension :</div>
      <div class="suspended-reason-text">
        <%= reason || 'Aucune raison spécifiée' %>
      </div>
    </div>

    <div class="contact-info">
      <div class="contact-title">📞 Contactez le support</div>
      <div class="contact-details">
        <p style="margin-bottom: 8px;">
          Pour contester cette suspension ou obtenir plus d'informations,
          veuillez contacter notre équipe support :
        </p>
        <p style="margin-bottom: 4px;">
          <strong>Email :</strong> support@aura-saas.com
        </p>
        <p style="margin-bottom: 4px;">
          <strong>Téléphone :</strong> +237 671 64 63 35
        </p>
      </div>
    </div>

    <button class="btn btn-secondary deco" style="margin-top: 24px; width: 100%;">
      Retour à la connexion
    </button>
  </div>

  <script>
    function logout() {
      localStorage.clear();
      sessionStorage.clear();
      window.location.replace('/login');
    }
    document.querySelector('.deco').addEventListener('click', logout);
  </script>
</body>
</html>
